<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<IsPackable>false</IsPackable>
		<RootNamespace>Plugin.Maui.Spine.Core.Tests</RootNamespace>
	</PropertyGroup>

	<!--
		Plugin.Maui.Spine targets only MAUI platforms, which a net10.0 test cannot reference.
		TaskState, the shortcut icon names, the menu model with ActionSheet, the tilt tracker, the search declaration,
		the search records and the guards have no MAUI types, so they are compiled in here directly.
	-->
	<ItemGroup>
		<Compile Include="..\..\src\Plugin.Maui.Spine\Core\TaskState.cs" Link="TaskState.cs" />
		<Compile Include="..\..\src\Plugin.Maui.Spine\Core\ShortcutIcons.Names.cs" Link="ShortcutIcons.Names.cs" />
		<Compile Include="..\..\src\Plugin.Maui.Spine\Core\INavigable.cs" Link="INavigable.cs" />
		<Compile Include="..\..\src\Plugin.Maui.Spine\Core\INavigableWithParameter.cs" Link="INavigableWithParameter.cs" />
		<Compile Include="..\..\src\Plugin.Maui.Spine\Core\NavigationTarget.cs" Link="NavigationTarget.cs" />
		<Compile Include="..\..\src\Plugin.Maui.Spine\Core\SearchableItem.cs" Link="SearchableItem.cs" />
		<Compile Include="..\..\src\Plugin.Maui.Spine\Services\SearchRecords.cs" Link="SearchRecords.cs" />
		<Compile Include="..\..\src\Plugin.Maui.Spine\Core\PageSearch.cs" Link="PageSearch.cs" />
		<Compile Include="..\..\src\Plugin.Maui.Spine\Core\PageSearchAttribute.cs" Link="PageSearchAttribute.cs" />
		<Compile Include="..\..\src\Plugin.Maui.Spine\Presentation\SearchLayout.cs" Link="SearchLayout.cs" />
		<Compile Include="..\..\src\Plugin.Maui.Spine\Services\PageSearchDiscovery.cs" Link="PageSearchDiscovery.cs" />
		<Compile Include="..\..\src\Plugin.Maui.Spine\Services\ToolkitNames.cs" Link="ToolkitNames.cs" />
		<Compile Include="..\..\src\Plugin.Maui.Spine\Core\TiltTracker.cs" Link="TiltTracker.cs" />
		<Compile Include="..\..\src\Plugin.Maui.Spine\Core\Menu\MenuElements.cs" Link="Menu\MenuElements.cs" />
		<Compile Include="..\..\src\Plugin.Maui.Spine\Core\Menu\ActionSheet.cs" Link="Menu\ActionSheet.cs" />
		<Compile Include="..\..\src\Plugin.Maui.Spine\Core\Guards\GuardAttribute.cs" Link="Guards\GuardAttribute.cs" />
		<Compile Include="..\..\src\Plugin.Maui.Spine\Core\Guards\IGuard.cs" Link="Guards\IGuard.cs" />
		<Compile Include="..\..\src\Plugin.Maui.Spine\Services\GuardRunner.cs" Link="Guards\GuardRunner.cs" />
		<Compile Include="..\..\src\Plugin.Maui.Spine\Services\CommandGuards.cs" Link="Guards\CommandGuards.cs" />
		<Compile Include="..\..\src\Plugin.Maui.Spine\Services\SpineReadiness.cs" Link="Guards\SpineReadiness.cs" />
	</ItemGroup>

	<ItemGroup>
		<!-- TaskState reads IEmptyResultException from .Common. -->
		<ProjectReference Include="..\..\src\Plugin.Maui.Spine.Common\Plugin.Maui.Spine.Common.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="xunit" />
		<PackageReference Include="xunit.runner.visualstudio" />
	</ItemGroup>

</Project>
