<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<IsPackable>false</IsPackable>
		<RootNamespace>Plugin.Maui.Spine.Controls.Avatar.Core.Tests</RootNamespace>
		<!-- The zero-allocation tests counted a tier-up on the measuring thread now and then. -->
		<TieredCompilation>false</TieredCompilation>
	</PropertyGroup>

	<ItemGroup>
		<Using Include="Xunit" />
	</ItemGroup>

	<!-- The Avatar package's net10.0 build is its Skia renderer alone, so scenes and shaders are drawn here without a device. -->
	<ItemGroup>
		<ProjectReference Include="..\..\src\Plugin.Maui.Spine.Controls.Avatar.Core\Plugin.Maui.Spine.Controls.Avatar.Core.csproj" />
		<ProjectReference Include="..\..\src\Plugin.Maui.Spine.Controls.Avatar\Plugin.Maui.Spine.Controls.Avatar.csproj" />
		<ProjectReference Include="..\..\src\Plugin.Maui.Spine.Speech\Plugin.Maui.Spine.Speech.csproj" />
		<ProjectReference Include="..\..\src\Plugin.Maui.Spine.Controls.Avatar.Voice\Plugin.Maui.Spine.Controls.Avatar.Voice.csproj" />
		<ProjectReference Include="..\..\src\Plugin.Maui.Spine.Avatar.Tool\Plugin.Maui.Spine.Avatar.Tool.csproj" />
		<None Include="..\..\samples\SpineAvatarLab\Resources\Raw\Avatars\*.spineavatar" LinkBase="Avatars" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\samples\SpineAvatarLab\Resources\Raw\Fixtures\*" LinkBase="Fixtures" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\samples\MauiSpineSampleApp\Resources\Raw\voice-reference.wav" LinkBase="Fixtures" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="SkiaSharp" />
		<PackageReference Include="xunit" />
		<PackageReference Include="xunit.runner.visualstudio" />
	</ItemGroup>

</Project>
