<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<IsPackable>false</IsPackable>
		<RootNamespace>Plugin.Maui.Spine.Biometrics.Tests</RootNamespace>
	</PropertyGroup>

	<!--
		Plugin.Maui.Spine.Biometrics targets only MAUI platforms, which a net10.0 test cannot reference.
		The unlock's and the app lock's logic and their contracts have no MAUI types, so they are compiled in here directly.
	-->
	<ItemGroup>
		<Compile Include="..\..\src\Plugin.Maui.Spine.Biometrics\IBiometricAuth.cs" Link="IBiometricAuth.cs" />
		<Compile Include="..\..\src\Plugin.Maui.Spine.Biometrics\IUnlock.cs" Link="IUnlock.cs" />
		<Compile Include="..\..\src\Plugin.Maui.Spine.Biometrics\SpineBiometricsOptions.cs" Link="SpineBiometricsOptions.cs" />
		<Compile Include="..\..\src\Plugin.Maui.Spine.Biometrics\UnlockService.cs" Link="UnlockService.cs" />
		<Compile Include="..\..\src\Plugin.Maui.Spine.Biometrics\AppLockOptions.cs" Link="AppLockOptions.cs" />
		<Compile Include="..\..\src\Plugin.Maui.Spine.Biometrics\AppLockClock.cs" Link="AppLockClock.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="xunit" />
		<PackageReference Include="xunit.runner.visualstudio" />
	</ItemGroup>

</Project>
