<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<IsPackable>false</IsPackable>
		<RootNamespace>Plugin.Maui.Spine.Controls.Tests</RootNamespace>
	</PropertyGroup>

	<!--
		The control packages target only MAUI platforms, which a net10.0 test cannot reference.
		RollingNumber, the mesh geometry, the highlight timing, the markdown model, the chat answer, the line chart's series and clock and the column chart's scale, the bar's segments and the chart scroller's days, motion and section names have no MAUI types, so they are compiled
		in here directly.
	-->
	<ItemGroup>
		<Compile Include="..\..\src\Plugin.Maui.Spine.Controls.AnimatedLabel\RollingNumber.cs" Link="RollingNumber.cs" />
		<Compile Include="..\..\src\Plugin.Maui.Spine.Controls.MeshBackground\MeshSurface.cs" Link="MeshSurface.cs" />
		<Compile Include="..\..\src\Plugin.Maui.Spine.Controls.MeshBackground\MeshPalettes.cs" Link="MeshPalettes.cs" />
		<Compile Include="..\..\src\Plugin.Maui.Spine.Controls.MeshBackground\MeshPreset.cs" Link="MeshPreset.cs" />
		<Compile Include="..\..\src\Plugin.Maui.Spine.Controls.MeshBackground\Oklab.cs" Link="Oklab.cs" />
		<Compile Include="..\..\src\Plugin.Maui.Spine.Controls.Highlight\HighlightKind.cs" Link="HighlightKind.cs" />
		<Compile Include="..\..\src\Plugin.Maui.Spine.Controls.Highlight\HighlightRepeat.cs" Link="HighlightRepeat.cs" />
		<Compile Include="..\..\src\Plugin.Maui.Spine.Controls.Highlight\HighlightCycles.cs" Link="HighlightCycles.cs" />
		<Compile Include="..\..\src\Plugin.Maui.Spine.Controls.Highlight\SpotlightLayout.cs" Link="SpotlightLayout.cs" />
		<Compile Include="..\..\src\Plugin.Maui.Spine.Controls.Highlight\DisplayCorners.cs" Link="DisplayCorners.cs" />
		<Compile Include="..\..\src\Plugin.Maui.Spine.Controls.Markdown\MarkdownModel.cs" Link="MarkdownModel.cs" />
		<Compile Include="..\..\src\Plugin.Maui.Spine.Controls.Chat\ChatAnswer.cs" Link="ChatAnswer.cs" />
		<Compile Include="..\..\src\Plugin.Maui.Spine.Controls.Charts\LocalClock.cs" Link="LocalClock.cs" />
		<Compile Include="..\..\src\Plugin.Maui.Spine.Controls.Charts\ChartSmoothing.cs" Link="ChartSmoothing.cs" />
		<Compile Include="..\..\src\Plugin.Maui.Spine.Controls.Charts\LineSeries.cs" Link="LineSeries.cs" />
		<Compile Include="..\..\src\Plugin.Maui.Spine.Controls.Charts\ColumnScale.cs" Link="ColumnScale.cs" />
		<Compile Include="..\..\src\Plugin.Maui.Spine.Controls.Charts\BarSegments.cs" Link="BarSegments.cs" />
		<Compile Include="..\..\src\Plugin.Maui.Spine.Controls.Charts\ChartChunks.cs" Link="ChartChunks.cs" />
