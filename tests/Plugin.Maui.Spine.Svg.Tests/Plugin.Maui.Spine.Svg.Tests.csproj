<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<IsPackable>false</IsPackable>
		<RootNamespace>Plugin.Maui.Spine.Svg.Tests</RootNamespace>
	</PropertyGroup>

	<!--
		Plugin.Maui.Spine.Svg targets only MAUI platforms, which a net10.0 test cannot reference. Its
		rendering core has no MAUI types, so it is compiled in here directly.
	-->
	<ItemGroup>
		<Compile Include="..\..\src\Plugin.Maui.Spine.Svg\SvgRasterizer.cs" Link="SvgRasterizer.cs" />
		<Compile Include="..\..\src\Plugin.Maui.Spine.Svg\SvgDarkColors.cs" Link="SvgDarkColors.cs" />
		<Compile Include="..\..\src\Plugin.Maui.Spine.Svg\SvgResourceMatch.cs" Link="SvgResourceMatch.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="SkiaSharp" />
		<PackageReference Include="Svg.Skia" />
		<PackageReference Include="xunit" />
		<PackageReference Include="xunit.runner.visualstudio" />
	</ItemGroup>

</Project>
