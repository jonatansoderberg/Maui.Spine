<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>$(SpineMauiTargetFrameworks)</TargetFrameworks>
    <AssemblyName>Plugin.Maui.Spine</AssemblyName>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

	</PropertyGroup>

	<PropertyGroup>
		<Description>Code-first navigation for .NET MAUI: stack-based region navigation, native bottom sheets, a tab host, a header bar with page actions, Liquid Glass buttons, app shortcuts and Windows window management. Pages are discovered by attribute; no Shell, no route strings.</Description>
		<PackageTags>$(PackageTags);navigation;bottom-sheet;tabs;shell</PackageTags>
	</PropertyGroup>

	<ItemGroup>
    <PackageReference Include="AsyncAwaitBestPractices" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
		<PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="WinUIEx" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'" />
  </ItemGroup>

  <ItemGroup>
	  <ProjectReference Include="..\Plugin.Maui.Spine.Svg\Plugin.Maui.Spine.Svg.csproj" />
	  <ProjectReference Include="..\Plugin.Maui.Spine.Common\Plugin.Maui.Spine.Common.csproj" />
	</ItemGroup>

  <!-- The header bar's own words (back and close, for screen readers), overridable by the app. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\Strings\*.xml" WithCulture="false" />
  </ItemGroup>

  <!-- The header bar's own glyphs (back and close), so they resolve without the icon package. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\Svg\*.svg" />
  </ItemGroup>

  <!-- The generator behind UseSpine()'s module registration; see build\Plugin.Maui.Spine.targets. -->
  <ItemGroup>
    <None Include="build\**" Pack="true" PackagePath="build\;buildTransitive\" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Platforms\iOS\" />
    <Folder Include="Platforms\MacCatalyst\" />
  </ItemGroup>

</Project>
