<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyName>Plugin.Maui.Spine.Server.AI.Assets</AssemblyName>
		<RootNamespace>Plugin.Maui.Spine.Server.AI.Assets</RootNamespace>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<!-- IImageGenerator is experimental in Microsoft.Extensions.AI. Apps that touch the type see the warning themselves. -->
		<NoWarn>$(NoWarn);MEAI001</NoWarn>
	</PropertyGroup>

	<PropertyGroup>
		<Description>Generated images for Spine's server, made once and served from blob storage: a lookup answers with the image's URL or orders it, a Spine messaging handler generates it through a metered, budgeted Server.AI feature, checks it and archives it under a versioned path. A version bump remakes images lazily, and failures are visible to the app.</Description>
		<SpineIcon>server-ai.png</SpineIcon>
		<PackageTags>$(PackageTags);ai;image-generation;microsoft-extensions-ai;blob-storage;messaging;azure-functions</PackageTags>
	</PropertyGroup>

	<!-- The same single framework reference as the other server packages: it serves ASP.NET Core and the Functions isolated worker. -->
	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Plugin.Maui.Spine.Server.AI.Assets.Tests" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Plugin.Maui.Spine.Server.AI\Plugin.Maui.Spine.Server.AI.csproj" />
		<ProjectReference Include="..\Plugin.Maui.Spine.Server.Messaging\Plugin.Maui.Spine.Server.Messaging.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Plugin.Maui.Spine.AI" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Azure.Storage.Blobs" />
	</ItemGroup>

</Project>
