<Project Sdk="Microsoft.NET.Sdk">

	<!--
		net10.0 carries only VoiceAvatarDriver, so it is tested against a fake engine without a device; the MAUI TFMs add
		VoiceView's character visual and UseSpineAvatarVoice.
	-->
	<PropertyGroup>
		<TargetFrameworks>net10.0;$(SpineMauiTargetFrameworks)</TargetFrameworks>
		<AssemblyName>Plugin.Maui.Spine.Controls.Avatar.Voice</AssemblyName>
		<RootNamespace>Plugin.Maui.Spine.Controls</RootNamespace>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)' != 'net10.0'">
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
	</PropertyGroup>

	<PropertyGroup>
		<Description>An avatar for a realtime voice conversation: VoiceAvatarDriver follows Spine.Voice's session (state, levels and bands, visemes on the answer's playback clock), and VoiceView gains the character visual, an AvatarView that runs on the VoiceView's own tick.</Description>
		<SpineIcon>avatar.png</SpineIcon>
		<PackageTags>$(PackageTags);avatar;voice;realtime;lip-sync</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Plugin.Maui.Spine.Controls.Avatar\Plugin.Maui.Spine.Controls.Avatar.csproj" />
		<ProjectReference Include="..\Plugin.Maui.Spine.Voice\Plugin.Maui.Spine.Voice.csproj" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
		<PackageReference Include="Microsoft.Maui.Controls" />
		<ProjectReference Include="..\Plugin.Maui.Spine.Controls.Voice\Plugin.Maui.Spine.Controls.Voice.csproj" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<Compile Remove="**\*.cs" />
		<Compile Include="VoiceAvatarDriver.cs" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Plugin.Maui.Spine.Controls.Avatar.Core.Tests" />
	</ItemGroup>

	<!-- Declares the package to UseSpine(); see Plugin.Maui.Spine's build\Plugin.Maui.Spine.targets. -->
	<ItemGroup>
		<None Include="build\**" Pack="true" PackagePath="build\;buildTransitive\" />
	</ItemGroup>

</Project>
