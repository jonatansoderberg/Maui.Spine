<Project>
	<!--
		What the app needs declared for push to work, on each platform.

		Consumer knobs:
		  SpinePushEnvironment   development | production   (Apple; defaults to development for Debug)
		  SpinePushEnabled       default true
		  SpinePushRemote        default true; false keeps local notifications and drops everything
		                         remote push needs — Firebase on Android, aps-environment on Apple.
		                         On Mac Catalyst remote push also needs CodesignProvision, see below.
		  SpinePushImages        default false; true adds the Notification Service Extension that shows
		                         pictures in pushed notifications on iOS. Needs its own App ID and profile
		                         for device builds, which is why it is not on by default.
		  SpinePushImagesCodesignProvision  default empty (iOS: the extension's profile; found by App ID when empty)
	-->
	<PropertyGroup>
		<SpinePushEnabled Condition="'$(SpinePushEnabled)' == ''">true</SpinePushEnabled>
		<SpinePushRemote Condition="'$(SpinePushRemote)' == ''">true</SpinePushRemote>
		<SpinePushImages Condition="'$(SpinePushImages)' == ''">false</SpinePushImages>
		<SpinePushImagesCodesignProvision Condition="'$(SpinePushImagesCodesignProvision)' == ''"></SpinePushImagesCodesignProvision>
		<_SpinePushImagesExtensionName>SpineNotificationService</_SpinePushImagesExtensionName>
		<_SpinePushNativeDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', 'native', 'ios'))</_SpinePushNativeDir>
		<_SpinePushScript>$(MSBuildThisFileDirectory)spine-push-build.sh</_SpinePushScript>
		<_SpinePushImagesApplies Condition="'$(SpinePushEnabled)' == 'true' And '$(SpinePushRemote)' == 'true' And '$(SpinePushImages)' == 'true' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' And '$(DesignTimeBuild)' != 'true' And $([MSBuild]::IsOSPlatform('OSX'))">true</_SpinePushImagesApplies>
		<SpinePushEnvironment Condition="'$(SpinePushEnvironment)' == '' And '$(Configuration)' == 'Debug'">development</SpinePushEnvironment>
		<SpinePushEnvironment Condition="'$(SpinePushEnvironment)' == ''">production</SpinePushEnvironment>
		<_SpinePushApple Condition="'$(SpinePushEnabled)' == 'true' And '$(SpinePushRemote)' == 'true' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">true</_SpinePushApple>
		<!--
			On Mac Catalyst the push entitlement is restricted: an app signed with it but without a
			provisioning profile that grants it does not launch at all. So remote push there follows the
			signing — the entitlement and background mode are written only when the app names a profile
			(CodesignProvision). Without one the app still gets local notifications, and the runtime
			skips the APNs registration it could not complete.
		-->
		<_SpinePushApple Condition="'$(SpinePushEnabled)' == 'true' And '$(SpinePushRemote)' == 'true' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst' And '$(CodesignProvision)' != ''">true</_SpinePushApple>
	</PropertyGroup>

	<!--
		aps-environment decides which APNs host the device token is valid against, so a development
		build's token only works against the sandbox. Contributed to the shared entitlements step in
		Plugin.Maui.Spine, which merges it with whatever Plugin.Maui.Spine.Widgets needs.

		On Mac Catalyst Apple's own documentation disagrees with itself about which key applies, so
		both are written; an unknown entitlement is ignored rather than fatal.
	-->
	<ItemGroup Condition="'$(_SpinePushApple)' == 'true'">
		<SpineEntitlement Include="aps-environment" Kind="string" Value="$(SpinePushEnvironment)"
						  Because="It decides which APNs host the device token is valid against." />
		<SpineEntitlement Include="com.apple.developer.aps-environment" Kind="string" Value="$(SpinePushEnvironment)"
						  Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'"
						  Because="Mac Catalyst has been documented under both spellings." />
	</ItemGroup>

	<Target Name="_SpinePushAppleManifest"
			Condition="'$(_SpinePushApple)' == 'true' And '$(DesignTimeBuild)' != 'true'"
			DependsOnTargets="_SpineWriteEntitlements"
			BeforeTargets="_CompileAppManifestInputs;_CompileAppManifest;_DetectSigningIdentity;_CompileEntitlements">

		<PropertyGroup>
			<_SpinePushOutDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'spinepush'))</_SpinePushOutDir>
			<_SpinePushManifest>$(_SpinePushOutDir)PushManifest.plist</_SpinePushManifest>
		</PropertyGroup>

		<MakeDir Directories="$(_SpinePushOutDir)" />

		<!--
			remote-notification lets a silent push wake the app; SpinePushEnvironment is read back at
			runtime so the installation can tell the server which APNs host its token belongs to.
		-->
		<ItemGroup>
			<!-- '?' is a wildcard in an Include; see the note in Plugin.Maui.Spine.Entitlements.targets. -->
			<_SpinePushManifestLine Include="&lt;%3Fxml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;%3F&gt;" />
			<_SpinePushManifestLine Include="&lt;!DOCTYPE plist PUBLIC &quot;-//Apple//DTD PLIST 1.0//EN&quot; &quot;http://www.apple.com/DTDs/PropertyList-1.0.dtd&quot;&gt;" />
			<_SpinePushManifestLine Include="&lt;plist version=&quot;1.0&quot;&gt;" />
			<_SpinePushManifestLine Include="&lt;dict&gt;" />
			<_SpinePushManifestLine Include="&lt;key&gt;UIBackgroundModes&lt;/key&gt;" />
			<_SpinePushManifestLine Include="&lt;array&gt;&lt;string&gt;remote-notification&lt;/string&gt;&lt;/array&gt;" />
			<_SpinePushManifestLine Include="&lt;key&gt;SpinePushEnvironment&lt;/key&gt;" />
			<_SpinePushManifestLine Include="&lt;string&gt;$(SpinePushEnvironment)&lt;/string&gt;" />
			<_SpinePushManifestLine Include="&lt;/dict&gt;" />
			<_SpinePushManifestLine Include="&lt;/plist&gt;" />
		</ItemGroup>

		<WriteLinesToFile File="$(_SpinePushManifest)" Lines="@(_SpinePushManifestLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />

		<ItemGroup>
			<PartialAppManifest Include="$(_SpinePushManifest)" />
		</ItemGroup>
	</Target>

	<!--
		iOS pictures: the Notification Service Extension. Built like the widget extension — swiftc, no
		Xcode project — for inner (RuntimeIdentifier-specific) builds only, and registered as one more
		AdditionalAppExtensions item. Every target repeats the condition on RuntimeIdentifier because it is
		empty at evaluation time for the outer build.
	-->
	<Target Name="_SpinePushImagesPrepare"
			Condition="'$(_SpinePushImagesApplies)' == 'true' And '$(RuntimeIdentifier)' != ''">
		<PropertyGroup>
			<_SpinePushImagesSdk Condition="$(RuntimeIdentifier.Contains('simulator'))">iphonesimulator</_SpinePushImagesSdk>
			<_SpinePushImagesSdk Condition="'$(_SpinePushImagesSdk)' == ''">iphoneos</_SpinePushImagesSdk>
			<_SpinePushImagesArch>$(RuntimeIdentifier.Substring($([MSBuild]::Add($(RuntimeIdentifier.IndexOf('-')), 1))))</_SpinePushImagesArch>
			<_SpinePushImagesMinOS>$(SupportedOSPlatformVersion)</_SpinePushImagesMinOS>
			<_SpinePushImagesMinOS Condition="'$(_SpinePushImagesMinOS)' == ''">15.0</_SpinePushImagesMinOS>
			<_SpinePushImagesOutDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', 'obj', 'spinepush', '$(Configuration)', '$(RuntimeIdentifier)'))</_SpinePushImagesOutDir>
			<_SpinePushImagesInputsFile>$(_SpinePushImagesOutDir)inputs.txt</_SpinePushImagesInputsFile>
			<_SpinePushImagesStamp>$(_SpinePushImagesOutDir)build.stamp</_SpinePushImagesStamp>
			<_SpinePushImagesBundleId>$(ApplicationId).$(_SpinePushImagesExtensionName)</_SpinePushImagesBundleId>
			<_SpinePushImagesRequireProvision>false</_SpinePushImagesRequireProvision>
			<_SpinePushImagesRequireProvision Condition="'$(_SpinePushImagesSdk)' == 'iphoneos' And '$(EnableCodeSigning)' != 'false'">true</_SpinePushImagesRequireProvision>
		</PropertyGroup>

		<MakeDir Directories="$(_SpinePushImagesOutDir)" />

		<ItemGroup>
			<_SpinePushImagesInputLine Include="$(_SpinePushImagesBundleId);$(_SpinePushImagesMinOS);$(Configuration);$(ApplicationTitle);$(_SpinePushImagesArch);$(_SpinePushImagesSdk);$(SpinePushImagesCodesignProvision);$(_SpinePushImagesRequireProvision)" />
		</ItemGroup>
		<WriteLinesToFile File="$(_SpinePushImagesInputsFile)" Lines="@(_SpinePushImagesInputLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />

		<ItemGroup>
			<_SpinePushImagesInputs Include="$(_SpinePushNativeDir)*.swift;$(_SpinePushScript);$(_SpinePushImagesInputsFile)" />
		</ItemGroup>
	</Target>

	<Target Name="_SpinePushImagesBuild"
			DependsOnTargets="_SpinePushImagesPrepare"
			Condition="'$(_SpinePushImagesApplies)' == 'true' And '$(RuntimeIdentifier)' != ''"
			Inputs="@(_SpinePushImagesInputs)"
			Outputs="$(_SpinePushImagesStamp)">
		<Exec Command="&quot;$(_SpinePushScript)&quot; --out &quot;$(_SpinePushImagesOutDir.TrimEnd('/'))&quot; --sources &quot;$(_SpinePushNativeDir.TrimEnd('/'))&quot; --sdk $(_SpinePushImagesSdk) --arch $(_SpinePushImagesArch) --min-os $(_SpinePushImagesMinOS) --config $(Configuration) --bundle-id &quot;$(_SpinePushImagesBundleId)&quot; --name &quot;$(_SpinePushImagesExtensionName)&quot; --display-name &quot;$(ApplicationTitle)&quot; --provision &quot;$(SpinePushImagesCodesignProvision)&quot; --require-provision $(_SpinePushImagesRequireProvision)" />
	</Target>

	<Target Name="_SpinePushImagesRegister"
			DependsOnTargets="_SpinePushImagesBuild"
			Condition="'$(_SpinePushImagesApplies)' == 'true' And '$(RuntimeIdentifier)' != ''"
			BeforeTargets="_CollectBundleResources;_DetectSigningIdentity;_CompileEntitlements;_ResolveAppExtensionReferences;_ExtendAppExtensionReferences">
		<PropertyGroup>
			<!-- As for the widget extension: a simulator build on a Mac without a signing identity still
			     has to sign the extension, and the SDK snapshots CodesignKey into _SpecifiedCodesignKey. -->
			<CodesignKey Condition="'$(CodesignKey)' == '' And '$(_SpinePushImagesSdk)' == 'iphonesimulator'">-</CodesignKey>
			<_SpecifiedCodesignKey Condition="'$(_SpecifiedCodesignKey)' == '' And '$(_SpinePushImagesSdk)' == 'iphonesimulator'">-</_SpecifiedCodesignKey>
		</PropertyGroup>

		<ItemGroup>
			<AdditionalAppExtensions Include="$(_SpinePushImagesOutDir.TrimEnd('/'))" Name="$(_SpinePushImagesExtensionName)" BuildOutput="." CodesignEntitlements="$(_SpinePushImagesOutDir)$(_SpinePushImagesExtensionName).entitlements" />
		</ItemGroup>
	</Target>

	<!--
		Android: Firebase needs google-services.json. Without it the app builds and then fails to get a
		token at runtime, with an error that says nothing about the missing file — so it fails here instead.
	-->
	<!--
		Firebase Messaging's AndroidX dependencies declare minSdk 23, and the manifest merger fails with
		a wall of text if the app allows less. Spine's own floor is 21, so this is the package's
		requirement and not the repo's — it is stated here rather than raised for everyone.
	-->
	<!--
		Not gated on SpinePushRemote: the Firebase dependency comes with the package whether or not the
		app uses remote push, so the floor it brings applies either way. What SpinePushRemote drops is
		the configuration — google-services.json below, and the Apple entitlement above.
	-->
	<Target Name="_SpinePushAndroidMinSdk"
			Condition="'$(SpinePushEnabled)' == 'true' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And '$(DesignTimeBuild)' != 'true'"
			BeforeTargets="BeforeBuild">
		<Error Condition="'$(SupportedOSPlatformVersion)' != '' And $([MSBuild]::VersionLessThan('$(SupportedOSPlatformVersion)', '23'))"
			   Text="Spine.Push: Android needs SupportedOSPlatformVersion 23 or higher; this project has $(SupportedOSPlatformVersion). Firebase Messaging's dependencies declare minSdk 23. Add &lt;SupportedOSPlatformVersion Condition=&quot;$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'&quot;&gt;23&lt;/SupportedOSPlatformVersion&gt; to the app project." />
	</Target>

	<Target Name="_SpinePushAndroidCheck"
			Condition="'$(SpinePushEnabled)' == 'true' And '$(SpinePushRemote)' == 'true' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And '$(DesignTimeBuild)' != 'true'"
			BeforeTargets="BeforeBuild">
		<Error Condition="'@(GoogleServicesJson)' == ''"
			   Text="Spine.Push: Android needs Firebase's google-services.json. Download it from the Firebase console and add &lt;GoogleServicesJson Include=&quot;Platforms\Android\google-services.json&quot; /&gt; to the app project. Set SpinePushRemote=false to keep local notifications without it, or SpinePushEnabled=false to build without either." />
	</Target>

	<!--
		The extension's debug symbols go beside the app's: into the output directory after the build, and into
		the archive's dSYMs folder when one is made. The SDK does neither for an extension from
		AdditionalAppExtensions (seen with the 26.2 SDK), and without them a crash in the extension cannot be
		symbolicated. The archive hook is the SDK's _CoreArchive, the target that sets $(ArchiveDir); the dSYM
		copied there is named in the build output, so a hook that stops firing shows.
	-->
	<Target Name="_SpinePushImagesCopySymbols" AfterTargets="Build" DependsOnTargets="_SpinePushImagesPrepare"
			Condition="'$(_SpinePushImagesApplies)' == 'true' And '$(RuntimeIdentifier)' != ''">
		<ItemGroup Condition="Exists('$(_SpinePushImagesOutDir)')">
			<_SpinePushImagesSymbols Include="$([System.IO.Directory]::GetDirectories('$(_SpinePushImagesOutDir)', '*.dSYM'))" />
		</ItemGroup>
		<Exec Condition="'@(_SpinePushImagesSymbols)' != ''"
			  Command="/usr/bin/ditto &quot;%(_SpinePushImagesSymbols.Identity)&quot; &quot;$(DeviceSpecificOutputPath)%(_SpinePushImagesSymbols.Filename)%(_SpinePushImagesSymbols.Extension)&quot;" />
	</Target>

	<Target Name="_SpinePushImagesArchiveSymbols" AfterTargets="_CoreArchive" DependsOnTargets="_SpinePushImagesPrepare"
			Condition="'$(_SpinePushImagesApplies)' == 'true' And '$(RuntimeIdentifier)' != '' And '$(ArchiveOnBuild)' == 'true'">
		<ItemGroup Condition="Exists('$(_SpinePushImagesOutDir)') And '$(ArchiveDir)' != ''">
			<_SpinePushImagesArchivedSymbols Include="$([System.IO.Directory]::GetDirectories('$(_SpinePushImagesOutDir)', '*.dSYM'))" />
		</ItemGroup>
		<Exec Condition="'@(_SpinePushImagesArchivedSymbols)' != ''"
			  Command="/usr/bin/ditto &quot;%(_SpinePushImagesArchivedSymbols.Identity)&quot; &quot;$(ArchiveDir)/dSYMs/%(_SpinePushImagesArchivedSymbols.Filename)%(_SpinePushImagesArchivedSymbols.Extension)&quot;" />
		<Message Importance="high" Condition="'@(_SpinePushImagesArchivedSymbols)' != ''"
				 Text="Spine.Push: archived %(_SpinePushImagesArchivedSymbols.Filename)%(_SpinePushImagesArchivedSymbols.Extension)" />
	</Target>
</Project>
