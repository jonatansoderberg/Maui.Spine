<Project Sdk="Microsoft.NET.Sdk">

	<!--
		net10.0 carries only the platform-neutral core (the server client, the fallback chain and the meter), so it
		can be tested against a real Spine.Server.AI host without a device; the MAUI TFMs add UseSpineAI, the
		installation id in SecureStorage and the on-device usage in Preferences.
	-->
	<PropertyGroup>
		<TargetFrameworks>net10.0;$(SpineMauiTargetFrameworks)</TargetFrameworks>

		<AssemblyName>Plugin.Maui.Spine.AI</AssemblyName>
		<RootNamespace>Plugin.Maui.Spine.AI</RootNamespace>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)' != 'net10.0'">
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
	</PropertyGroup>

	<PropertyGroup>
		<Description>AI in a Spine app without keys in the app: one IChatClient per named feature that streams from the app's Spine.Server.AI backend, can try an on-device model first, answers "off", budget and rate limits in one shape, and counts on-device usage on the device.</Description>
		<SpineIcon>ai.png</SpineIcon>
		<PackageTags>$(PackageTags);ai;llm;microsoft-extensions-ai;chat;on-device;apple-intelligence</PackageTags>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
		<PackageReference Include="Microsoft.Maui.Controls" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Plugin.Maui.Spine.Common\Plugin.Maui.Spine.Common.csproj" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<Compile Remove="**\*.cs" />
		<Compile Include="Core\**\*.cs" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Plugin.Maui.Spine.AI.Tests" />
	</ItemGroup>

	<!-- Declares the package to UseSpine(); see Plugin.Maui.Spine's build\Plugin.Maui.Spine.targets. -->
	<ItemGroup>
		<None Include="build\**" Pack="true" PackagePath="build\;buildTransitive\" />
	</ItemGroup>

</Project>
