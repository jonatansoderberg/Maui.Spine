<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>$(SpineMauiTargetFrameworks)</TargetFrameworks>
		<AssemblyName>Plugin.Maui.Spine.Widgets</AssemblyName>
		<RootNamespace>Plugin.Maui.Spine.Widgets</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>

	</PropertyGroup>

	<PropertyGroup>
		<Description>Home-screen widgets and Live Activities for .NET MAUI, built from C#: a WidgetKit extension on iOS compiled during the app build and AppWidgetProvider receivers on Android, both drawn from one serialized view tree.</Description>
		<SpineIcon>widgets.png</SpineIcon>
		<PackageTags>$(PackageTags);widgets;widgetkit;live-activities;appwidget</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Plugin.Maui.Spine\Plugin.Maui.Spine.csproj" />
		<ProjectReference Include="..\Plugin.Maui.Spine.Common\Plugin.Maui.Spine.Common.csproj" />
	</ItemGroup>

	<!-- The Swift sources and the MSBuild pipeline that turns them into the widget extension travel
	     with the package; a ProjectReference consumer imports build\Plugin.Maui.Spine.Widgets.targets explicitly. -->
	<ItemGroup>
		<None Include="build\**" Pack="true" PackagePath="build\;buildTransitive\" />
		<None Include="native\**" Pack="true" PackagePath="native\" />
	</ItemGroup>

</Project>
