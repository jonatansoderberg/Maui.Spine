<Project Sdk="Microsoft.NET.Sdk">

	<!--
		net10.0 carries only the Skia renderer (Skia/, SkiaSharp) and the drivers (Drivers/), so scenes, shaders and drivers are
		tested without a device; the MAUI TFMs add AvatarView, the surfaces and UseSpineAvatar.
	-->
	<PropertyGroup>
		<TargetFrameworks>net10.0;$(SpineMauiTargetFrameworks)</TargetFrameworks>
		<AssemblyName>Plugin.Maui.Spine.Controls.Avatar</AssemblyName>
		<RootNamespace>Plugin.Maui.Spine.Controls</RootNamespace>
		<!-- The renderer door waits for spike S2 of docs/plans/spine-avatar.md; the package uses it itself. -->
		<NoWarn>$(NoWarn);SPINEAVATAR001</NoWarn>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)' != 'net10.0'">
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
	</PropertyGroup>

	<PropertyGroup>
		<Description>AvatarView for Spine: animated characters and ambient visuals from .spineavatar files, drawn with SkiaSharp (vector scenes and SkSL shaders) and SceneKit (glTF on iOS and Mac Catalyst), driven by the app's state, by text, by speech or by a realtime voice conversation, with Reduce Motion, the app's theme and one screen-reader element. Built-in bars and ring show a voice's sound in and out.</Description>
		<SpineIcon>avatar.png</SpineIcon>
		<PackageTags>$(PackageTags);avatar;character;lip-sync;skiasharp;scenekit;gltf;voice;visualizer;realtime</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="SkiaSharp" />
		<ProjectReference Include="..\Plugin.Maui.Spine.Controls.Avatar.Core\Plugin.Maui.Spine.Controls.Avatar.Core.csproj" />
		<ProjectReference Include="..\Plugin.Maui.Spine.Speech\Plugin.Maui.Spine.Speech.csproj" />
		<ProjectReference Include="..\Plugin.Maui.Spine.Voice\Plugin.Maui.Spine.Voice.csproj" />
	</ItemGroup>

	<!-- The built-in avatars (AvatarSource.BuiltIn, Source="bars"): the packages in samples/Avatars, the one copy the lab, the Showcase and the tests use too. -->
	<ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
		<EmbeddedResource Include="..\..\samples\Avatars\bars.spineavatar" LogicalName="Plugin.Maui.Spine.Controls.Avatar.bars.spineavatar" />
		<EmbeddedResource Include="..\..\samples\Avatars\ring.spineavatar" LogicalName="Plugin.Maui.Spine.Controls.Avatar.ring.spineavatar" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
		<PackageReference Include="Microsoft.Maui.Controls" />
		<PackageReference Include="SkiaSharp.Views.Maui.Controls" />
		<ProjectReference Include="..\Plugin.Maui.Spine\Plugin.Maui.Spine.csproj" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<Compile Remove="**\*.cs" />
		<Compile Include="Skia\**\*.cs" />
		<Compile Include="Drivers\**\*.cs" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Plugin.Maui.Spine.Controls.Avatar.Core.Tests" />
		<!-- The spine-avatar tool draws posters and sheets with the Skia renderers. -->
		<InternalsVisibleTo Include="spine-avatar" />
		<!-- The lab's inspector reads the surfaces' frame timing once it runs on this package (B1.3). -->
		<InternalsVisibleTo Include="SpineAvatarLab" />
	</ItemGroup>

	<!-- Declares the package to UseSpine(); see Plugin.Maui.Spine's build\Plugin.Maui.Spine.targets. -->
	<ItemGroup>
		<None Include="build\**" Pack="true" PackagePath="build\;buildTransitive\" />
	</ItemGroup>

</Project>
