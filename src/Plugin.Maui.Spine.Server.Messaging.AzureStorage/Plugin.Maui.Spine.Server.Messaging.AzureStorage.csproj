<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyName>Plugin.Maui.Spine.Server.Messaging.AzureStorage</AssemblyName>
		<RootNamespace>Plugin.Maui.Spine.Server.Messaging.AzureStorage</RootNamespace>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<PropertyGroup>
		<Description>Azure Storage for Spine messaging: Storage Queues as the simple, cheap transport, and blob storage for large payloads, failed messages and markers (used by every transport). Runs under Aspire on Azurite.</Description>
		<SpineIcon>server-messaging.png</SpineIcon>
		<PackageTags>$(PackageTags);messaging;queues;azure-storage;storage-queues;blob-storage;azure-functions</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Plugin.Maui.Spine.Server.Messaging.Tests" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Plugin.Maui.Spine.Server.Messaging\Plugin.Maui.Spine.Server.Messaging.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Azure.Storage.Blobs" />
		<PackageReference Include="Azure.Storage.Queues" />
	</ItemGroup>

</Project>
