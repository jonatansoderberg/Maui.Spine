<Project>

	<!-- Each package names its icon in assets/icons/ with SpineIcon; the core's is the default.
	     Resolved here, after the project body, so a project's own value wins. -->
	<PropertyGroup>
		<SpineIcon Condition="'$(SpineIcon)' == ''">spine.png</SpineIcon>
		<PackageIcon>$(SpineIcon)</PackageIcon>
	</PropertyGroup>

	<ItemGroup>
		<None Include="$(MSBuildThisFileDirectory)../assets/icons/$(SpineIcon)" Pack="true" PackagePath="/" Visible="false" />
	</ItemGroup>

	<!-- A released version is major.yyMMdd.revision, and an assembly version part stops at 65535 (CS7034): the assembly
	     version carries the major alone and the file version splits the date, 0.261031.812 → 0.26.1031.812. -->
	<PropertyGroup Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(Version)', '^\d+\.\d{6}\.\d+'))">
		<AssemblyVersion>$([System.Text.RegularExpressions.Regex]::Replace('$(Version)', '^(\d+)\..*$', '$1.0.0.0'))</AssemblyVersion>
		<FileVersion>$([System.Text.RegularExpressions.Regex]::Replace('$(Version)', '^(\d+)\.(\d\d)0*(\d+)\.(\d+).*$', '$1.$2.$3.$4'))</FileVersion>
	</PropertyGroup>

</Project>
