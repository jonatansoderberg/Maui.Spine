<Project Sdk="Microsoft.NET.Sdk">

	<!--
		net10.0 carries only the platform-neutral core (the utterance, the queue every engine shares, choosing a voice), so
		it is tested without a device; the MAUI TFMs add the engines and UseSpineSpeech.
	-->
	<PropertyGroup>
		<TargetFrameworks>net10.0;$(SpineMauiTargetFrameworks)</TargetFrameworks>
		<AssemblyName>Plugin.Maui.Spine.Speech</AssemblyName>
		<RootNamespace>Plugin.Maui.Spine.Speech</RootNamespace>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)' != 'net10.0'">
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
	</PropertyGroup>

	<PropertyGroup>
		<Description>Text-to-speech for Spine apps with what a caption or an avatar needs to follow it: the installed voices with their quality (Apple's Enhanced and Premium voices too), and for each utterance its start, each word as the voice reaches it, its position and its end. AVSpeechSynthesizer on iOS and Mac Catalyst, TextToSpeech on Android, SpeechSynthesizer on Windows.</Description>
		<SpineIcon>speech.png</SpineIcon>
		<PackageTags>$(PackageTags);speech;text-to-speech;tts;voice;accessibility</PackageTags>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
		<PackageReference Include="Microsoft.Maui.Controls" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<Compile Remove="**\*.cs" />
		<Compile Include="Core\**\*.cs" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Plugin.Maui.Spine.Speech.Tests" />
		<!-- The avatar tests drive the Speech driver with a fake voice built on the shared queue. -->
		<InternalsVisibleTo Include="Plugin.Maui.Spine.Controls.Avatar.Core.Tests" />
		<!-- ServerSpeech builds on the shared queue and reports the engine's playback position. -->
		<InternalsVisibleTo Include="Plugin.Maui.Spine.Voice" />
	</ItemGroup>

	<!-- Declares the package to UseSpine(); see Plugin.Maui.Spine's build\Plugin.Maui.Spine.targets. -->
	<ItemGroup>
		<None Include="build\**" Pack="true" PackagePath="build\;buildTransitive\" />
	</ItemGroup>

</Project>
