<Project>
	<!--
		Both Plugin.Maui.Spine.Widgets and Plugin.Maui.Spine.PushNotifications need keys in the host app's
		entitlements: the App Group for the widget extension, aps-environment for push. Neither can own
		the file — whichever wrote it last would erase the other's keys — so they contribute
		<SpineEntitlement> items and this target writes the file once.

		  <SpineEntitlement Include="aps-environment" Kind="string" Value="development" />
		  <SpineEntitlement Include="com.apple.security.application-groups" Kind="array" Value="group.x" />
		  <SpineEntitlement Include="com.apple.developer.usernotifications.time-sensitive" Kind="boolean" Value="true" />

		A package that needs the file written adds DependsOnTargets="_SpineWriteEntitlements", so the
		order does not depend on how MSBuild happens to sequence two BeforeTargets on the same target.

		It lives in Plugin.Maui.Spine.Common because both packages already depend on it, and neither
		needs Plugin.Maui.Spine itself for this. Consumed through a ProjectReference this file has to be
		imported explicitly, the same way Plugin.Maui.Spine.Widgets.targets is; a PackageReference
		imports it on its own.
	-->

	<PropertyGroup>
		<_SpineEntitlementsApplies Condition="($([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst') And '$(DesignTimeBuild)' != 'true'">true</_SpineEntitlementsApplies>
	</PropertyGroup>

	<Target Name="_SpineWriteEntitlements"
			Condition="'$(_SpineEntitlementsApplies)' == 'true' And '@(SpineEntitlement)' != ''"
			BeforeTargets="_DetectSigningIdentity;_CompileEntitlements">

		<!--
			An app that brought its own entitlements file keeps it: overwriting would drop whatever else
			it declares. Spine checks that the keys it needs are in there and says which one is missing.
		-->
		<PropertyGroup>
			<!-- IntermediateOutputPath is set by the SDK targets, so the path is built here and not at
			     evaluation time, where it is still empty. -->
			<_SpineEntitlementsFile>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'spine', 'Spine.entitlements'))</_SpineEntitlementsFile>
			<_SpineEntitlementsAppOwned Condition="'$(CodesignEntitlements)' != '' And '$(CodesignEntitlements)' != '$(_SpineEntitlementsFile)'">true</_SpineEntitlementsAppOwned>
		</PropertyGroup>

		<Error Condition="'$(_SpineEntitlementsAppOwned)' == 'true' And !Exists('$(CodesignEntitlements)')"
			   Text="Spine: CodesignEntitlements is set to '$(CodesignEntitlements)', which does not exist." />

		<Error Condition="'$(_SpineEntitlementsAppOwned)' == 'true' And !$([System.IO.File]::ReadAllText('$(CodesignEntitlements)').Contains('%(SpineEntitlement.Identity)'))"
			   Text="Spine: the app's entitlements ($(CodesignEntitlements)) must declare '%(SpineEntitlement.Identity)'. %(SpineEntitlement.Because)" />

		<MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(_SpineEntitlementsFile)'))" Condition="'$(_SpineEntitlementsAppOwned)' != 'true'" />

		<ItemGroup Condition="'$(_SpineEntitlementsAppOwned)' != 'true'">
			<!-- '?' is a wildcard in an Include, so the XML declaration is escaped; unescaped it is
			     read as a file glob, matches nothing, and the line silently disappears. -->
			<_SpineEntitlementLine Include="&lt;%3Fxml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;%3F&gt;" />
			<_SpineEntitlementLine Include="&lt;!DOCTYPE plist PUBLIC &quot;-//Apple//DTD PLIST 1.0//EN&quot; &quot;http://www.apple.com/DTDs/PropertyList-1.0.dtd&quot;&gt;" />
			<_SpineEntitlementLine Include="&lt;plist version=&quot;1.0&quot;&gt;" />
			<_SpineEntitlementLine Include="&lt;dict&gt;" />
			<_SpineEntitlementLine Include="@(SpineEntitlement->'&lt;key&gt;%(Identity)&lt;/key&gt;')" Condition="'%(SpineEntitlement.Kind)' == 'string'" />
			<_SpineEntitlementLine Include="@(SpineEntitlement->'&lt;string&gt;%(Value)&lt;/string&gt;')" Condition="'%(SpineEntitlement.Kind)' == 'string'" />
			<_SpineEntitlementLine Include="@(SpineEntitlement->'&lt;key&gt;%(Identity)&lt;/key&gt;')" Condition="'%(SpineEntitlement.Kind)' == 'array'" />
			<_SpineEntitlementLine Include="@(SpineEntitlement->'&lt;array&gt;&lt;string&gt;%(Value)&lt;/string&gt;&lt;/array&gt;')" Condition="'%(SpineEntitlement.Kind)' == 'array'" />
			<_SpineEntitlementLine Include="@(SpineEntitlement->'&lt;key&gt;%(Identity)&lt;/key&gt;')" Condition="'%(SpineEntitlement.Kind)' == 'boolean'" />
			<_SpineEntitlementLine Include="@(SpineEntitlement->'&lt;%(Value)/&gt;')" Condition="'%(SpineEntitlement.Kind)' == 'boolean'" />
			<_SpineEntitlementLine Include="&lt;/dict&gt;" />
			<_SpineEntitlementLine Include="&lt;/plist&gt;" />
		</ItemGroup>

		<WriteLinesToFile File="$(_SpineEntitlementsFile)" Lines="@(_SpineEntitlementLine)" Overwrite="true" WriteOnlyWhenDifferent="true"
						  Condition="'$(_SpineEntitlementsAppOwned)' != 'true'" />

		<PropertyGroup Condition="'$(_SpineEntitlementsAppOwned)' != 'true'">
			<CodesignEntitlements>$(_SpineEntitlementsFile)</CodesignEntitlements>
		</PropertyGroup>

		<Message Importance="normal" Text="Spine: entitlements written to $(CodesignEntitlements) with @(SpineEntitlement->'%(Identity)', ', ')."
				 Condition="'$(_SpineEntitlementsAppOwned)' != 'true'" />
	</Target>

	<!--
		UIBackgroundModes has the same problem in Info.plist. The SDK merges every PartialAppManifest over
		the app's Info.plist, and merges dictionaries but replaces arrays: two packages each writing the key
		leave only the last one's mode, and either one erases the modes the app declares itself. So the
		packages contribute <SpineBackgroundMode> items, and this target writes one partial plist with
		those and the app's own modes.

		  <SpineBackgroundMode Include="remote-notification" />

		BGTaskSchedulerPermittedIdentifiers is an array too, and every package that schedules a BGTask
		needs its identifier in it, so it goes into the same file the same way:

		  <SpineBackgroundTaskIdentifier Include="$(ApplicationId).spine.refresh" />
	-->
	<Target Name="_SpineWriteBackgroundModes"
			Condition="'$(_SpineEntitlementsApplies)' == 'true' And ('@(SpineBackgroundMode)' != '' Or '@(SpineBackgroundTaskIdentifier)' != '')"
			DependsOnTargets="_DetectAppManifest"
			BeforeTargets="CollectAppManifests;_CompileAppManifestInputs;_CompileAppManifest">

		<PropertyGroup>
			<_SpineBackgroundModesFile>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'spine', 'BackgroundModes.plist'))</_SpineBackgroundModesFile>
		</PropertyGroup>

		<!-- An Info.plist has a DOCTYPE, which XmlPeek refuses unless DTDs are allowed; the DTD itself is
		     not fetched. -->
		<XmlPeek XmlInputPath="$(AppBundleManifest)" ProhibitDtd="false"
				 Query="/plist/dict/key[.='UIBackgroundModes']/following-sibling::*[1]/string/text()"
				 Condition="'$(AppBundleManifest)' != '' And Exists('$(AppBundleManifest)')">
			<Output TaskParameter="Result" ItemName="_SpineAppBackgroundMode" />
		</XmlPeek>
		<XmlPeek XmlInputPath="$(AppBundleManifest)" ProhibitDtd="false"
				 Query="/plist/dict/key[.='BGTaskSchedulerPermittedIdentifiers']/following-sibling::*[1]/string/text()"
				 Condition="'$(AppBundleManifest)' != '' And Exists('$(AppBundleManifest)')">
			<Output TaskParameter="Result" ItemName="_SpineAppBackgroundTaskIdentifier" />
		</XmlPeek>

		<ItemGroup>
			<_SpineBackgroundModeAll Include="@(_SpineAppBackgroundMode);@(SpineBackgroundMode)" />
		</ItemGroup>
		<RemoveDuplicates Inputs="@(_SpineBackgroundModeAll)">
			<Output TaskParameter="Filtered" ItemName="_SpineBackgroundModeUnique" />
		</RemoveDuplicates>

		<ItemGroup>
			<_SpineBackgroundTaskIdentifierAll Include="@(_SpineAppBackgroundTaskIdentifier);@(SpineBackgroundTaskIdentifier)" />
		</ItemGroup>
		<RemoveDuplicates Inputs="@(_SpineBackgroundTaskIdentifierAll)">
			<Output TaskParameter="Filtered" ItemName="_SpineBackgroundTaskIdentifierUnique" />
		</RemoveDuplicates>

		<MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(_SpineBackgroundModesFile)'))" />

		<ItemGroup>
			<!-- '?' is a wildcard in an Include; see _SpineWriteEntitlements. -->
			<_SpineBackgroundModesLine Include="&lt;%3Fxml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;%3F&gt;" />
			<_SpineBackgroundModesLine Include="&lt;!DOCTYPE plist PUBLIC &quot;-//Apple//DTD PLIST 1.0//EN&quot; &quot;http://www.apple.com/DTDs/PropertyList-1.0.dtd&quot;&gt;" />
			<_SpineBackgroundModesLine Include="&lt;plist version=&quot;1.0&quot;&gt;" />
			<_SpineBackgroundModesLine Include="&lt;dict&gt;" />
		</ItemGroup>
		<ItemGroup Condition="'@(_SpineBackgroundModeUnique)' != ''">
			<_SpineBackgroundModesLine Include="&lt;key&gt;UIBackgroundModes&lt;/key&gt;" />
			<_SpineBackgroundModesLine Include="&lt;array&gt;" />
			<_SpineBackgroundModesLine Include="@(_SpineBackgroundModeUnique->'&lt;string&gt;%(Identity)&lt;/string&gt;')" />
			<_SpineBackgroundModesLine Include="&lt;/array&gt;" />
		</ItemGroup>
		<ItemGroup Condition="'@(_SpineBackgroundTaskIdentifierUnique)' != ''">
			<_SpineBackgroundModesLine Include="&lt;key&gt;BGTaskSchedulerPermittedIdentifiers&lt;/key&gt;" />
			<_SpineBackgroundModesLine Include="&lt;array&gt;" />
			<_SpineBackgroundModesLine Include="@(_SpineBackgroundTaskIdentifierUnique->'&lt;string&gt;%(Identity)&lt;/string&gt;')" />
			<_SpineBackgroundModesLine Include="&lt;/array&gt;" />
		</ItemGroup>
		<ItemGroup>
			<_SpineBackgroundModesLine Include="&lt;/dict&gt;" />
			<_SpineBackgroundModesLine Include="&lt;/plist&gt;" />
		</ItemGroup>

		<WriteLinesToFile File="$(_SpineBackgroundModesFile)" Lines="@(_SpineBackgroundModesLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />

		<ItemGroup>
			<PartialAppManifest Include="$(_SpineBackgroundModesFile)" />
		</ItemGroup>

		<Message Importance="normal" Text="Spine: UIBackgroundModes (@(_SpineBackgroundModeUnique, ', ')) and BGTaskSchedulerPermittedIdentifiers (@(_SpineBackgroundTaskIdentifierUnique, ', ')) written to $(_SpineBackgroundModesFile)." />
	</Target>

</Project>
