<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyName>Plugin.Maui.Spine.Common</AssemblyName>
		<RootNamespace>Plugin.Maui.Spine.Common</RootNamespace>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<PropertyGroup>
		<Description>Contracts shared between Spine apps and servers: the widget and Live Activity tree model, push installations, tags and keys, background tasks, and the AI features' answers. No MAUI dependency.</Description>
		<SpineIcon>common.png</SpineIcon>
		<PackageTags>$(PackageTags);widgets;push;contracts</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<!-- The icon walk is shared with the widget renderer and tested directly. -->
		<InternalsVisibleTo Include="Plugin.Maui.Spine.Widgets" />
		<!-- The marker that tells Plugin.Maui.Spine.Widgets push is registered. -->
		<InternalsVisibleTo Include="Plugin.Maui.Spine.PushNotifications" />
		<!-- WnsPayload: the WNS wire format, written by the server and read by the Windows app. -->
		<InternalsVisibleTo Include="Plugin.Maui.Spine.Server" />
		<!-- The built-in tasks other Spine packages contribute (SpineBackgroundTaskRegistration). -->
		<InternalsVisibleTo Include="Plugin.Maui.Spine.BackgroundTasks" />
		<InternalsVisibleTo Include="Plugin.Maui.Spine.BackgroundTasks.Tests" />
		<InternalsVisibleTo Include="Plugin.Maui.Spine.Server.Tests" />
		<!-- The AI wire words (AIOffReasons) and the shared installation id (SpineInstallation). -->
		<InternalsVisibleTo Include="Plugin.Maui.Spine.Server.AI" />
		<InternalsVisibleTo Include="Plugin.Maui.Spine.AI.Functions" />
		<InternalsVisibleTo Include="Plugin.Maui.Spine.Server.AI.Tests" />
		<InternalsVisibleTo Include="Plugin.Maui.Spine.AI" />
		<InternalsVisibleTo Include="Plugin.Maui.Spine.AI.Tests" />
		<!-- Voice reads the same refusals as the AI client from the session endpoint. -->
		<InternalsVisibleTo Include="Plugin.Maui.Spine.Voice" />
	</ItemGroup>

	<!-- The entitlements step Plugin.Maui.Spine.Widgets and Plugin.Maui.Spine.PushNotifications share. -->
	<ItemGroup>
		<None Include="build\**" Pack="true" PackagePath="build\;buildTransitive\" />
	</ItemGroup>

</Project>
