<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>$(SpineMauiTargetFrameworks)</TargetFrameworks>

		<AssemblyName>Plugin.Maui.Spine.Controls.Rows</AssemblyName>
		<RootNamespace>Plugin.Maui.Spine.Controls</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<NoWarn>$(NoWarn);CS1591</NoWarn>

	</PropertyGroup>

	<PropertyGroup>
		<Description>SpineRow for .NET MAUI: settings and key/value rows with an SVG icon, title, detail, value, accessory and chevron, native press feedback and one screen-reader element per row.</Description>
		<SpineIcon>rows.png</SpineIcon>
		<PackageTags>$(PackageTags);row;list;settings;accessibility;controls</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Plugin.Maui.Spine\Plugin.Maui.Spine.csproj" />
		<ProjectReference Include="..\Plugin.Maui.Spine.Controls.AnimatedLabel\Plugin.Maui.Spine.Controls.AnimatedLabel.csproj" />
	</ItemGroup>

</Project>
