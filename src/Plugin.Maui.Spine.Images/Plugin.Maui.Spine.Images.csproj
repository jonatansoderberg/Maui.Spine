<Project Sdk="Microsoft.NET.Sdk">

	<!--
		net10.0 carries only the platform-neutral core (the disk cache and the downloads), so it can be
		tested without a device; the MAUI TFMs add the image source services, IImageCache and ImageOptions.
	-->
	<PropertyGroup>
		<TargetFrameworks>net10.0;$(SpineMauiTargetFrameworks)</TargetFrameworks>

		<AssemblyName>Plugin.Maui.Spine.Images</AssemblyName>
		<RootNamespace>Plugin.Maui.Spine.Images</RootNamespace>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)' != 'net10.0'">
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
	</PropertyGroup>

	<PropertyGroup>
		<Description>Remote images for .NET MAUI: a memory and disk cache with downsampling to the view's size off the main thread on iOS, Mac Catalyst and Windows, prefetching on every platform (on Glide's cache on Android), and BlurHash placeholders that show while an image loads.</Description>
		<SpineIcon>images.png</SpineIcon>
		<PackageTags>$(PackageTags);image;cache;prefetch;downsampling;blurhash;placeholder</PackageTags>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
		<PackageReference Include="Microsoft.Maui.Controls" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Plugin.Maui.Spine.Common\Plugin.Maui.Spine.Common.csproj" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<Compile Remove="**\*.cs" />
		<Compile Include="Core\**\*.cs" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Plugin.Maui.Spine.Images.Tests" />
	</ItemGroup>

	<!-- Declares the package to UseSpine(); see Plugin.Maui.Spine's build\Plugin.Maui.Spine.targets. -->
	<ItemGroup>
		<None Include="build\**" Pack="true" PackagePath="build\;buildTransitive\" />
	</ItemGroup>

</Project>
