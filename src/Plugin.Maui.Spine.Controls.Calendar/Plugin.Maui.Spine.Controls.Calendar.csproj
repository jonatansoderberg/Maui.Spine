<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>$(SpineMauiTargetFrameworks)</TargetFrameworks>

		<AssemblyName>Plugin.Maui.Spine.Controls.Calendar</AssemblyName>
		<RootNamespace>Plugin.Maui.Spine.Controls</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<NoWarn>$(NoWarn);CS1591</NoWarn>

	</PropertyGroup>

	<PropertyGroup>
		<Description>Calendar for .NET MAUI: a month calendar with swipe navigation, year and decade pickers, ISO week numbers, days marked from an external source and theme-aware colours, built from plain MAUI views.</Description>
		<SpineIcon>calendar.png</SpineIcon>
		<PackageTags>$(PackageTags);calendar;date;datepicker;controls</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Plugin.Maui.Spine\Plugin.Maui.Spine.csproj" />
	</ItemGroup>

	<!-- The calendar's own words (week column, screen-reader labels), overridable by the app. -->
	<ItemGroup>
		<EmbeddedResource Include="Resources\Strings\*.xml" WithCulture="false" />
	</ItemGroup>

</Project>
