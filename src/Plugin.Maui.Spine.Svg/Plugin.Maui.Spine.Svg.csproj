<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>$(SpineMauiTargetFrameworks)</TargetFrameworks>

		<AssemblyName>Plugin.Maui.Spine.Svg</AssemblyName>
		<RootNamespace>Plugin.Maui.Spine.Svg</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>

	</PropertyGroup>

	<PropertyGroup>
		<Description>SVG rendering for .NET MAUI on SkiaSharp: embedded SVG image sources with theme-aware tinting, icon services, and SVG-to-icon conversion for tray and window icons.</Description>
		<SpineIcon>svg.png</SpineIcon>
		<PackageTags>$(PackageTags);svg;skiasharp;icons</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" />
		<PackageReference Include="SkiaSharp.Views.Maui.Controls" />
		<PackageReference Include="Svg.Skia" />
	</ItemGroup>

</Project>
