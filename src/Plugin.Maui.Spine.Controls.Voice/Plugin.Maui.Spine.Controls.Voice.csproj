<Project Sdk="Microsoft.NET.Sdk">

	<!--
		net10.0 carries only the visuals' drawing (Core/, SkiaSharp), so it is tested by drawing into a bitmap without a
		device; the MAUI TFMs add VoiceView, VoiceVisualView and UseSpineVoiceView.
	-->
	<PropertyGroup>
		<TargetFrameworks>net10.0;$(SpineMauiTargetFrameworks)</TargetFrameworks>

		<AssemblyName>Plugin.Maui.Spine.Controls.Voice</AssemblyName>
		<RootNamespace>Plugin.Maui.Spine.Controls</RootNamespace>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)' != 'net10.0'">
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
	</PropertyGroup>

	<PropertyGroup>
		<Description>VoiceView for Spine.Voice: a voice conversation drawn as it happens, with SkiaSharp. Built-in Orb, duplex Bars, Ring and a simple Avatar that follow the levels, the 24 bands and visemes; a plug-in contract for visuals of your own, drawn on the canvas or hosted in a view of their own.</Description>
		<SpineIcon>ai.png</SpineIcon>
		<PackageTags>$(PackageTags);voice;visualizer;audio;skiasharp;avatar</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="SkiaSharp" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
		<PackageReference Include="Microsoft.Maui.Controls" />
		<PackageReference Include="SkiaSharp.Views.Maui.Controls" />
		<ProjectReference Include="..\Plugin.Maui.Spine\Plugin.Maui.Spine.csproj" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Plugin.Maui.Spine.Voice\Plugin.Maui.Spine.Voice.csproj" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<Compile Remove="**\*.cs" />
		<Compile Include="Core\**\*.cs" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Plugin.Maui.Spine.Controls.Voice.Tests" />
	</ItemGroup>

	<!-- Declares the package to UseSpine(); see Plugin.Maui.Spine's build\Plugin.Maui.Spine.targets. -->
	<ItemGroup>
		<None Include="build\**" Pack="true" PackagePath="build\;buildTransitive\" />
	</ItemGroup>

</Project>
