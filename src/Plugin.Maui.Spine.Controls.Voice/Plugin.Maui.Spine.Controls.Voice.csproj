<Project Sdk="Microsoft.NET.Sdk">

	<!--
		net10.0 carries only the canvas visuals' drawing and VoiceAvatarDriver (Core/), so they are tested without a device;
		the MAUI TFMs add VoiceView, VoiceVisualView, the avatar kinds and UseSpineVoiceView.
	-->
	<PropertyGroup>
		<TargetFrameworks>net10.0;$(SpineMauiTargetFrameworks)</TargetFrameworks>

		<AssemblyName>Plugin.Maui.Spine.Controls.Voice</AssemblyName>
		<RootNamespace>Plugin.Maui.Spine.Controls</RootNamespace>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)' != 'net10.0'">
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
	</PropertyGroup>

	<PropertyGroup>
		<Description>VoiceView for Spine.Voice: a voice conversation drawn as it happens. Built-in orb and a simple face on a SkiaSharp canvas; duplex bars, a ring and a character of your own drawn as avatars, following the levels, the 24 bands and visemes; VoiceAvatarDriver for an AvatarView of your own; a plug-in contract for visuals of your own.</Description>
		<SpineIcon>ai.png</SpineIcon>
		<PackageTags>$(PackageTags);voice;visualizer;audio;skiasharp;avatar;realtime;lip-sync</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="SkiaSharp" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
		<PackageReference Include="Microsoft.Maui.Controls" />
		<PackageReference Include="SkiaSharp.Views.Maui.Controls" />
		<ProjectReference Include="..\Plugin.Maui.Spine\Plugin.Maui.Spine.csproj" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Plugin.Maui.Spine.Voice\Plugin.Maui.Spine.Voice.csproj" />
		<ProjectReference Include="..\Plugin.Maui.Spine.Controls.Avatar\Plugin.Maui.Spine.Controls.Avatar.csproj" />
	</ItemGroup>

	<!-- bars and ring: the packages in samples/Avatars, the one copy the lab, the Showcase and the tests use too. -->
	<ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
		<EmbeddedResource Include="..\..\samples\Avatars\bars.spineavatar" LogicalName="Plugin.Maui.Spine.Controls.Voice.bars.spineavatar" />
		<EmbeddedResource Include="..\..\samples\Avatars\ring.spineavatar" LogicalName="Plugin.Maui.Spine.Controls.Voice.ring.spineavatar" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<Compile Remove="**\*.cs" />
		<Compile Include="Core\**\*.cs" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Plugin.Maui.Spine.Controls.Voice.Tests" />
		<InternalsVisibleTo Include="Plugin.Maui.Spine.Controls.Avatar.Core.Tests" />
	</ItemGroup>

	<!-- Declares the package to UseSpine(); see Plugin.Maui.Spine's build\Plugin.Maui.Spine.targets. -->
	<ItemGroup>
		<None Include="build\**" Pack="true" PackagePath="build\;buildTransitive\" />
	</ItemGroup>

</Project>
