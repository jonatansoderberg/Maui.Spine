<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyName>Plugin.Maui.Spine.AI.Functions</AssemblyName>
		<RootNamespace>Plugin.Maui.Spine.AI</RootNamespace>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<PropertyGroup>
		<Description>Functions the model calls, declared once for a Spine app and its server: where each one runs (the device, the server or both, in an order), the caller's context hidden from the model, and the log of every call. Used by Plugin.Maui.Spine.AI, .Voice and .Server.AI. No MAUI or ASP.NET Core dependency.</Description>
		<SpineIcon>ai.png</SpineIcon>
		<PackageTags>$(PackageTags);ai;llm;microsoft-extensions-ai;tools;function-calling</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Plugin.Maui.Spine.AI" />
		<InternalsVisibleTo Include="Plugin.Maui.Spine.AI.Tests" />
		<InternalsVisibleTo Include="Plugin.Maui.Spine.Voice" />
		<InternalsVisibleTo Include="Plugin.Maui.Spine.Voice.Tests" />
		<InternalsVisibleTo Include="Plugin.Maui.Spine.Server.AI" />
		<InternalsVisibleTo Include="Plugin.Maui.Spine.Server.AI.Tests" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Plugin.Maui.Spine.Common\Plugin.Maui.Spine.Common.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
	</ItemGroup>

</Project>
