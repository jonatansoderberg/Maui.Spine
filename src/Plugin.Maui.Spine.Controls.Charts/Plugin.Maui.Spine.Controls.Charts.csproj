<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>$(SpineMauiTargetFrameworks)</TargetFrameworks>

		<AssemblyName>Plugin.Maui.Spine.Controls.Charts</AssemblyName>
		<RootNamespace>Plugin.Maui.Spine.Controls</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<NoWarn>$(NoWarn);CS1591</NoWarn>

	</PropertyGroup>

	<PropertyGroup>
		<Description>Charts for .NET MAUI: LineChart (a time series over a target band, with gaps, bands between two series, a live point and summer/winter time on the axis), RingChart (a share as a ring, clockwise from 12 o'clock), BarChart (a share as a bar) ColumnChart (values per day or category as columns with labels) and ChartScroller (a line or column chart scrolled back through its history, loaded a day at a time as the window nears it). Drawn with Microsoft.Maui.Graphics, theme-aware.</Description>
		<PackageTags>$(PackageTags);charts;line;time-series;ring;gauge;bar;columns;dashboard;history;scroll;controls</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Plugin.Maui.Spine\Plugin.Maui.Spine.csproj" />
	</ItemGroup>

	<!-- The line chart's words (where the clock changes), overridable by the app. -->
	<ItemGroup>
		<EmbeddedResource Include="Resources\Strings\*.xml" WithCulture="false" />
	</ItemGroup>

</Project>
