<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>$(SpineMauiTargetFrameworks)</TargetFrameworks>
		<AssemblyName>Plugin.Maui.Spine.Biometrics.Core</AssemblyName>
		<RootNamespace>Plugin.Maui.Spine.Biometrics</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<!-- KeyguardManager.IsDeviceSecure, which tells whether a screen lock is set, is Android 6.0. -->
	<PropertyGroup>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<PropertyGroup>
		<Description>The platform's biometric prompt for .NET MAUI, without Spine's core: IBiometricAuth asks for Face ID, Touch ID or Optic ID, Android's fingerprint or face, or Windows Hello, with the device passcode to fall back on.</Description>
		<SpineIcon>biometrics.png</SpineIcon>
		<PackageTags>$(PackageTags);biometrics;faceid;touchid;fingerprint;windowshello</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<PackageReference Include="Xamarin.AndroidX.Biometric" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Plugin.Maui.Spine.Common\Plugin.Maui.Spine.Common.csproj" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\Strings\*.xml" WithCulture="false" />
	</ItemGroup>

	<!-- The module declaration and the Face ID usage check; a ProjectReference consumer imports
	     build\Plugin.Maui.Spine.Biometrics.Core.targets explicitly. -->
	<ItemGroup>
		<None Include="build\**" Pack="true" PackagePath="build\;buildTransitive\" />
	</ItemGroup>

</Project>
