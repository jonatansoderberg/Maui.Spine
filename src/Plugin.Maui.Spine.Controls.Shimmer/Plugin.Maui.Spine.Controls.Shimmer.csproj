<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>$(SpineMauiTargetFrameworks)</TargetFrameworks>

		<AssemblyName>Plugin.Maui.Spine.Controls.Shimmer</AssemblyName>
		<RootNamespace>Plugin.Maui.Spine.Controls</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<NoWarn>$(NoWarn);CS1591</NoWarn>

	</PropertyGroup>

	<PropertyGroup>
		<Description>Skeleton loading for .NET MAUI: a Shimmer control whose wave sweeps across placeholder blocks, and Skeleton.IsActive, which turns a real layout into its own skeleton while its data loads. Theme-aware, honours Reduce Motion.</Description>
		<SpineIcon>shimmer.png</SpineIcon>
		<PackageTags>$(PackageTags);shimmer;skeleton;loading;placeholder;controls</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Plugin.Maui.Spine\Plugin.Maui.Spine.csproj" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\Strings\*.xml" WithCulture="false" />
	</ItemGroup>

</Project>
