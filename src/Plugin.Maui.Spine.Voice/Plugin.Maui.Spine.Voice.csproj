<Project Sdk="Microsoft.NET.Sdk">

	<!--
		net10.0 carries only the platform-neutral core (the meter, the playback queue, the resampler and the shared
		engine), so it is tested without a device; the MAUI TFMs add the platform engines and UseSpineVoice.
	-->
	<PropertyGroup>
		<TargetFrameworks>net10.0;$(SpineMauiTargetFrameworks)</TargetFrameworks>

		<AssemblyName>Plugin.Maui.Spine.Voice</AssemblyName>
		<RootNamespace>Plugin.Maui.Spine.Voice</RootNamespace>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)' != 'net10.0'">
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
	</PropertyGroup>

	<PropertyGroup>
		<Description>Voice for Spine apps: a full-duplex audio engine with the platform's echo cancellation, PCM16 in and out at a provider's rate, a playback queue that can be flushed when the user talks over the answer, and levels and 24 bands each way for visuals. The base for realtime voice AI.</Description>
		<SpineIcon>ai.png</SpineIcon>
		<PackageTags>$(PackageTags);voice;audio;echo-cancellation;realtime;microphone</PackageTags>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
		<PackageReference Include="Microsoft.Maui.Controls" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Plugin.Maui.Spine.Common\Plugin.Maui.Spine.Common.csproj" />
		<ProjectReference Include="..\Plugin.Maui.Spine.Speech\Plugin.Maui.Spine.Speech.csproj" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<Compile Remove="**\*.cs" />
		<Compile Include="Core\**\*.cs" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Plugin.Maui.Spine.Voice.Tests" />
		<!-- The avatar's voice driver reads a session's engine (VoiceSession.Audio) for the playback clock. -->
		<InternalsVisibleTo Include="Plugin.Maui.Spine.Controls.Avatar" />
		<InternalsVisibleTo Include="Plugin.Maui.Spine.Controls.Avatar.Core.Tests" />
	</ItemGroup>

	<!-- Declares the package to UseSpine(), and contributes the entitlement and the opt-in background mode. -->
	<ItemGroup>
		<None Include="build\**" Pack="true" PackagePath="build\;buildTransitive\" />
	</ItemGroup>

</Project>
