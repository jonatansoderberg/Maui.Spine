<Project>

	<PropertyGroup>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>preview</LangVersion>
	</PropertyGroup>

	<!--
		The TFM set every MAUI project in the repo targets. A project opts in with
		<TargetFrameworks>$(SpineMauiTargetFrameworks)</TargetFrameworks>; it cannot be assigned
		here, because this file is imported before the project body and a net10.0-only project
		would then carry both TargetFramework and TargetFrameworks.
	-->
	<PropertyGroup>
		<SpineMauiTargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</SpineMauiTargetFrameworks>
		<SpineMauiTargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(SpineMauiTargetFrameworks);net10.0-windows10.0.19041.0</SpineMauiTargetFrameworks>
	</PropertyGroup>

	<!-- Platform minimums. The conditions match nothing for a plain net10.0 project. -->
	<PropertyGroup>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

</Project>
