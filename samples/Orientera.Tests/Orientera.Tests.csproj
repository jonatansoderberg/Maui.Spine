<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>preview</LangVersion>
		<IsPackable>false</IsPackable>
		<RootNamespace>Orientera.Tests</RootNamespace>
	</PropertyGroup>

	<!--
		The domain and the source contracts are their own assembly since M1. The engines still
		live in the app project; they are MAUI-free by construction, so the tests compile those
		sources directly rather than referencing the multi-targeted app.
	-->
	<ItemGroup>
		<ProjectReference Include="..\Orientera.Domain\Orientera.Domain.csproj" />
		<ProjectReference Include="..\Orientera.Backend\Orientera.Backend.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\Orientera\Presentation\Format.cs" LinkBase="Linked\Presentation" />
		<Compile Include="..\Orientera\Presentation\DisciplineGlyph.cs" LinkBase="Linked\Presentation" />
		<Compile Include="..\Orientera\Presentation\ClassOrder.cs" LinkBase="Linked\Presentation" />
		<Compile Include="..\Orientera\Services\Analysis\**\*.cs" LinkBase="Linked\Services\Analysis" />
		<Compile Include="..\Orientera\Services\Context\ContextEngine.cs" LinkBase="Linked\Services\Context" />
		<Compile Include="..\Orientera\Services\Context\ParticipantModeEngine.cs" LinkBase="Linked\Services\Context" />
		<Compile Include="..\Orientera\Services\FakeData\**\*.cs" LinkBase="Linked\Services\FakeData" />
		<Compile Include="..\Orientera\Services\Notifications\**\*.cs" LinkBase="Linked\Services\Notifications" />
		<Compile Include="..\Orientera\Services\Offline\**\*.cs" LinkBase="Linked\Services\Offline" />
		<Compile Include="..\Orientera\Services\Travel\**\*.cs" LinkBase="Linked\Services\Travel" />
		<Compile Include="..\Orientera\Services\Grouping\**\*.cs" LinkBase="Linked\Services\Grouping" />
		<!-- The filter is plain rules over the domain, so it is tested without the UI around it. -->
		<Compile Include="..\Orientera\Features\Events\EventFilter.cs" LinkBase="Linked\Features\Events" />
		<Compile Include="..\Orientera\Services\Relevance\**\*.cs" LinkBase="Linked\Services\Relevance" />
		<Compile Include="..\Orientera\Services\Local\**\*.cs" LinkBase="Linked\Services\Local" />
		<!--
			The Eventor reading is HttpClient and the domain's parsers, so it compiles here too.
			Its platform half — the web view's cookie store and SecureStorage — is in
			EventorPlatform.cs and is left out.
		-->
		<Compile Include="..\Orientera\Services\Eventor\EventorWebSession.cs" LinkBase="Linked\Services\Eventor" />
		<Compile Include="..\Orientera\Services\Eventor\EventorReader.cs" LinkBase="Linked\Services\Eventor" />
		<Compile Include="..\Orientera\Services\Eventor\EventorLoginForm.cs" LinkBase="Linked\Services\Eventor" />
		<Compile Include="..\Orientera\Services\Sources\**\*.cs" LinkBase="Linked\Services\Sources" />
		<Compile Include="..\Orientera\Services\Time\**\*.cs" LinkBase="Linked\Services\Time" />
	</ItemGroup>

	<ItemGroup>
		<!-- Eventor responses in the documented XML shape; see Fixtures/Eventor/README.md -->
		<None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
		<PackageReference Include="xunit" Version="2.9.3" />
		<PackageReference Include="xunit.runner.visualstudio" Version="3.1.1" />
	</ItemGroup>

</Project>
