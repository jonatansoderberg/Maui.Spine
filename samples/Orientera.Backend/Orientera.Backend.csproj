<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<AzureFunctionsVersion>v4</AzureFunctionsVersion>
		<OutputType>Exe</OutputType>
		<RootNamespace>Orientera.Backend</RootNamespace>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<!-- The start-list reader is tested against a saved response; it is not API surface. -->
		<InternalsVisibleTo Include="Orientera.Tests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Anthropic" />
		<PackageReference Include="Azure.Data.Tables" />
		<PackageReference Include="Azure.Storage.Blobs" />
		<PackageReference Include="BitMiracle.LibTiff.NET" />
		<PackageReference Include="ProjNET" />
		<!--
			SkiaSharp och inte ImageSharp: från och med v4 kräver Six Labors licensnyckel vid
			bygge och Release-bygget stoppar utan den. Skia är MIT. Linux-paketet är för
			Function-appen i molnet — utan det saknar Linux-värden den nativa binären.
		-->
		<PackageReference Include="SkiaSharp" VersionOverride="4.151.1" />
		<PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
		<PackageReference Include="Azure.Storage.Queues" />
		<PackageReference Include="Microsoft.Azure.Functions.Worker" />
		<PackageReference Include="Microsoft.Azure.Functions.Worker.Sdk" />
		<PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" />
		<PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Storage.Queues" />
		<PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Timer" />
		<PackageReference Include="Microsoft.Extensions.Caching.Memory" />
		<PackageReference Include="OpenAI" />
		<PackageReference Include="Microsoft.Extensions.Http" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Orientera.Domain\Orientera.Domain.csproj" />
		<ProjectReference Include="..\..\src\Plugin.Maui.Spine.Common\Plugin.Maui.Spine.Common.csproj" />
		<ProjectReference Include="..\..\src\Plugin.Maui.Spine.Server\Plugin.Maui.Spine.Server.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Vimpeln är en förvaltad bildfil, genererad av prototypens flag_tile. Se Flag.cs. -->
		<EmbeddedResource Include="Arena\Assets\vimpel.png" />
	</ItemGroup>

	<ItemGroup>
		<None Update="host.json" CopyToOutputDirectory="PreserveNewest" />
		<None Update="local.settings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
	</ItemGroup>

</Project>
