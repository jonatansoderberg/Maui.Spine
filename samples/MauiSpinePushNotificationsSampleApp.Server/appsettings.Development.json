{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "//": [
    "Real values belong in user secrets, not here:",
    "  dotnet user-secrets set \"Push:Apple:PrivateKey\" \"$(cat AuthKey_XXXXXXXXXX.p8)\"",
    "",
    "Apple  — developer.apple.com, Certificates Identifiers & Profiles.",
    "  TeamId     Membership.",
    "  KeyId      the APNs key's page; the .p8 can only be downloaded once.",
    "  PrivateKey the whole contents of the .p8 file.",
    "  BundleId   the app's identifier, with Push Notifications ticked.",
    "",
    "Fcm    — console.firebase.google.com, Project settings, Service accounts,",
    "  Generate new private key. ServiceAccount is the whole JSON file's contents.",
    "",
    "Leave a section empty and the server simply starts without that platform."
  ],

  "Push": {
    "Apple": {
      "TeamId": "",
      "KeyId": "",
      "PrivateKey": "",
      "BundleId": "com.companyname.mauispinepushsampleapp"
    },
    "Fcm": {
      "ServiceAccount": ""
    }
  },
  "Ai": {
    "//": [
      "Spine.Server.AI. The demo provider needs no key, so Assistant and Summary run as they are.",
      "Story and Picture run once their provider's key is in user secrets:",
      "  dotnet user-secrets set \"Ai:Providers:anthropic:ApiKey\" \"sk-ant-...\"",
      "  dotnet user-secrets set \"Ai:Providers:openai:ApiKey\" \"sk-...\"",
      "Voice (a realtime voice session, POST /ai/realtime/Voice) uses the same OpenAI key. It answers any caller because",
      "the sample has no sign-in; a real server leaves Callers unset, which means signed-in users only.",
      "An empty ApiKey here turns the feature off, and the startup log says so.",
      "Read (POST /ai/speech/Read) reads text aloud with the demo voice: a hum with a viseme per letter, no key needed.",
      "ReadAzure uses Azure Speech, with real visemes, once its key is set: dotnet user-secrets set \"Ai:Providers:azure:ApiKey\" \"...\"",
      "The prices are example figures; take real ones from the provider's price list."
    ],
    "Providers": {
      "anthropic": { "ApiKey": "" },
      "openai": { "ApiKey": "" },
      "azure": { "Region": "swedencentral", "ApiKey": "" }
    },
    "Features": {
      "Assistant": {
        "Provider": "demo", "Model": "demo-1", "Expose": true,
        "SystemPrompt": "Du är en hjälpsam assistent i Spines provapp. Svara kort. Användarens bokningar och klockan får du med funktionerna.",
        "Functions": [ "get_my_bookings", "show_time" ],
        "MaxInputTokens": 2000, "MaxTurns": 10,
        "RequestsPerMinute": { "SignedIn": 30, "Installation": 15 },
        "Budget": { "DaySoft": 0.5, "DayHard": 1, "PerCaller": { "Installation": { "DayCalls": 100 } } }
      },
      "Summary": { "Provider": "demo", "Model": "demo-1", "MaxOutputTokens": 200 },
      "Story": {
        "Provider": "anthropic", "Model": "claude-haiku-5-5", "MaxOutputTokens": 300,
        "Budget": { "DayHard": 0.5 }
      },
      "Quick": {
        "Provider": "openai", "Model": "gpt-5.4-nano", "MaxOutputTokens": 300, "Reasoning": "Low",
        "Budget": { "DayHard": 0.5 }
      },
      "Picture": {
        "Kind": "Image", "Provider": "openai", "Model": "gpt-image-1-mini",
        "Image": { "Size": "1024x1024", "Count": 1 },
        "Budget": { "DayHard": 0.5 }
      },
      "Voice": {
        "Kind": "Realtime", "Provider": "openai", "Model": "gpt-realtime-2.1-mini", "Expose": true, "Callers": "Any",
        "SystemPrompt": "Du är en vänlig röstassistent i Spines provapp. Svara kort, på svenska. Användarens bokningar och klockan får du med funktionerna.",
        "Functions": [ "get_my_bookings", "show_time" ],
        "Realtime": { "Voice": "marin", "Voices": ["marin", "cedar", "coral", "sage", "shimmer", "alloy", "ash", "ballad", "echo", "verse"], "TurnDetection": "semantic_vad", "NoiseReduction": "near_field",
                      "TranscriptionModel": "gpt-4o-mini-transcribe", "Language": "sv", "Reasoning": "low", "MaxMinutes": 3 },
        "RequestsPerMinute": { "Installation": 6 },
        "Budget": { "DayHard": 1.5, "PerCaller": { "Installation": { "DayCalls": 10 } } }
      },
      "VoiceFull": {
        "Kind": "Realtime", "Provider": "openai", "Model": "gpt-realtime-2.1", "Expose": true, "Callers": "Any",
        "SystemPrompt": "Du är en vänlig röstassistent i Spines provapp. Svara kort, på svenska. Användarens bokningar och klockan får du med funktionerna.",
        "Functions": [ "get_my_bookings", "show_time" ],
        "Realtime": { "Voice": "marin", "Voices": ["marin", "cedar", "coral", "sage", "shimmer", "alloy", "ash", "ballad", "echo", "verse"], "TurnDetection": "semantic_vad", "NoiseReduction": "near_field",
                      "TranscriptionModel": "gpt-4o-mini-transcribe", "Language": "sv", "Reasoning": "low", "MaxMinutes": 3 },
        "RequestsPerMinute": { "Installation": 6 },
        "Budget": { "DayHard": 1.5, "PerCaller": { "Installation": { "DayCalls": 10 } } }
      },
      "VoiceLive": {
        "Kind": "Realtime", "Provider": "openai", "Model": "gpt-live-1", "Expose": true, "Callers": "Any",
        "SystemPrompt": "Du är en vänlig röstassistent i Spines provapp. Prata kort och naturligt, på svenska. Lämna över till backend när användaren frågar om sina bokningar eller vad klockan är, och när hen säger hej då.",
        "Functions": [ "get_my_bookings", "show_time" ],
        "Realtime": { "Protocol": "Live", "Voice": "marin", "Voices": ["marin", "cedar", "gleam", "meridian", "willow", "vesper"], "MaxMinutes": 3,
                      "Backend": { "Model": "gpt-6-luna", "Reasoning": "low",
                                   "Instructions": "Du hjälper röstassistenten i Spines provapp. Svara kort och sakligt på svenska, så att svaret går att säga högt. Använd funktionerna för användarens bokningar och klockan." } },
        "RequestsPerMinute": { "Installation": 6 },
        "Budget": { "DayHard": 1.5, "PerCaller": { "Installation": { "DayCalls": 10 } } }
      },
      "Read": {
        "Kind": "Speech", "Provider": "demo", "Model": "demo-tts", "Expose": true,
        "Speech": { "MaxCharacters": 1000 },
        "RequestsPerMinute": { "Installation": 20 }
      },
      "ReadAzure": {
        "Kind": "Speech", "Provider": "azure", "Model": "neural", "Expose": true,
        "Speech": { "Voice": "sv-SE-SofieNeural", "MaxCharacters": 1000 },
        "RequestsPerMinute": { "Installation": 10 },
        "Budget": { "DayHard": 0.5 }
      },
      "Claude": {
        "Provider": "anthropic", "Model": "claude-haiku-5-5", "Expose": true, "Callers": "Any", "MaxOutputTokens": 300, "MaxInputTokens": 4000, "MaxTurns": 20,
        "SystemPrompt": "Du är en vänlig röstassistent i Spines provapp. Det du skriver läses upp: svara kort, på svenska, i hela meningar utan listor, rubriker eller markdown. Användarens bokningar och klockan får du med funktionerna.",
        "Functions": [ "get_my_bookings", "show_time" ],
        "RequestsPerMinute": { "SignedIn": 20, "Installation": 15 },
        "Budget": { "DayHard": 0.5, "PerCaller": { "Installation": { "DayCalls": 60 } } }
      },
      "Transcribe": {
        "Kind": "Transcription", "Provider": "openai", "Model": "gpt-4o-mini-transcribe", "Expose": true, "Callers": "Any",
        "Transcription": { "Language": "sv-SE", "MaxSeconds": 30 },
        "RequestsPerMinute": { "SignedIn": 30, "Installation": 20 },
        "Budget": { "DayHard": 0.3, "PerCaller": { "Installation": { "DayCalls": 200 } } }
      },
      "ReadOpenAI": {
        "Kind": "Speech", "Provider": "openai", "Model": "gpt-4o-mini-tts", "Expose": true, "Callers": "Any",
        "Speech": { "Voice": "marin", "Instructions": "Tala lugnt och vänligt, på svenska.", "MaxCharacters": 600 },
        "RequestsPerMinute": { "SignedIn": 60, "Installation": 40 },
        "Budget": { "DayHard": 0.5, "PerCaller": { "Installation": { "DayCalls": 400 } } }
      }
    },
    "Prices": {
      "demo": { "demo-1": { "InputPerMillion": 1, "OutputPerMillion": 4 }, "demo-tts": { "PerMillionCharacters": 16 } },
      "azure": { "neural": { "PerMillionCharacters": 16 } },
      "anthropic": { "claude-haiku-5-5": { "InputPerMillion": 1, "CachedInputPerMillion": 0.1, "OutputPerMillion": 5 } },
      "openai": {
        "gpt-5.4-nano": { "InputPerMillion": 0.05, "CachedInputPerMillion": 0.005, "OutputPerMillion": 0.4 },
        "gpt-image-1-mini": { "InputPerMillion": 2, "OutputPerMillion": 8 },
        "gpt-realtime-2.1": { "PerMinute": 0.2 },
        "gpt-realtime-2.1-mini": { "PerMinute": 0.05 },
        "gpt-live-1": { "PerMinute": 0.05 },
        "gpt-6-luna": { "InputPerMillion": 0.1, "CachedInputPerMillion": 0.01, "OutputPerMillion": 0.5 },
        "gpt-4o-mini-transcribe": { "PerMinute": 0.003 },
        "gpt-4o-mini-tts": { "PerMillionCharacters": 15 }
      }
    },
    "Currency": "USD",
    "Budget": { "DayHard": 2 },
    "TimeZone": "Europe/Stockholm"
  }
}
