        "gpt-image-1-mini": {
          "InputPerMillion": 2,
          "OutputPerMillion": 8
        },
        "gpt-realtime": {
          "PerMinute": 0.2
        }
      }
    },
    "Currency": "USD",
    "Budget": {
      "DayHard": 2
    },
    "TimeZone": "Europe/Stockholm"
  }
