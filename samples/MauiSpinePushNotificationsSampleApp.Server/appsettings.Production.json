{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Sample": {
    "Hosted": true
  },
  "Auth": {
    "Passkeys": {
      "RelyingPartyId": "spine-showcase-e41ddd.azurewebsites.net"
    }
  },
  "Ai": {
    "//": [
      "Spine.Server.AI in Azure (README.md): the same features as on the Mac. OpenAI (Quick, Picture, Voice) answers any installation of the app within its per-installation limits and the daily caps; Story (Anthropic) answers signed-in users only.",
      "The providers' keys are app settings (Ai__Providers__openai__ApiKey, Ai__Providers__anthropic__ApiKey), never this file."
    ],
    "Providers": {
      "anthropic": {
        "ApiKey": ""
      },
      "openai": {
        "ApiKey": ""
      }
    },
    "Features": {
      "Assistant": {
        "Provider": "demo",
        "Model": "demo-1",
        "Expose": true,
        "SystemPrompt": "Du är en hjälpsam assistent i Spines provapp. Svara kort.",
        "MaxInputTokens": 2000,
        "MaxTurns": 10,
        "RequestsPerMinute": {
          "SignedIn": 20,
          "Installation": 6
        },
        "Budget": {
          "DaySoft": 0.5,
          "DayHard": 1,
          "PerCaller": {
            "Installation": {
              "DayCalls": 50
            }
          }
        }
      },
      "Summary": {
        "Provider": "demo",
        "Model": "demo-1",
        "MaxOutputTokens": 200
      },
      "Story": {
        "Provider": "anthropic",
        "Model": "claude-haiku-5-5",
        "MaxOutputTokens": 300,
        "Budget": {
          "DayHard": 0.5
        },
        "Callers": "SignedIn"
      },
      "Quick": {
        "Provider": "openai",
        "Model": "gpt-5.4-nano",
        "MaxOutputTokens": 300,
        "Reasoning": "Low",
        "Budget": {
          "DayHard": 0.5,
          "PerCaller": {
            "Installation": {
              "DayCalls": 30
            }
          }
        },
        "Callers": "Any",
        "RequestsPerMinute": {
          "SignedIn": 10,
          "Installation": 5
        }
      },
      "Picture": {
        "Kind": "Image",
        "Provider": "openai",
        "Model": "gpt-image-1-mini",
        "Image": {
          "Size": "1024x1024",
          "Count": 1
        },
        "Budget": {
          "DayHard": 0.5,
          "PerCaller": {
            "Installation": {
              "DayCalls": 5
            }
          }
        },
        "Callers": "Any",
        "RequestsPerMinute": {
          "SignedIn": 4,
          "Installation": 2
        }
      },
      "Voice": {
        "Kind": "Realtime",
        "Provider": "openai",
        "Model": "gpt-realtime",
        "Expose": true,
        "Callers": "Any",
        "SystemPrompt": "Du är en vänlig röstassistent i Spines provapp. Svara kort, på svenska.",
        "Realtime": {
          "Voice": "marin",
          "TurnDetection": "semantic_vad",
          "NoiseReduction": "near_field",
          "TranscriptionModel": "gpt-4o-mini-transcribe",
          "Language": "sv",
          "MaxMinutes": 3
        },
        "RequestsPerMinute": {
          "Installation": 3
        },
        "Budget": {
          "DayHard": 1.5,
          "PerCaller": {
            "Installation": {
              "DayCalls": 10
            }
          }
        }
      },
      "Read": {
        "Kind": "Speech",
        "Provider": "demo",
        "Model": "demo-tts",
        "Expose": true,
        "Speech": {
          "MaxCharacters": 1000
        },
        "RequestsPerMinute": {
          "SignedIn": 20,
          "Installation": 20
        }
      }
    },
    "Prices": {
      "demo": {
        "demo-1": {
          "InputPerMillion": 1,
          "OutputPerMillion": 4
        },
        "demo-tts": {
          "PerMillionCharacters": 16
        }
      },
      "anthropic": {
        "claude-haiku-5-5": {
          "InputPerMillion": 1,
