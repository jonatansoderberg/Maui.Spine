<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>MauiSpinePushNotificationsSampleApp.Server</RootNamespace>
		<IsPackable>false</IsPackable>
		<UserSecretsId>maui-spine-push-sample-server</UserSecretsId>
		<!-- IImageGenerator is experimental in Microsoft.Extensions.AI. -->
		<NoWarn>$(NoWarn);MEAI001</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\Plugin.Maui.Spine.Server\Plugin.Maui.Spine.Server.csproj" />
		<ProjectReference Include="..\..\src\Plugin.Maui.Spine.Server.AI\Plugin.Maui.Spine.Server.AI.csproj" />
		<ProjectReference Include="..\..\src\Plugin.Maui.Spine.Server.Authentication\Plugin.Maui.Spine.Server.Authentication.csproj" />
		<ProjectReference Include="..\MauiSpineSampleApp.Shared\MauiSpineSampleApp.Shared.csproj" />
	</ItemGroup>

	<!-- The AI providers, one line each in Program.cs. Spine.Server.AI itself references no vendor. -->
	<ItemGroup>
		<PackageReference Include="Anthropic" />
		<PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
	</ItemGroup>

	<!-- Kairo for the Showcase's Avatars page (GET /sample/avatars/kairo.spineavatar): too large to bundle, downloaded and cached by the app. -->
	<ItemGroup>
		<None Include="..\Avatars\kairo.spineavatar" Link="avatars\kairo.spineavatar" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
