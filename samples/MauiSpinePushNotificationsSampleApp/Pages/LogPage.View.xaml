<SpinePage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:services="clr-namespace:MauiSpinePushNotificationsSampleApp.Services"
    x:Class="MauiSpinePushNotificationsSampleApp.Pages.LogPage"
    x:TypeArguments="LogPageViewModel"
    x:DataType="LogPageViewModel">

    <Grid RowDefinitions="Auto,*">

        <Button Grid.Row="0" Text="Clear" Command="{Binding ClearCommand}" Margin="16,8" />

        <!-- The list reaches the page's sides, so the header bar's scroll edge covers the bar;
             SafeArea.PageMargin lays the rows out inside the page margin. -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding Entries}" Margin="0,0,0,16" SafeArea.PageMargin="True">
            <CollectionView.EmptyView>
                <Label Text="Nothing has arrived yet. Send something from the Send page, or run xcrun simctl push."
                       TextColor="Gray" FontSize="12" Margin="{x:Static HeaderBarConstants.PagePadding}" Padding="0,20" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="services:PushLogEntry">
                    <VerticalStackLayout Padding="0,6">
                        <Label Text="{Binding Summary}" FontAttributes="Bold" FontSize="13" />
                        <Label Text="{Binding Detail}" FontSize="11" TextColor="Gray" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</SpinePage>
