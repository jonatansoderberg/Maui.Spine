<SpinePage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiSpinePushNotificationsSampleApp.Pages.LocalPage"
    x:TypeArguments="LocalPageViewModel"
    x:DataType="LocalPageViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">

            <Label Text="Notifications the device shows by itself, with no server. The plan is the whole truth: whatever is not in it is cancelled."
                   FontSize="12" TextColor="Gray" />

            <Label Text="This platform schedules no notifications."
                   IsVisible="{Binding IsUnsupported}" TextColor="Gray" />

            <Grid ColumnDefinitions="110,*">
                <Label Grid.Column="0" Text="Planned" />
                <Label Grid.Column="1" Text="{Binding Summary}" />
            </Grid>

            <!-- BindableLayout rather than a CollectionView: inside a ScrollView a CollectionView has
                 no height of its own and takes the whole page, which pushes the buttons out of sight. -->
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Planned}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="{x:Type x:String}">
                        <Label Text="{Binding .}" FontSize="12" Padding="0,2" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Button Text="Plan three" Command="{Binding ScheduleThreeCommand}" />
            <Button Text="Plan just one" Command="{Binding ScheduleOneCommand}" />
            <Button Text="Plan with buttons and a picture" Command="{Binding ScheduleRichCommand}" />
            <Button Text="Cancel all" Command="{Binding CancelAllCommand}" />
            <Button Text="Reread the plan" Command="{Binding RefreshCommand}" />

        </VerticalStackLayout>
    </ScrollView>

</SpinePage>
