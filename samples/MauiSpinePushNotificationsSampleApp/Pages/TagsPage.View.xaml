<SpinePage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiSpinePushNotificationsSampleApp.Pages.TagsPage"
    x:TypeArguments="TagsPageViewModel"
    x:DataType="TagsPageViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="8">

            <Label Text="What this installation subscribes to. The server matches them with a tag expression."
                   FontSize="12" TextColor="Gray" />

            <SpineRow Title="kind:news">
                <SpineRow.Accessory>
                    <Switch IsToggled="{Binding News}" />
                </SpineRow.Accessory>
            </SpineRow>
            <SpineRow Title="kind:alerts">
                <SpineRow.Accessory>
                    <Switch IsToggled="{Binding Alerts}" />
                </SpineRow.Accessory>
            </SpineRow>
            <SpineRow Title="team:red">
                <SpineRow.Accessory>
                    <Switch IsToggled="{Binding TeamRed}" />
                </SpineRow.Accessory>
            </SpineRow>
            <SpineRow Title="team:blue">
                <SpineRow.Accessory>
                    <Switch IsToggled="{Binding TeamBlue}" />
                </SpineRow.Accessory>
            </SpineRow>

            <Label Text="Own tags, one per line" Margin="0,8,0,0" />
            <Editor Text="{Binding Extra}" HeightRequest="90" AutoSize="Disabled" />

            <Label Text="{Binding Result}" IsVisible="{Binding HasResult}" FontSize="12" TextColor="Gray" />

        </VerticalStackLayout>
    </ScrollView>

</SpinePage>
