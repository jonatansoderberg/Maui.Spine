<SpinePage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiSpinePushNotificationsSampleApp.Pages.LiveActivityPage"
    x:TypeArguments="LiveActivityPageViewModel"
    x:DataType="LiveActivityPageViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">

            <Label Text="Start an activity locally, then let the server update it. The push token is what makes that possible while the app is closed."
                   FontSize="12" TextColor="Gray" />

            <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto" RowSpacing="4">
                <Label Grid.Row="0" Grid.Column="0" Text="Permission" />
                <Label Grid.Row="0" Grid.Column="1" Text="{Binding State}" />

                <Label Grid.Row="1" Grid.Column="0" Text="Address" />
                <Label Grid.Row="1" Grid.Column="1" Text="{Binding PushToken}" LineBreakMode="MiddleTruncation" />
            </Grid>

            <Button Text="Start" Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}" />
            <Button Text="Update locally" Command="{Binding UpdateLocallyCommand}" />
            <Button Text="System background" Command="{Binding UpdateWithSystemBackgroundCommand}" />
            <Button Text="Update from the server" Command="{Binding UpdateFromServerCommand}" />
            <Button Text="End" Command="{Binding EndCommand}" />

            <Label Text="Or on the server's broadcast channel: one push to the channel reaches every activity following it, with no token per device. iOS 18 follows the APNs channel, Android the channel's FCM topic."
                   FontSize="12" TextColor="Gray" Margin="0,12,0,0" />

            <Button Text="Start on channel" Command="{Binding StartOnChannelCommand}" IsEnabled="{Binding CanStart}" />
            <Button Text="Broadcast from the server" Command="{Binding BroadcastFromServerCommand}" />

        </VerticalStackLayout>
    </ScrollView>

</SpinePage>
