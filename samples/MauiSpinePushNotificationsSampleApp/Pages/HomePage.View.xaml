<SpinePage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiSpinePushNotificationsSampleApp.Pages.HomePage"
    x:TypeArguments="HomePageViewModel"
    x:DataType="HomePageViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label Text="This installation" FontAttributes="Bold" />

            <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                <Label Grid.Row="0" Grid.Column="0" Text="Status" />
                <Label Grid.Row="0" Grid.Column="1" Text="{Binding Status}" />

                <Label Grid.Row="1" Grid.Column="0" Text="Installation" />
                <Label Grid.Row="1" Grid.Column="1" Text="{Binding InstallationId}" LineBreakMode="MiddleTruncation" />

                <Label Grid.Row="2" Grid.Column="0" Text="Token" />
                <Label Grid.Row="2" Grid.Column="1" Text="{Binding Token}" LineBreakMode="MiddleTruncation">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CopyTokenCommand}" />
                    </Label.GestureRecognizers>
                </Label>

                <Label Grid.Row="3" Grid.Column="0" Text="Registered" />
                <Label Grid.Row="3" Grid.Column="1" Text="{Binding Registered}" />

                <Label Grid.Row="4" Grid.Column="0" Text="Tags" />
                <Label Grid.Row="4" Grid.Column="1" Text="{Binding Tags}" />
            </Grid>

            <Label Text="{Binding Hint}" IsVisible="{Binding HasHint}"
                   TextColor="Gray" FontSize="12" />

            <Label Text="Push is not available on this platform. Everything below can be tapped, but answers Unsupported."
                   IsVisible="{Binding IsUnsupported}"
                   TextColor="Gray" FontSize="12" />

            <Button Text="Ask for permission" Command="{Binding RequestPermissionCommand}" />
            <Button Text="Register again" Command="{Binding RegisterCommand}" />
            <Button Text="Unregister" Command="{Binding UnregisterCommand}" />
            <Button Text="Open settings" Command="{Binding OpenSettingsCommand}" />

            <BoxView HeightRequest="1" Color="LightGray" Margin="0,8" />

            <Button Text="Tags" Command="{Binding ShowTagsCommand}" />
            <Button Text="Send" Command="{Binding ShowSendCommand}" />
            <Button Text="Log" Command="{Binding ShowLogCommand}" />
            <Button Text="Live Activity" Command="{Binding ShowLiveActivityCommand}" />
            <Button Text="Local" Command="{Binding ShowLocalCommand}" />

        </VerticalStackLayout>
    </ScrollView>

</SpinePage>
