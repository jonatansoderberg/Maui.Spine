<SpinePage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiSpinePushNotificationsSampleApp.Pages.SendPage"
    x:TypeArguments="SendPageViewModel"
    x:DataType="SendPageViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">

            <Label Text="Asks the sample server to send. Run it with dotnet run in MauiSpinePushNotificationsSampleApp.Server."
                   FontSize="12" TextColor="Gray" />

            <Label Text="A push that arrives while the app is in the foreground is not shown — this sample's handler answers None and only writes a line in Log. Turn on the delay below and put the app in the background to see a real notification."
                   FontSize="12" TextColor="Gray" />

            <Label Text="Kind" />
            <Picker ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" />
            <Label Text="{Binding Explanation}" FontSize="12" TextColor="Gray" />

            <SpineRow Title="Only to this device">
                <SpineRow.Accessory>
                    <Switch IsToggled="{Binding ToMe}" />
                </SpineRow.Accessory>
            </SpineRow>

            <Label Text="Tag expression" />
            <Entry Text="{Binding TagExpression}" IsEnabled="{Binding ToTags}" />

            <Label Text="Title" IsVisible="{Binding ShowText}" />
            <Entry Text="{Binding NotificationTitle}" IsVisible="{Binding ShowText}" />

            <Label Text="Text" IsVisible="{Binding ShowText}" />
            <Entry Text="{Binding Body}" IsVisible="{Binding ShowText}" />

            <Label Text="Route" IsVisible="{Binding ShowRoute}" />
            <Entry Text="{Binding Route}" IsVisible="{Binding ShowRoute}" />

            <Label Text="Channel" IsVisible="{Binding ShowChannel}" />
            <Entry Text="{Binding Channel}" IsVisible="{Binding ShowChannel}" />

            <Label Text="Buttons (category)" IsVisible="{Binding ShowChannel}" />
            <Entry Text="{Binding Category}" Placeholder="sample" IsVisible="{Binding ShowChannel}" />

            <Label Text="Picture" IsVisible="{Binding ShowChannel}" />
            <Entry Text="{Binding Image}" Placeholder="https://…" Keyboard="Url" IsVisible="{Binding ShowChannel}" />

            <SpineRow Title="High priority" IsVisible="{Binding ShowPriority}">
                <SpineRow.Accessory>
                    <Switch IsToggled="{Binding HighPriority}" />
                </SpineRow.Accessory>
            </SpineRow>

            <SpineRow Title="Wait 5 seconds before sending">
                <SpineRow.Accessory>
                    <Switch IsToggled="{Binding Delay}" />
                </SpineRow.Accessory>
            </SpineRow>

            <Button Text="Send" Command="{Binding SendCommand}" Margin="0,8,0,0" />
            <Label Text="{Binding Result}" FontSize="12" />

        </VerticalStackLayout>
    </ScrollView>

</SpinePage>
