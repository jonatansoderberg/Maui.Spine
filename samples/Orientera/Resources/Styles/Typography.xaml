<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        Typography — Inter, phone-first scale from docs/design/designprinciper.md §4.
        Everything numeric (times, placements, splits, points) uses the Numeric families:
        those are Inter with the OpenType `tnum` substitutions folded into cmap, so digits
        are fixed-width and live-updating columns never jump. MAUI exposes no runtime API
        for font features, hence the separate font files.
    -->

    <!-- Font family aliases (registered in MauiProgram) -->
    <x:String x:Key="FontRegular">Inter</x:String>
    <x:String x:Key="FontMedium">InterMedium</x:String>
    <x:String x:Key="FontSemiBold">InterSemiBold</x:String>
    <x:String x:Key="FontBold">InterBold</x:String>
    <x:String x:Key="FontNumeric">InterTabular</x:String>
    <x:String x:Key="FontNumericMedium">InterTabularMedium</x:String>
    <x:String x:Key="FontNumericSemiBold">InterTabularSemiBold</x:String>
    <x:String x:Key="FontNumericBold">InterTabularBold</x:String>

    <!-- Rubrikraden, och ingenting annat. -->
    <x:String x:Key="FontHeader">BrandonGrotesqueBlack</x:String>

    <!-- Scale -->
    <!--
        Ett steg över Display, och bara till hälsningen på Hem. Brandon Grotesque Black sätts på
        sin versalhöjd och läser mindre än Inter vid samma punktstorlek; på 28 blev hälsningen
        mindre än den DisplayLabel den ersatte, trots tyngre skärning.
    -->
    <x:Double x:Key="SizeHero">34</x:Double>
    <x:Double x:Key="SizeDisplay">28</x:Double>
    <x:Double x:Key="SizeH1">22</x:Double>
    <x:Double x:Key="SizeH2">17</x:Double>
    <x:Double x:Key="SizeBody">15</x:Double>
    <x:Double x:Key="SizeCaption">13</x:Double>
    <x:Double x:Key="SizeMicro">11</x:Double>

    <!-- Text styles -->

    <Style x:Key="DisplayLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontSemiBold}" />
        <Setter Property="FontSize" Value="{StaticResource SizeDisplay}" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="LineHeight" Value="1.15" />
    </Style>

    <!-- Big key figures: placement, "14 / 67", points. Delta follows in CaptionLabel. -->
    <Style x:Key="DisplayNumberLabel" TargetType="Label" BasedOn="{StaticResource DisplayLabel}">
        <Setter Property="FontFamily" Value="{StaticResource FontNumericSemiBold}" />
    </Style>

    <!--
        The medal stands in for a podium placement rather than annotating it, so it carries the
        weight the number would have had. Its own size and not a step on the type scale: an emoji
        at a given point size draws larger than a digit at the same one.
    -->
    <Style x:Key="MedalLabel" TargetType="Label">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="LineHeight" Value="1.1" />
    </Style>

    <Style x:Key="Heading1Label" TargetType="Label">
        <Setter Property="SemanticProperties.HeadingLevel" Value="Level1" />
        <Setter Property="FontFamily" Value="{StaticResource FontSemiBold}" />
        <Setter Property="FontSize" Value="{StaticResource SizeH1}" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="LineHeight" Value="1.2" />
    </Style>

    <Style x:Key="Heading2Label" TargetType="Label">
        <Setter Property="SemanticProperties.HeadingLevel" Value="Level2" />
        <Setter Property="FontFamily" Value="{StaticResource FontSemiBold}" />
        <Setter Property="FontSize" Value="{StaticResource SizeH2}" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="LineHeight" Value="1.25" />
    </Style>

    <Style x:Key="BodyLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontRegular}" />
        <Setter Property="FontSize" Value="{StaticResource SizeBody}" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="LineHeight" Value="1.35" />
    </Style>

    <Style x:Key="BodyStrongLabel" TargetType="Label" BasedOn="{StaticResource BodyLabel}">
        <Setter Property="FontFamily" Value="{StaticResource FontMedium}" />
    </Style>

    <!-- Raden som är läsaren själv, i en lista med andra. Aldrig det enda som säger det. -->
    <Style x:Key="BodyAccentLabel" TargetType="Label" BasedOn="{StaticResource BodyStrongLabel}">
        <Setter Property="TextColor" Value="{DynamicResource AccentAction}" />
    </Style>

    <Style x:Key="BodySecondaryLabel" TargetType="Label" BasedOn="{StaticResource BodyLabel}">
        <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
    </Style>

    <Style x:Key="CaptionLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontRegular}" />
        <Setter Property="FontSize" Value="{StaticResource SizeCaption}" />
        <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
        <Setter Property="LineHeight" Value="1.3" />
    </Style>

    <Style x:Key="CaptionStrongLabel" TargetType="Label" BasedOn="{StaticResource CaptionLabel}">
        <Setter Property="FontFamily" Value="{StaticResource FontMedium}" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
    </Style>

    <!-- Numeric variants: tabular figures -->

    <Style x:Key="NumericLabel" TargetType="Label" BasedOn="{StaticResource BodyLabel}">
        <Setter Property="FontFamily" Value="{StaticResource FontNumeric}" />
    </Style>

    <Style x:Key="NumericStrongLabel" TargetType="Label" BasedOn="{StaticResource BodyLabel}">
        <Setter Property="FontFamily" Value="{StaticResource FontNumericMedium}" />
    </Style>

    <Style x:Key="NumericCaptionLabel" TargetType="Label" BasedOn="{StaticResource CaptionLabel}">
        <Setter Property="FontFamily" Value="{StaticResource FontNumeric}" />
    </Style>

    <!-- Based on Heading2 for its size, but a value is not a heading. -->
    <Style x:Key="NumericHeading2Label" TargetType="Label" BasedOn="{StaticResource Heading2Label}">
        <Setter Property="SemanticProperties.HeadingLevel" Value="None" />
        <Setter Property="FontFamily" Value="{StaticResource FontNumericSemiBold}" />
    </Style>

    <!--
        Under the weekday in a list's date column. Smaller than the caption above it, because a
        month that only appears where it changes is a second-order support, not a second label.
    -->
    <Style x:Key="MicroLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontMedium}" />
        <Setter Property="FontSize" Value="{StaticResource SizeMicro}" />
        <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="CharacterSpacing" Value="0.6" />
    </Style>

    <!--
        Sidans och arkets rubrik. Spine slår upp exakt nyckeln "HeaderBarTitle" i appens resurser
        och sätter stilen på rubriketiketten; utan den ritas titeln i MAUI:s standardetikett, vilket
        är varför "Filter" stod i systemets typsnitt över ett ark där allt annat är Inter.

        Versal och i Brandon Grotesque, samma skärning som i Spines eget exempel. Textfärgen står
        inte här: PagePresenter sätter svart eller vitt direkt på etiketten efter plattformens tema,
        eftersom en AppThemeBinding inne i en nyckelstil läser fel värde i Androids ark. En Setter
        här hade aldrig vunnit.
    -->
    <Style x:Key="HeaderBarTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontHeader}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="CharacterSpacing" Value="1.4" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <!--
        Hälsningen på Hem, ovanpå fotot. Rubrikfonten, samma skärning som sidornas och arkens
        rubriker bär (beslut D16) — hälsningen *är* sidans rubrik. Till skillnad från
        HeaderBarTitle inte versal och nästan utan knipning: den stilen är versal för att en
        rubrikrad är en etikett, och en hälsning som skriks i versaler är ingen hälsning.

        TextOnDark, inte TextPrimary: ytan under är ett fotografi med en gradient över, lika mörk
        i båda temana.
    -->
    <Style x:Key="HeroGreetingLabel" TargetType="Label">
        <Setter Property="SemanticProperties.HeadingLevel" Value="Level1" />
        <Setter Property="FontFamily" Value="{StaticResource FontHeader}" />
        <Setter Property="FontSize" Value="{StaticResource SizeHero}" />
        <Setter Property="TextColor" Value="{DynamicResource TextOnDark}" />
        <Setter Property="CharacterSpacing" Value="0.4" />
        <Setter Property="LineHeight" Value="1.05" />
    </Style>

    <!-- Datumet och vädret under hälsningen, på samma foto. -->
    <Style x:Key="HeroMetaLabel" TargetType="Label" BasedOn="{StaticResource BodyLabel}">
        <Setter Property="TextColor" Value="{DynamicResource TextOnDarkMuted}" />
    </Style>

    <!--
        Handlingen till höger om en sektionsrubrik: "Visa kalender", "Se alla". En länk och inte
        en knapp — den byter vy, den utför inget, och en andra knapp bredvid varje rubrik hade
        gjort sidans enda primära CTA till en av åtta (§2.2).
    -->
    <Style x:Key="LinkActionLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontMedium}" />
        <Setter Property="FontSize" Value="{StaticResource SizeCaption}" />
        <Setter Property="TextColor" Value="{DynamicResource AccentAction}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!--
        Nyckeltalen i en StatRow: värdet över, vad det är under. Värdet i H1-storlek snarare än
        Display — tre tal bredvid varandra i Display blir tre rubriker, och raden ska läsas som
        en enhet. Etiketten i gemener och inte MicroLabel: "Placering" är ett ord under ett tal,
        inte en avdelare i en lista.
    -->
    <Style x:Key="StatValueLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontNumericSemiBold}" />
        <Setter Property="FontSize" Value="{StaticResource SizeH1}" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="LineHeight" Value="1.15" />
    </Style>

    <Style x:Key="StatCaptionLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontRegular}" />
        <Setter Property="FontSize" Value="{StaticResource SizeMicro}" />
        <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
    </Style>

    <!-- Section label — "LIVE NU", "SENASTE RESULTAT". Structure without heading weight. -->
    <Style x:Key="SectionLabel" TargetType="Label">
        <Setter Property="SemanticProperties.HeadingLevel" Value="Level2" />
        <Setter Property="FontFamily" Value="{StaticResource FontMedium}" />
        <Setter Property="FontSize" Value="{StaticResource SizeMicro}" />
        <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="CharacterSpacing" Value="1.2" />
    </Style>

</ResourceDictionary>
