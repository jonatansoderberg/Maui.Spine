<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Orientera.Resources.Styles.LightTheme">

    <!--
        Orientera design tokens — Light.
        DarkTheme.xaml declares the exact same key set; ThemeManager swaps between them.
        Consume tokens with {DynamicResource} so the swap propagates. Never use colour
        literals in page XAML.
        Locked values and their WCAG AA evidence: docs/design/design-system.md
    -->

    <!-- Surfaces -->
    <Color x:Key="SurfacePage">#F7F7F5</Color>
    <Color x:Key="SurfaceCard">#FFFFFF</Color>
    <Color x:Key="SurfaceRaised">#FFFFFF</Color>
    <Color x:Key="SurfaceSubtle">#F1F1EC</Color>

    <!-- Lines -->
    <Color x:Key="Outline">#E4E4E0</Color>
    <Color x:Key="OutlineStrong">#D3D3CD</Color>

    <!-- Text -->
    <Color x:Key="TextPrimary">#1A1D21</Color>
    <Color x:Key="TextSecondary">#5B6167</Color>
    <Color x:Key="TextOnAccent">#FFFFFF</Color>
    <Color x:Key="TextOnSignal">#FFFFFF</Color>

    <!-- Accent -->
    <Color x:Key="AccentAction">#1B5E3F</Color>
    <Color x:Key="AccentSubtle">#EAF2ED</Color>

    <!--
        SignalUrgent är inte en andra accent utan en signal, och har exakt tre tillåtna
        användningar (beslut D1): live pågår, deadline inom ett dygn, tapp mot vinnaren.
        Nyansen är den orange som bar accenten före redesignen, oförändrad och därmed
        fortfarande kontrastverifierad.
    -->
    <Color x:Key="SignalUrgent">#C2410C</Color>

    <!-- Semantics -->
    <Color x:Key="PositiveDelta">#237D33</Color>
    <Color x:Key="NegativeDelta">#C92A2A</Color>
    <Color x:Key="EstimateInk">#9C36B5</Color>
    <Color x:Key="MapInk">#8A7B5C</Color>
    <Color x:Key="LinkInk">#1D4ED8</Color>

    <!-- Ytor som konceptet kräver: hero-gradient, skelettrader, avatarplats -->
    <Color x:Key="HeroScrim">#B3000000</Color>
    <Color x:Key="SkeletonBase">#ECECE8</Color>
    <Color x:Key="AvatarBackground">#E6EDE9</Color>

    <!--
        Live-kortets yta, och den enda ytan i appen som är mörk i *båda* temana. Ett kort som
        vänder om ljusheten behöver därför sitt eget bläck: TextOnAccent duger inte, för i mörkt
        tema är accenten mintgrön och dess text nästan svart. Nyanserna nedan är desamma i båda
        temafilerna där kortet inte har någon anledning att skilja sig — orange märke och dess
        text — och skiljer sig bara där en helvit yta hade glött i mörkt läge.
    -->
    <Color x:Key="SurfaceLive">#10553A</Color>
    <Color x:Key="TextOnDark">#FFFFFF</Color>
    <Color x:Key="TextOnDarkMuted">#C8E6D5</Color>
    <Color x:Key="SurfaceLiveAction">#FFFFFF</Color>
    <Color x:Key="TextOnLiveAction">#0F4D34</Color>

    <!--
        Live-märket på den gröna ytan. Fortfarande SignalUrgents första tillåtna användning
        (live pågår, beslut D1) — men ljusa temats #C2410C ger bara 1.7:1 mot kortet och
        försvinner i det. Mörka temats nyans klarar 3.39 mot ljus grön och 4.17 mot mörk, och
        används därför i båda temana av samma skäl som BrandTint: ytan under den byter inte
        med temat.
    -->
    <Color x:Key="SignalOnDark">#FF7A33</Color>
    <Color x:Key="TextOnSignalDark">#1A1208</Color>

    <!-- Banmärket i live-kortets bakgrund: vitt på låg opacitet, aldrig bärare av mening. -->
    <Color x:Key="TopoInk">#33FFFFFF</Color>

    <!--
        BrandTint är den enda färgen som inte kan byta med temat: tabbarens tint sätts vid
        handler-creation, och appikon och splash bakas vid build. Samma värde i båda temafilerna.
        Uppmätt 4.25:1 mot den ljusa baren och 3.94:1 mot den mörka — AccentAction klarar bara
        den ljusa (7.72 mot 2.17).
    -->
    <Color x:Key="BrandTint">#2E8B57</Color>

    <!--
        Spines PageActionView färgar textknappar i sidhuvudet ur Primary/PrimaryDark och faller
        annars tillbaka på MAUI-mallens lila. Båda deklareras i båda temafilerna, så knappen får
        rätt nyans oavsett vilket tema som råkar vara monterat när den läser.
    -->
    <Color x:Key="Primary">#1B5E3F</Color>
    <Color x:Key="PrimaryDark">#58C99A</Color>

    <!-- Elevation. Light cards carry a soft shadow; dark cards a hairline instead. -->
    <x:Double x:Key="CardStrokeThickness">0</x:Double>
    <Shadow x:Key="CardShadow" Brush="#1A1D21" Offset="0,2" Radius="12" Opacity="0.08" />

    <!-- Brush projections — Border.Stroke takes a Brush, not a Color -->
    <SolidColorBrush x:Key="OutlineBrush" Color="{StaticResource Outline}" />
    <SolidColorBrush x:Key="OutlineStrongBrush" Color="{StaticResource OutlineStrong}" />

    <!-- Disciplin: fyra distanser kall till varm, natt och indoor utanför skalan. -->
    <Color x:Key="DisciplineSprint">#6D28D9</Color>
    <Color x:Key="DisciplineMiddle">#1D7FE8</Color>
    <Color x:Key="DisciplineLong">#16A34A</Color>
    <Color x:Key="DisciplineUltraLong">#F97316</Color>
    <Color x:Key="DisciplineNight">#3730A3</Color>
    <Color x:Key="DisciplineRelay">#EF4444</Color>
    <Color x:Key="LevelChampionship">#CA8A04</Color>

    <SolidColorBrush x:Key="AccentActionBrush" Color="{StaticResource AccentAction}" />

</ResourceDictionary>
