<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        Base components — docs/design/designprinciper.md §5.
        The card is the load-bearing surface: radius 16, soft shadow in light,
        hairline outline in dark (both driven by theme tokens, so one style covers both).
    -->

    <!-- Geometry and rhythm (theme-independent) -->
    <x:Double x:Key="RadiusCard">16</x:Double>
    <x:Double x:Key="RadiusChip">18</x:Double>
    <x:Double x:Key="RadiusBadge">8</x:Double>
    <x:Double x:Key="SpaceXs">4</x:Double>
    <x:Double x:Key="SpaceS">8</x:Double>
    <x:Double x:Key="SpaceM">12</x:Double>
    <x:Double x:Key="SpaceL">16</x:Double>
    <x:Double x:Key="SpaceXl">24</x:Double>
    <x:Double x:Key="TouchTargetMin">44</x:Double>
    <Thickness x:Key="ScreenPadding">16,12,16,24</Thickness>

    <!-- Breathing room under the last row of a list. -->
    <x:Double x:Key="ListBottomSpacer">16</x:Double>
    <Thickness x:Key="CardPadding">16</Thickness>

    <!-- Card -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceCard}" />
        <Setter Property="Stroke" Value="{DynamicResource OutlineBrush}" />
        <Setter Property="StrokeThickness" Value="{DynamicResource CardStrokeThickness}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="16" />
        </Setter>
        <Setter Property="Shadow" Value="{DynamicResource CardShadow}" />
    </Style>

    <!-- Raised surface: hero blocks and sheet content -->
    <Style x:Key="RaisedCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceRaised}" />
    </Style>

    <!--
        Chip — quick filters. One row, horizontally scrollable; selected = accent fill.

        Padding är avsiktligt osymmetrisk. MinimumHeightRequest sätter höjden till 44, och ramen
        lägger då allt överskott under innehållet i stället för att centrera det: uppmätt på iOS
        låg texten 18,7 pt från överkanten och 11,0 pt från underkanten. Med 4 över och 12 under
        blev det 14,7 mot 15,0 — centrerat inom en pixel, och chipen är fortfarande 44 hög.
        VerticalTextAlignment på etiketten mätte ingen skillnad alls och står därför inte här.
    -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceSubtle}" />
        <Setter Property="Stroke" Value="{DynamicResource OutlineBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="14,4,14,12" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource TouchTargetMin}" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="18" />
        </Setter>
    </Style>

    <Style x:Key="ChipSelected" TargetType="Border" BasedOn="{StaticResource Chip}">
        <Setter Property="BackgroundColor" Value="{DynamicResource AccentAction}" />
        <Setter Property="Stroke" Value="{DynamicResource AccentActionBrush}" />
    </Style>

    <Style x:Key="ChipLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontMedium}" />
        <Setter Property="FontSize" Value="{StaticResource SizeCaption}" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="ChipSelectedLabel" TargetType="Label" BasedOn="{StaticResource ChipLabel}">
        <Setter Property="TextColor" Value="{DynamicResource TextOnAccent}" />
    </Style>

    <!--
        Badges — always text + colour, never colour alone (tillgänglighet, §5).
        BadgeLabel pairs with each Badge* border.
    -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceSubtle}" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="8" />
        </Setter>
    </Style>

    <!--
        Klubbmärken kommer som de är — egen bakgrund, egna färger, hundra olika. Ramen ger dem
        en gemensam form så att de läses som en del av listan i stället för som pålagda dekaler.
    -->
    <Style x:Key="ClubBadge" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceRaised}" />
        <Setter Property="Stroke" Value="{DynamicResource Outline}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="5" />
        </Setter>
    </Style>

    <Style x:Key="BadgeAccent" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="BackgroundColor" Value="{DynamicResource AccentSubtle}" />
    </Style>

    <Style x:Key="BadgePositive" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="BackgroundColor" Value="{DynamicResource PositiveDelta}" />
    </Style>

    <!-- Live pågår: en av SignalUrgents tre tillåtna användningar (D1) -->
    <Style x:Key="BadgeLive" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="BackgroundColor" Value="{DynamicResource SignalUrgent}" />
    </Style>

    <!--
        Etiketten sträcktes till ramens höjd och sköt texten nedåt i den ytan: uppmätt på iOS
        10,0 pt luft ovanför texten mot 3,3 pt under, i en badge som blivit 24 pt hög av en
        padding på 3. Centrerad etikett med centrerad text ger 3,0 mot 3,3 i en badge på 17 pt,
        vilket är den storlek paddingen beskriver.
    -->
    <Style x:Key="BadgeLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontMedium}" />
        <Setter Property="FontSize" Value="{StaticResource SizeMicro}" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="CharacterSpacing" Value="0.8" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="BadgeAccentLabel" TargetType="Label" BasedOn="{StaticResource BadgeLabel}">
        <Setter Property="TextColor" Value="{DynamicResource AccentAction}" />
    </Style>

    <Style x:Key="BadgeOnFillLabel" TargetType="Label" BasedOn="{StaticResource BadgeLabel}">
        <Setter Property="TextColor" Value="{DynamicResource TextOnAccent}" />
    </Style>

    <!-- Texten på SignalUrgent-fyllning: orangen är varm, accentens mörka bläck är grönt -->
    <Style x:Key="BadgeOnSignalLabel" TargetType="Label" BasedOn="{StaticResource BadgeLabel}">
        <Setter Property="TextColor" Value="{DynamicResource TextOnSignal}" />
    </Style>

    <!-- One primary CTA per view (§2.2) -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource AccentAction}" />
        <Setter Property="TextColor" Value="{DynamicResource TextOnAccent}" />
        <Setter Property="FontFamily" Value="{StaticResource FontSemiBold}" />
        <Setter Property="FontSize" Value="{StaticResource SizeBody}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HeightRequest" Value="{StaticResource TouchTargetMin}" />
        <Setter Property="Padding" Value="20,0" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceSubtle}" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource FontMedium}" />
    </Style>

    <!-- Hairline separator inside cards and lists -->
    <Style x:Key="Divider" TargetType="BoxView">
        <Setter Property="Color" Value="{DynamicResource Outline}" />
        <Setter Property="HeightRequest" Value="1" />
    </Style>

    <!--
        The discipline mark: a control ring with the route into it, drawn from DisciplineGlyph.
        The colour cannot come from the binding — a resource key is a string and DynamicResource
        will not take one — so the discipline picks its own brush here, one trigger per kind. The
        geometry still arrives bound, so the shapes have a single home in DisciplineGlyph.cs.
    -->
    <Style x:Key="DisciplineGlyph" TargetType="Path">
        <Setter Property="Aspect" Value="Uniform" />
        <Setter Property="WidthRequest" Value="16" />
        <Setter Property="HeightRequest" Value="16" />
        <!-- A hairline, the weight Strava draws its activity marks at. Two was a marker pen. -->
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="Stroke" Value="{DynamicResource TextMuted}" />
        <Setter Property="AutomationProperties.IsInAccessibleTree" Value="False" />
        <Style.Triggers>
            <DataTrigger TargetType="Path" Binding="{Binding DisciplineKey}" Value="Sprint">
                <Setter Property="Stroke" Value="{DynamicResource DisciplineSprint}" />
            </DataTrigger>
            <DataTrigger TargetType="Path" Binding="{Binding DisciplineKey}" Value="Middle">
                <Setter Property="Stroke" Value="{DynamicResource DisciplineMiddle}" />
            </DataTrigger>
            <DataTrigger TargetType="Path" Binding="{Binding DisciplineKey}" Value="Long">
                <Setter Property="Stroke" Value="{DynamicResource DisciplineLong}" />
            </DataTrigger>
            <DataTrigger TargetType="Path" Binding="{Binding DisciplineKey}" Value="UltraLong">
                <Setter Property="Stroke" Value="{DynamicResource DisciplineUltraLong}" />
            </DataTrigger>
            <DataTrigger TargetType="Path" Binding="{Binding DisciplineKey}" Value="Night">
                <Setter Property="Stroke" Value="{DynamicResource DisciplineNight}" />
            </DataTrigger>
            <DataTrigger TargetType="Path" Binding="{Binding DisciplineKey}" Value="Relay">
                <Setter Property="Stroke" Value="{DynamicResource DisciplineRelay}" />
            </DataTrigger>
            <DataTrigger TargetType="Path" Binding="{Binding DisciplineKey}" Value="Indoor">
                <Setter Property="Stroke" Value="{DynamicResource DisciplineIndoor}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        Shown while a page is reading. Centred over the whole surface rather than at the top:
        a spinner where the first row will be reads as a row that failed to arrive.
    -->
    <Style x:Key="PageLoading" TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{DynamicResource TextMuted}" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="WidthRequest" Value="28" />
        <Setter Property="HeightRequest" Value="28" />
        <Setter Property="AutomationProperties.IsInAccessibleTree" Value="True" />
        <Setter Property="SemanticProperties.Description" Value="Laddar" />
    </Style>

    <!--
        A mästerskap gets a gold cup beside its name; nothing else on the ladder is a kind rather
        than a degree. Not BasedOn the discipline style: that one's triggers key off DisciplineKey
        and would repaint the cup in the distance's colour on every card.
    -->
    <Style x:Key="LevelGlyph" TargetType="Path">
        <Setter Property="Aspect" Value="Uniform" />
        <Setter Property="WidthRequest" Value="14" />
        <Setter Property="HeightRequest" Value="14" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="Stroke" Value="{DynamicResource LevelChampionship}" />
        <Setter Property="AutomationProperties.IsInAccessibleTree" Value="False" />
    </Style>

</ResourceDictionary>
