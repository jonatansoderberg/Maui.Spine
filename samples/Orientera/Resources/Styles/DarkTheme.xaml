<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Orientera.Resources.Styles.DarkTheme">

    <!--
        Orientera design tokens — Dark. Same key set as LightTheme.xaml.
        Locked values and their WCAG AA evidence: docs/design/design-system.md
    -->

    <!-- Surfaces -->
    <Color x:Key="SurfacePage">#111315</Color>
    <Color x:Key="SurfaceCard">#1B1E21</Color>
    <Color x:Key="SurfaceRaised">#22262A</Color>
    <Color x:Key="SurfaceSubtle">#24282C</Color>

    <!-- Lines -->
    <Color x:Key="Outline">#2E3338</Color>
    <Color x:Key="OutlineStrong">#3C4249</Color>

    <!-- Text -->
    <Color x:Key="TextPrimary">#F2F3F4</Color>
    <Color x:Key="TextSecondary">#9AA1A7</Color>
    <Color x:Key="TextOnAccent">#1A1208</Color>

    <!-- Accent -->
    <Color x:Key="AccentAction">#FF7A33</Color>
    <Color x:Key="AccentSubtle">#3A2A20</Color>

    <!-- Semantics -->
    <Color x:Key="PositiveDelta">#51CF66</Color>
    <Color x:Key="NegativeDelta">#FF6B6B</Color>
    <Color x:Key="EstimateInk">#DA77F2</Color>
    <Color x:Key="MapInk">#4A5240</Color>

    <!-- Elevation -->
    <x:Double x:Key="CardStrokeThickness">1</x:Double>
    <Shadow x:Key="CardShadow" Brush="#000000" Offset="0,0" Radius="0" Opacity="0" />

    <!-- Brush projections — Border.Stroke takes a Brush, not a Color -->
    <SolidColorBrush x:Key="OutlineBrush" Color="{StaticResource Outline}" />
    <SolidColorBrush x:Key="OutlineStrongBrush" Color="{StaticResource OutlineStrong}" />
    <SolidColorBrush x:Key="AccentActionBrush" Color="{StaticResource AccentAction}" />

</ResourceDictionary>
