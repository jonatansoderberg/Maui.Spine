<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Orientera.Resources.Styles.DarkTheme">

    <!--
        Orientera design tokens — Dark. Same key set as LightTheme.xaml.
        Locked values and their WCAG AA evidence: docs/design/design-system.md
    -->

    <!-- Surfaces -->
    <Color x:Key="SurfacePage">#111315</Color>
    <Color x:Key="SurfaceCard">#1B1E21</Color>
    <Color x:Key="SurfaceRaised">#22262A</Color>
    <Color x:Key="SurfaceSubtle">#24282C</Color>

    <!-- Lines -->
    <Color x:Key="Outline">#2E3338</Color>
    <Color x:Key="OutlineStrong">#3C4249</Color>

    <!-- Text -->
    <Color x:Key="TextPrimary">#F2F3F4</Color>
    <Color x:Key="TextSecondary">#9AA1A7</Color>
    <Color x:Key="TextOnAccent">#08150F</Color>
    <Color x:Key="TextOnSignal">#1A1208</Color>

    <!-- Accent -->
    <Color x:Key="AccentAction">#58C99A</Color>
    <Color x:Key="AccentSubtle">#1E2E26</Color>

    <!-- Tre tillåtna användningar, se LightTheme.xaml -->
    <Color x:Key="SignalUrgent">#FF7A33</Color>

    <!-- Semantics -->
    <Color x:Key="PositiveDelta">#51CF66</Color>
    <Color x:Key="NegativeDelta">#FF6B6B</Color>
    <Color x:Key="EstimateInk">#DA77F2</Color>
    <Color x:Key="MapInk">#4A5240</Color>
    <Color x:Key="LinkInk">#7FB2FF</Color>

    <!-- Ytor som konceptet kräver -->
    <Color x:Key="HeroScrim">#CC000000</Color>
    <Color x:Key="SkeletonBase">#262A2E</Color>
    <Color x:Key="AvatarBackground">#2A322D</Color>

    <!-- Temaoberoende, se LightTheme.xaml -->
    <Color x:Key="BrandTint">#2E8B57</Color>
    <Color x:Key="Primary">#1B5E3F</Color>
    <Color x:Key="PrimaryDark">#58C99A</Color>

    <!-- Elevation -->
    <x:Double x:Key="CardStrokeThickness">1</x:Double>
    <Shadow x:Key="CardShadow" Brush="#000000" Offset="0,0" Radius="0" Opacity="0" />

    <!-- Brush projections — Border.Stroke takes a Brush, not a Color -->
    <SolidColorBrush x:Key="OutlineBrush" Color="{StaticResource Outline}" />
    <SolidColorBrush x:Key="OutlineStrongBrush" Color="{StaticResource OutlineStrong}" />

    <!-- Disciplin: fyra distanser kall till varm, natt och indoor utanför skalan. -->
    <Color x:Key="DisciplineSprint">#A78BFA</Color>
    <Color x:Key="DisciplineMiddle">#60A5FA</Color>
    <Color x:Key="DisciplineLong">#4ADE80</Color>
    <Color x:Key="DisciplineUltraLong">#FB923C</Color>
    <Color x:Key="DisciplineNight">#818CF8</Color>
    <Color x:Key="DisciplineRelay">#F87171</Color>
    <Color x:Key="LevelChampionship">#FBBF24</Color>

    <SolidColorBrush x:Key="AccentActionBrush" Color="{StaticResource AccentAction}" />

</ResourceDictionary>
