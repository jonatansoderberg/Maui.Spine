<SpinePage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Orientera.Features.Profile.ProfilePage"
    x:TypeArguments="ProfilePageViewModel"
    x:DataType="ProfilePageViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource ScreenPadding}" Spacing="20">

            <!-- ============ Profil ============ -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                <Border Grid.Column="0"
                        WidthRequest="56" HeightRequest="56"
                        BackgroundColor="{DynamicResource AccentSubtle}"
                        Stroke="Transparent" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="28" />
                    </Border.StrokeShape>
                    <Label Style="{StaticResource Heading1Label}"
                           TextColor="{DynamicResource AccentAction}"
                           HorizontalOptions="Center" VerticalOptions="Center"
                           AutomationProperties.IsInAccessibleTree="False"
                           Text="{Binding Initials}" />
                </Border>

                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Style="{StaticResource Heading1Label}" Text="{Binding Name}" />
                    <Label Style="{StaticResource CaptionLabel}" Text="{Binding Meta}" />
                </VerticalStackLayout>

                <!--
                    Ändra finns bara när ingen annan äger svaret. Är man inloggad är namnet och
                    klubben Eventors, och nästa hämtning skriver ändå över det man skrivit (#123).
                -->
                <Button Grid.Column="2"
                        Style="{StaticResource SecondaryButton}"
                        Padding="14,0"
                        HeightRequest="36"
                        FontSize="{StaticResource SizeCaption}"
                        Text="Ändra"
                        VerticalOptions="Center"
                        IsVisible="{Binding CanEditIdentity}"
                        SemanticProperties.Description="Ändra namn, klubb och klass"
                        Command="{Binding OpenIdentityCommand}" />
            </Grid>

            <!-- Klassen är alltid användarens eget val: man anmäler sig i andra klasser än sin normala. -->
            <Border Style="{StaticResource Card}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                        <Label Style="{StaticResource SectionLabel}" Text="Klass" />
                        <Label Style="{StaticResource BodyLabel}" Text="{Binding ClassText}" />
                    </VerticalStackLayout>

                    <Button Grid.Column="1"
                            Style="{StaticResource SecondaryButton}"
                            Padding="14,0"
                            HeightRequest="36"
                            FontSize="{StaticResource SizeCaption}"
                            Text="Välj"
                            VerticalOptions="Center"
                            SemanticProperties.Description="Välj vilken klass du oftast springer"
                            Command="{Binding OpenIdentityCommand}" />
                </Grid>
            </Border>

            <!--
                Sverigelistan saknas oftare än den finns: den kräver en egen inloggning och en
                klubb som betalat avgiften. Då står det varför, i stället för att kortet bara
                uteblir (#123).
            -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding HasRankingExplanation}">
                <Label Style="{StaticResource SectionLabel}" Text="Sverigelistan" />

                <Border Style="{StaticResource Card}">
                    <Label Style="{StaticResource CaptionLabel}" Text="{Binding RankingExplanation}" />
                </Border>
            </VerticalStackLayout>

            <!-- ============ Sverigelistan ============ -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding HasRanking}">
                <Label Style="{StaticResource SectionLabel}" Text="Sverigelistan" />

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">

                        <HorizontalStackLayout Spacing="10" VerticalOptions="End">
                            <Label Style="{StaticResource DisplayNumberLabel}"
                                   SemanticProperties.Description="{Binding PointsSpoken}"
                                   Text="{Binding PointsText}" />
                            <Label Style="{StaticResource NumericCaptionLabel}"
                                   VerticalOptions="End" Margin="0,0,0,6"
                                   TextColor="{DynamicResource PositiveDelta}"
                                   Text="{Binding TrendText}" />
                        </HorizontalStackLayout>

                        <Label Style="{StaticResource CaptionLabel}" Text="{Binding PlacesText}" />
                        <Label Style="{StaticResource NumericCaptionLabel}" Text="{Binding DisciplineText}" />

                        <Border Style="{StaticResource BadgeAccent}"
                                HorizontalOptions="Start"
                                IsVisible="{Binding HasExpiryWarning}">
                            <Label Style="{StaticResource BadgeAccentLabel}"
                                   TextTransform="None"
                                   Text="{Binding ExpiryWarning}" />
                        </Border>

                        <BoxView Style="{StaticResource Divider}" />

                        <Label Style="{StaticResource SectionLabel}" Text="Resultat i snittet" />

                        <VerticalStackLayout Spacing="7" BindableLayout.ItemsSource="{Binding CountingResults}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="RankingRow">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <VerticalStackLayout Grid.Column="0" Spacing="1">
                                            <Label Style="{StaticResource BodyLabel}" Text="{Binding Name}">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsCounting}" Value="False">
                                                        <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            <Label Style="{StaticResource NumericCaptionLabel}" Text="{Binding DateText}" />
                                            <Label Style="{StaticResource CaptionLabel}"
                                                   TextColor="{DynamicResource NegativeDelta}"
                                                   IsVisible="{Binding ExpiresSoon}"
                                                   Text="{Binding ExpiryText}" />
                                        </VerticalStackLayout>

                                        <Label Grid.Column="1"
                                               Style="{StaticResource NumericHeading2Label}"
                                               VerticalOptions="Center"
                                               Text="{Binding PointsText}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsCounting}" Value="False">
                                                    <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- ============ Eventor-inloggning ============ -->
            <VerticalStackLayout Spacing="8">
                <Label Style="{StaticResource SectionLabel}" Text="Eventor" />

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Label Style="{StaticResource CaptionLabel}" Text="{Binding EventorStatus}" />
                        <Button Style="{StaticResource SecondaryButton}"
                                Text="{Binding EventorAction}"
                                Command="{Binding OpenEventorLoginCommand}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- ============ Klubbaktiviteter ============ -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding HasActivities}">
                <Label Style="{StaticResource SectionLabel}" Text="Klubbaktiviteter" />

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Activities}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="ActivityRow">
                                <VerticalStackLayout Spacing="2">
                                    <VerticalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type Border}}, Path=BindingContext.OpenActivityCommand}"
                                            CommandParameter="{Binding .}" />
                                    </VerticalStackLayout.GestureRecognizers>

                                    <Label Style="{StaticResource BodyLabel}"
                                           SemanticProperties.Description="{Binding OpenDescription}"
                                           Text="{Binding Name}" />
                                    <Label Style="{StaticResource CaptionLabel}" Text="{Binding Meta}" />
                                    <Label Style="{StaticResource CaptionLabel}" Text="{Binding DeadlineText}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding ClosesSoon}" Value="True">
                                                <Setter Property="TextColor" Value="{DynamicResource NegativeDelta}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- ============ Serie ============ -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding HasSeries}">
                <Label Style="{StaticResource SectionLabel}" Text="{Binding SeriesName}" />

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Label Style="{StaticResource Heading2Label}" Text="{Binding SeriesStandingText}" />

                        <VerticalStackLayout Spacing="7" BindableLayout.ItemsSource="{Binding SeriesRounds}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="SeriesRow">
                                    <Grid ColumnDefinitions="*,56,44" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="1">
                                            <Label Style="{StaticResource BodyLabel}" Text="{Binding Name}" />
                                            <Label Style="{StaticResource NumericCaptionLabel}" Text="{Binding DateText}" />
                                        </VerticalStackLayout>

                                        <Label Grid.Column="1" Style="{StaticResource NumericCaptionLabel}"
                                               VerticalOptions="Center" HorizontalTextAlignment="End"
                                               Text="{Binding PlaceText}" />

                                        <Label Grid.Column="2" Style="{StaticResource NumericStrongLabel}"
                                               VerticalOptions="Center" HorizontalTextAlignment="End"
                                               Text="{Binding PointsText}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsCounting}" Value="False">
                                                    <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Label Style="{StaticResource CaptionLabel}"
                               Text="Grå rader räknas inte i totalen — de är strukna eller inte körda ännu." />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- ============ Favoriter ============ -->
            <VerticalStackLayout Spacing="8">
                <Label Style="{StaticResource SectionLabel}" Text="Favoriter" />

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Group}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="GroupMemberRow">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                                            <Label Style="{StaticResource BodyStrongLabel}" Text="{Binding Name}" />
                                            <Label Style="{StaticResource CaptionLabel}" Text="{Binding Meta}" />
                                        </VerticalStackLayout>

                                        <Label Grid.Column="1"
                                               Style="{StaticResource BodyLabel}"
                                               TextColor="{DynamicResource TextSecondary}"
                                               VerticalOptions="Center"
                                               MinimumHeightRequest="44"
                                               VerticalTextAlignment="Center"
                                               SemanticProperties.Description="{Binding UnfollowDescription}"
                                               Text="Sluta följa">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ScrollView}}, Path=BindingContext.UnfollowCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Button Style="{StaticResource SecondaryButton}"
                                Text="Följ någon"
                                Command="{Binding OpenFollowRunnerCommand}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- ============ Dev-verktyg ============ -->
            <VerticalStackLayout Spacing="8">
                <Label Style="{StaticResource SectionLabel}" Text="Notiser" />
                <Button Style="{StaticResource SecondaryButton}"
                        Text="Vad du vill bli notifierad om"
                        Command="{Binding OpenNotificationsCommand}" />

                <Label Style="{StaticResource SectionLabel}" Text="Utvecklingsläge" />
                <Button Style="{StaticResource SecondaryButton}" Text="Tidsmaskin" Command="{Binding OpenTimeMachineCommand}" />
                <Button Style="{StaticResource SecondaryButton}" Text="Designsystem" Command="{Binding OpenDesignSystemCommand}" />
                <Label Style="{StaticResource CaptionLabel}"
                       Text="{Binding SourceDescription}" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</SpinePage>
