<SpinePage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Orientera.Features.Home.HomePage"
    x:TypeArguments="HomePageViewModel"
    x:DataType="HomePageViewModel">

    <SpinePage.Resources>

        <!--
            Disciplinraden — distansen och nivån, samma två fakta som listan i Tävlingar visar,
            ritade likadant. Två varianter, för att märkets färg inte kan följa med till en mörk
            yta: distansernas nyanser är valda mot kort och sida.
        -->
        <DataTemplate x:Key="LiveNowTemplate" x:DataType="LiveNowBlock">
            <!--
                Ytan är en bild och inte bara en färg. Padding noll på ramen, så att kartbilden går
                ut i kanterna; innehållet bär kortets padding själv i stället. SurfaceLive ligger
                kvar under bilden — den är ytans färg medan bilden laddas, och den ringen
                avatarerna står i.
            -->
            <Border Style="{StaticResource Card}"
                    Margin="16,0"
                    Padding="0"
                    BackgroundColor="{DynamicResource SurfaceLive}"
                    Stroke="Transparent">
                <Grid>
                    <!--
                        HeightRequest 1 och Fill: bilden ska täcka kortets yta, inte bestämma
                        den. Utan det mäts den på sin egen storlek — elvahundra punkter — och
                        kortet växte till en skärmhög grön platta.
                    -->
                    <Image Source="surface_live.jpg" Aspect="AspectFill"
                           HeightRequest="1" WidthRequest="1"
                           VerticalOptions="Fill" HorizontalOptions="Fill"
                           AutomationProperties.IsInAccessibleTree="False" />

                    <VerticalStackLayout Padding="{StaticResource CardPadding}" Spacing="10">
                        <Border Style="{StaticResource Badge}"
                                BackgroundColor="{DynamicResource SignalOnDark}"
                                HorizontalOptions="Start">
                            <Label Style="{StaticResource BadgeLabel}"
                                   TextColor="{DynamicResource TextOnSignalDark}"
                                   Text="Live nu" />
                        </Border>

                        <Label Style="{StaticResource Heading1Label}"
                               TextColor="{DynamicResource TextOnDark}"
                               Text="{Binding Title}" />

                        <Label Style="{StaticResource CaptionLabel}"
                               TextColor="{DynamicResource TextOnDarkMuted}"
                               Text="{Binding Subtitle}" />

                        <HorizontalStackLayout Spacing="5" IsVisible="{Binding HasDisciplineShape}">
                            <Path Style="{StaticResource DisciplineGlyphOnDark}"
                                  Data="{Binding DisciplineShape}" />
                            <Label Style="{StaticResource CaptionLabel}" VerticalOptions="Center"
                                   TextColor="{DynamicResource TextOnDarkMuted}"
                                   Text="{Binding DisciplineLabel}" />
                            <Label Style="{StaticResource CaptionLabel}" VerticalOptions="Center"
                                   TextColor="{DynamicResource TextOnDarkMuted}" Text="·" />
                            <Path Style="{StaticResource LevelGlyph}"
                                  Data="{Binding LevelShape}"
                                  IsVisible="{Binding HasLevelShape}" />
                            <Label Style="{StaticResource CaptionLabel}" VerticalOptions="Center"
                                   TextColor="{DynamicResource TextOnDarkMuted}"
                                   Text="{Binding LevelLabel}" />
                        </HorizontalStackLayout>

                        <Label Style="{StaticResource NumericStrongLabel}"
                               TextColor="{DynamicResource TextOnDark}"
                               Text="{Binding MyStatus}" />

                        <AvatarStack Faces="{Binding Faces}"
                                     Total="{Binding FieldSize}"
                                     IsVisible="{Binding HasFaces}"
                                     RingColor="{DynamicResource SurfaceLive}"
                                     Description="{Binding FieldText}" />

                        <Button Style="{StaticResource PrimaryButton}"
                                BackgroundColor="{DynamicResource SurfaceLiveAction}"
                                TextColor="{DynamicResource TextOnLiveAction}"
                                Text="{Binding ActionText}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ScrollView}}, Path=BindingContext.OpenLiveCommand}"
                                CommandParameter="{Binding Competition}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="NextForMeTemplate" x:DataType="NextForMeBlock">
            <VerticalStackLayout Spacing="8" Margin="16,0">
                <SectionHeader Title="{Binding SectionLabel}"
                               ActionText="Visa kalender"
                               Command="{Binding Source={RelativeSource AncestorType={x:Type ScrollView}}, Path=BindingContext.OpenEventsCommand}" />

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Border Grid.Column="0" Style="{StaticResource GlyphPlate}"
                                    IsVisible="{Binding HasDisciplineShape}">
                                <Path Style="{StaticResource DisciplineGlyph}"
                                      WidthRequest="22" HeightRequest="22"
                                      HorizontalOptions="Center" VerticalOptions="Center"
                                      Data="{Binding DisciplineShape}" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Style="{StaticResource Heading2Label}" Text="{Binding Title}" />

                                <HorizontalStackLayout Spacing="5" IsVisible="{Binding HasDisciplineShape}">
                                    <Label Style="{StaticResource CaptionLabel}" VerticalOptions="Center"
                                           Text="{Binding DisciplineLabel}" />
                                    <Label Style="{StaticResource CaptionLabel}" VerticalOptions="Center" Text="·" />
                                    <Path Style="{StaticResource LevelGlyph}"
                                          Data="{Binding LevelShape}"
                                          IsVisible="{Binding HasLevelShape}" />
                                    <Label Style="{StaticResource CaptionLabel}" VerticalOptions="Center"
                                           Text="{Binding LevelLabel}" />
                                </HorizontalStackLayout>

                                <Label Style="{StaticResource NumericStrongLabel}" Text="{Binding WhenText}" />
                                <Label Style="{StaticResource CaptionLabel}" Text="{Binding PlaceText}" />
                            </VerticalStackLayout>

                            <!-- Terrängen tävlingen går i, inte platsen den går på (P7). -->
                            <Border Grid.Column="2"
                                    WidthRequest="64" HeightRequest="64"
                                    VerticalOptions="Start"
                                    Stroke="Transparent" StrokeThickness="0" Padding="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <HeroImage Discipline="{Binding TerrainKey}"
                                           WidthRequest="64" HeightRequest="64" />
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Border Grid.Column="0" Style="{StaticResource BadgeAccent}" VerticalOptions="Center">
                                <Label Style="{StaticResource BadgeAccentLabel}" Text="{Binding StateText}" />
                            </Border>

                            <Label Grid.Column="1" Style="{StaticResource NumericStrongLabel}"
                                   VerticalOptions="Center"
                                   IsVisible="{Binding HasStart}"
                                   Text="{Binding StartText}" />

                            <Button Grid.Column="2"
                                    Style="{StaticResource PrimaryButton}"
                                    Text="{Binding ActionText}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ScrollView}}, Path=BindingContext.OpenCompetitionCommand}"
                                    CommandParameter="{Binding Competition}" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </DataTemplate>

        <DataTemplate x:Key="LatestResultTemplate" x:DataType="LatestResultBlock">
            <VerticalStackLayout Spacing="8" Margin="16,0">
                <SectionHeader Title="{Binding SectionLabel}"
                               ActionText="Se alla"
                               Command="{Binding Source={RelativeSource AncestorType={x:Type ScrollView}}, Path=BindingContext.OpenMyResultsCommand}" />

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Grid.Column="0" Style="{StaticResource GlyphPlate}"
                                    IsVisible="{Binding HasDisciplineShape}">
                                <Path Style="{StaticResource DisciplineGlyph}"
                                      WidthRequest="22" HeightRequest="22"
                                      HorizontalOptions="Center" VerticalOptions="Center"
                                      Data="{Binding DisciplineShape}" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Style="{StaticResource Heading2Label}" Text="{Binding Title}" />
                                <HorizontalStackLayout Spacing="5" IsVisible="{Binding HasDisciplineShape}">
                                    <Label Style="{StaticResource CaptionLabel}" VerticalOptions="Center"
                                           Text="{Binding DisciplineLabel}" />
                                    <Label Style="{StaticResource CaptionLabel}" VerticalOptions="Center" Text="·" />
                                    <Path Style="{StaticResource LevelGlyph}"
                                          Data="{Binding LevelShape}"
                                          IsVisible="{Binding HasLevelShape}" />
                                    <Label Style="{StaticResource CaptionLabel}" VerticalOptions="Center"
                                           Text="{Binding LevelLabel}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <StatRow Grid.Column="0" Stats="{Binding Stats}" VerticalOptions="Center" />

                            <Border Grid.Column="1" Style="{StaticResource BadgeAccent}"
                                    VerticalOptions="Center"
                                    IsVisible="{Binding HasTrend}">
                                <Label Style="{StaticResource BadgeAccentLabel}" Text="{Binding TrendText}" />
                            </Border>
                        </Grid>

                        <Button Style="{StaticResource SecondaryButton}"
                                Text="{Binding ActionText}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ScrollView}}, Path=BindingContext.OpenResultCommand}"
                                CommandParameter="{Binding Competition}" />

                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </DataTemplate>

        <DataTemplate x:Key="GroupTemplate" x:DataType="GroupBlock">
            <VerticalStackLayout Spacing="8" Margin="16,0">
                <SectionHeader Title="{Binding SectionLabel}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource Heading2Label}" Text="{Binding Summary}" />

                        <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding Lines}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Label Style="{StaticResource NumericLabel}" Text="{Binding .}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </DataTemplate>

        <DataTemplate x:Key="DiscoveryTemplate" x:DataType="DiscoveryBlock">
            <VerticalStackLayout Spacing="8" Margin="16,0">
                <SectionHeader Title="{Binding SectionLabel}"
                               ActionText="Visa kalender"
                               Command="{Binding Source={RelativeSource AncestorType={x:Type ScrollView}}, Path=BindingContext.OpenEventsCommand}" />

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Border Grid.Column="0" Style="{StaticResource GlyphPlate}"
                                    IsVisible="{Binding HasDisciplineShape}">
                                <Path Style="{StaticResource DisciplineGlyph}"
                                      WidthRequest="22" HeightRequest="22"
                                      HorizontalOptions="Center" VerticalOptions="Center"
                                      Data="{Binding DisciplineShape}" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Style="{StaticResource Heading2Label}" Text="{Binding Title}" />
                                <HorizontalStackLayout Spacing="5" IsVisible="{Binding HasDisciplineShape}">
                                    <Label Style="{StaticResource CaptionLabel}" VerticalOptions="Center"
                                           Text="{Binding DisciplineLabel}" />
                                    <Label Style="{StaticResource CaptionLabel}" VerticalOptions="Center" Text="·" />
                                    <Path Style="{StaticResource LevelGlyph}"
                                          Data="{Binding LevelShape}"
                                          IsVisible="{Binding HasLevelShape}" />
                                    <Label Style="{StaticResource CaptionLabel}" VerticalOptions="Center"
                                           Text="{Binding LevelLabel}" />
                                </HorizontalStackLayout>
                                <Label Style="{StaticResource NumericStrongLabel}" Text="{Binding WhenText}" />
                                <Label Style="{StaticResource CaptionLabel}" Text="{Binding ReasonText}" />
                            </VerticalStackLayout>

                            <Border Grid.Column="2"
                                    WidthRequest="64" HeightRequest="64"
                                    VerticalOptions="Start"
                                    Stroke="Transparent" StrokeThickness="0" Padding="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <HeroImage Discipline="{Binding TerrainKey}"
                                           WidthRequest="64" HeightRequest="64" />
                            </Border>
                        </Grid>

                        <Button Style="{StaticResource SecondaryButton}"
                                Text="Visa tävling"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ScrollView}}, Path=BindingContext.OpenCompetitionCommand}"
                                CommandParameter="{Binding Competition}" />

                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </DataTemplate>

        <DataTemplate x:Key="DevelopmentTemplate" x:DataType="DevelopmentBlock">
            <VerticalStackLayout Spacing="8" Margin="16,0">
                <SectionHeader Title="{Binding SectionLabel}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="6">

                        <HorizontalStackLayout Spacing="10" VerticalOptions="End">
                            <Label Style="{StaticResource DisplayNumberLabel}" Text="{Binding PointsText}" />
                            <Label Style="{StaticResource NumericCaptionLabel}"
                                   VerticalOptions="End" Margin="0,0,0,6"
                                   TextColor="{DynamicResource PositiveDelta}"
                                   Text="{Binding TrendText}" />
                        </HorizontalStackLayout>

                        <Label Style="{StaticResource CaptionLabel}" Text="{Binding PlaceText}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </DataTemplate>

        <HomeBlockTemplateSelector x:Key="BlockSelector"
                                   LiveNow="{StaticResource LiveNowTemplate}"
                                   NextForMe="{StaticResource NextForMeTemplate}"
                                   LatestResult="{StaticResource LatestResultTemplate}"
                                   Group="{StaticResource GroupTemplate}"
                                   Discovery="{StaticResource DiscoveryTemplate}"
                                   Development="{StaticResource DevelopmentTemplate}" />

    </SpinePage.Resources>

    <Grid>

        <!--
            Fyra lägen, ett värde (P10). Hjälten står överst i alla fyra — hälsningen är sann utan
            nätverk, och en sida som tappar sin rubrik när hämtningen misslyckas ser trasig ut
            snarare än offline. I innehållsläget ligger den i listans huvud och skrollar bort med
            korten; det är det som låter första kortet ligga över bilden i stället för att klippas
            mot en kant mitt på den.
        -->
        <StateView State="{Binding State}">

            <!--
                Skelettet har blockens form och inte en listas: ett högt kort, sedan två med var
                sin rubrik ovanför. Ett skelett av fel form är en grå låda, och sidan hoppar när
                korten kommer.
            -->
            <StateView.Skeleton>
                <Grid RowDefinitions="Auto,*">
                    <HomeHero Grid.Row="0" />

                    <VerticalStackLayout Grid.Row="1" Padding="16,16,16,0" Spacing="12">
                        <BoxView HeightRequest="230" CornerRadius="16" Color="{DynamicResource SkeletonBase}" />

                        <BoxView HeightRequest="17" WidthRequest="130" CornerRadius="4"
                                 HorizontalOptions="Start" Margin="0,8,0,0"
                                 Color="{DynamicResource SkeletonBase}" />
                        <BoxView HeightRequest="170" CornerRadius="16" Color="{DynamicResource SkeletonBase}" />
                    </VerticalStackLayout>
                </Grid>
            </StateView.Skeleton>

            <!--
                En skrollvy och inte en CollectionView. Hjälten måste rita hela sin höjd medan
                blocken ligger över dess nedre hälft, och listans huvudcell beskär sitt innehåll
                till den höjd marginalen lämnar — bilden kapades vid första kortets överkant och
                kortet stod på sidans yta i stället för på fotot. En stapel beskär inte sina barn.
                Hem visar högst fyra block, så det virtualiseringen kostar är ingenting här.
            -->
            <StateView.Body>
                <ScrollView x:Name="Scroll" Scrolled="OnScrolled">
                    <VerticalStackLayout>

                        <HomeHero x:Name="Hero" />

                        <VerticalStackLayout Margin="{Binding HeroOverlap}"
                                             Spacing="16"
                                             BindableLayout.ItemsSource="{Binding Blocks}"
                                             BindableLayout.ItemTemplateSelector="{StaticResource BlockSelector}" />

                        <!-- Margin carries the tab bar's own height; the height is the breathing room.
                             Bara underkanten: sedan hjälten tog över toppen bär SafeAreaInsets statusfältet
                             också, och hela tjockleken här hade lagt 59 punkter luft under sista kortet. -->
                        <BoxView HeightRequest="{StaticResource ListBottomSpacer}"
                                 Margin="{Binding ListBottomInset}"
                                 Color="Transparent" />

                    </VerticalStackLayout>
                </ScrollView>
            </StateView.Body>

            <!--
                Tomt läge får en väg vidare och inte bara en mening. Den som saknar block har
                inget att göra på Hem, och kalendern är svaret — inte en uppmaning att vänta.
            -->
            <StateView.EmptyView>
                <Grid RowDefinitions="Auto,*">
                    <HomeHero Grid.Row="0" />

                    <VerticalStackLayout Grid.Row="1" Padding="32" Spacing="10" VerticalOptions="Center">
                        <Label Style="{StaticResource Heading2Label}"
                               HorizontalTextAlignment="Center"
                               Text="Inget att visa än" />
                        <Label Style="{StaticResource BodySecondaryLabel}"
                               HorizontalTextAlignment="Center"
                               Text="När du anmält dig till något står det här, tillsammans med dina resultat och dem du följer." />
                        <Button Style="{StaticResource PrimaryButton}"
                                HorizontalOptions="Center"
                                Text="Visa tävlingar"
                                Command="{Binding OpenEventsCommand}" />
                    </VerticalStackLayout>
                </Grid>
            </StateView.EmptyView>

            <StateView.ErrorView>
                <Grid RowDefinitions="Auto,*">
                    <HomeHero Grid.Row="0" />

                    <VerticalStackLayout Grid.Row="1" Padding="32" Spacing="12" VerticalOptions="Center">
                        <Label Style="{StaticResource Heading2Label}"
                               HorizontalTextAlignment="Center"
                               Text="Ingen anslutning" />
                        <Label Style="{StaticResource BodySecondaryLabel}"
                               HorizontalTextAlignment="Center"
                               Text="Tävlingar du sparat offline finns kvar under Tävlingar — PM, din starttid och arenan fungerar utan nätverk." />
                        <Button Style="{StaticResource SecondaryButton}"
                                HorizontalOptions="Center"
                                Text="Försök igen"
                                Command="{Binding ReloadCommand}" />
                    </VerticalStackLayout>
                </Grid>
            </StateView.ErrorView>

        </StateView>

    </Grid>

</SpinePage>
