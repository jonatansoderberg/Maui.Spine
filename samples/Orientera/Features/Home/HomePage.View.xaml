<SpinePage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Orientera.Features.Home.HomePage"
    x:TypeArguments="HomePageViewModel"
    x:DataType="HomePageViewModel">

    <SpinePage.Resources>

        <DataTemplate x:Key="LiveNowTemplate" x:DataType="LiveNowBlock">
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <HorizontalStackLayout Spacing="8">
                        <Border Style="{StaticResource BadgeLive}">
                            <Label Style="{StaticResource BadgeOnSignalLabel}" Text="Live nu" />
                        </Border>
                    </HorizontalStackLayout>

                    <Label Style="{StaticResource Heading1Label}" Text="{Binding Title}" />

                        <HorizontalStackLayout Spacing="5" IsVisible="{Binding HasDisciplineShape}">
                            <Path Style="{StaticResource DisciplineGlyph}"
                                  Data="{Binding DisciplineShape}" />
                            <Label Style="{StaticResource CaptionLabel}" VerticalOptions="Center"
                                   Text="{Binding DisciplineLabel}" />
                            <Label Style="{StaticResource CaptionLabel}" VerticalOptions="Center" Text="·" />
                            <Path Style="{StaticResource LevelGlyph}"
                                  Data="{Binding LevelShape}"
                                  IsVisible="{Binding HasLevelShape}" />
                            <Label Style="{StaticResource CaptionLabel}" VerticalOptions="Center"
                                   Text="{Binding LevelLabel}" />
                        </HorizontalStackLayout>
                    <Label Style="{StaticResource CaptionLabel}" Text="{Binding Subtitle}" />
                    <Label Style="{StaticResource NumericStrongLabel}" Text="{Binding MyStatus}" />

                    <Button Style="{StaticResource PrimaryButton}"
                            Text="{Binding ActionText}"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type CollectionView}}, Path=BindingContext.OpenLiveCommand}"
                            CommandParameter="{Binding Competition}" />
                </VerticalStackLayout>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="NextForMeTemplate" x:DataType="NextForMeBlock">
            <VerticalStackLayout Spacing="7">
                <Label Style="{StaticResource SectionLabel}" Text="{Binding SectionLabel}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Label Style="{StaticResource Heading1Label}" Text="{Binding Title}" />

                        <HorizontalStackLayout Spacing="5" IsVisible="{Binding HasDisciplineShape}">
                            <Path Style="{StaticResource DisciplineGlyph}"
                                  Data="{Binding DisciplineShape}" />
                            <Label Style="{StaticResource CaptionLabel}" VerticalOptions="Center"
                                   Text="{Binding DisciplineLabel}" />
                            <Label Style="{StaticResource CaptionLabel}" VerticalOptions="Center" Text="·" />
                            <Path Style="{StaticResource LevelGlyph}"
                                  Data="{Binding LevelShape}"
                                  IsVisible="{Binding HasLevelShape}" />
                            <Label Style="{StaticResource CaptionLabel}" VerticalOptions="Center"
                                   Text="{Binding LevelLabel}" />
                        </HorizontalStackLayout>
                        <Label Style="{StaticResource NumericStrongLabel}" Text="{Binding WhenText}" />
                        <Label Style="{StaticResource CaptionLabel}" Text="{Binding PlaceText}" />

                        <HorizontalStackLayout Spacing="8">
                            <Border Style="{StaticResource BadgeAccent}">
                                <Label Style="{StaticResource BadgeAccentLabel}" Text="{Binding StateText}" />
                            </Border>
                            <Label Style="{StaticResource NumericStrongLabel}"
                                   VerticalOptions="Center"
                                   IsVisible="{Binding HasStart}"
                                   Text="{Binding StartText}" />
                        </HorizontalStackLayout>

                        <Button Style="{StaticResource PrimaryButton}"
                                Text="{Binding ActionText}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type CollectionView}}, Path=BindingContext.OpenCompetitionCommand}"
                                CommandParameter="{Binding Competition}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </DataTemplate>

        <DataTemplate x:Key="LatestResultTemplate" x:DataType="LatestResultBlock">
            <VerticalStackLayout Spacing="7">
                <Label Style="{StaticResource SectionLabel}" Text="{Binding SectionLabel}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Label Style="{StaticResource Heading2Label}" Text="{Binding Title}" />

                        <HorizontalStackLayout Spacing="5" IsVisible="{Binding HasDisciplineShape}">
                            <Path Style="{StaticResource DisciplineGlyph}"
                                  Data="{Binding DisciplineShape}" />
                            <Label Style="{StaticResource CaptionLabel}" VerticalOptions="Center"
                                   Text="{Binding DisciplineLabel}" />
                            <Label Style="{StaticResource CaptionLabel}" VerticalOptions="Center" Text="·" />
                            <Path Style="{StaticResource LevelGlyph}"
                                  Data="{Binding LevelShape}"
                                  IsVisible="{Binding HasLevelShape}" />
                            <Label Style="{StaticResource CaptionLabel}" VerticalOptions="Center"
                                   Text="{Binding LevelLabel}" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="12" VerticalOptions="End">
                            <Label Style="{StaticResource DisplayNumberLabel}" Text="{Binding PlaceText}" />
                            <VerticalStackLayout VerticalOptions="End" Margin="0,0,0,4">
                                <Label Style="{StaticResource NumericStrongLabel}" Text="{Binding TimeText}" />
                                <Label Style="{StaticResource NumericCaptionLabel}"
                                       TextColor="{DynamicResource NegativeDelta}"
                                       Text="{Binding BehindText}" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <Button Style="{StaticResource SecondaryButton}"
                                Text="{Binding ActionText}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type CollectionView}}, Path=BindingContext.OpenResultCommand}"
                                CommandParameter="{Binding Competition}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </DataTemplate>

        <DataTemplate x:Key="GroupTemplate" x:DataType="GroupBlock">
            <VerticalStackLayout Spacing="7">
                <Label Style="{StaticResource SectionLabel}" Text="{Binding SectionLabel}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource Heading2Label}" Text="{Binding Summary}" />

                        <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding Lines}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Label Style="{StaticResource NumericLabel}" Text="{Binding .}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </DataTemplate>

        <DataTemplate x:Key="DiscoveryTemplate" x:DataType="DiscoveryBlock">
            <VerticalStackLayout Spacing="7">
                <Label Style="{StaticResource SectionLabel}" Text="{Binding SectionLabel}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource Heading2Label}" Text="{Binding Title}" />

                        <HorizontalStackLayout Spacing="5" IsVisible="{Binding HasDisciplineShape}">
                            <Path Style="{StaticResource DisciplineGlyph}"
                                  Data="{Binding DisciplineShape}" />
                            <Label Style="{StaticResource CaptionLabel}" VerticalOptions="Center"
                                   Text="{Binding DisciplineLabel}" />
                            <Label Style="{StaticResource CaptionLabel}" VerticalOptions="Center" Text="·" />
                            <Path Style="{StaticResource LevelGlyph}"
                                  Data="{Binding LevelShape}"
                                  IsVisible="{Binding HasLevelShape}" />
                            <Label Style="{StaticResource CaptionLabel}" VerticalOptions="Center"
                                   Text="{Binding LevelLabel}" />
                        </HorizontalStackLayout>
                        <Label Style="{StaticResource NumericStrongLabel}" Text="{Binding WhenText}" />
                        <Label Style="{StaticResource CaptionLabel}" Text="{Binding ReasonText}" />

                        <Button Style="{StaticResource SecondaryButton}"
                                Text="Visa tävling"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type CollectionView}}, Path=BindingContext.OpenCompetitionCommand}"
                                CommandParameter="{Binding Competition}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </DataTemplate>

        <DataTemplate x:Key="DevelopmentTemplate" x:DataType="DevelopmentBlock">
            <VerticalStackLayout Spacing="7">
                <Label Style="{StaticResource SectionLabel}" Text="{Binding SectionLabel}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="6">

                        <HorizontalStackLayout Spacing="10" VerticalOptions="End">
                            <Label Style="{StaticResource DisplayNumberLabel}" Text="{Binding PointsText}" />
                            <Label Style="{StaticResource NumericCaptionLabel}"
                                   VerticalOptions="End" Margin="0,0,0,6"
                                   TextColor="{DynamicResource PositiveDelta}"
                                   Text="{Binding TrendText}" />
                        </HorizontalStackLayout>

                        <Label Style="{StaticResource CaptionLabel}" Text="{Binding PlaceText}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </DataTemplate>

        <HomeBlockTemplateSelector x:Key="BlockSelector"
                                   LiveNow="{StaticResource LiveNowTemplate}"
                                   NextForMe="{StaticResource NextForMeTemplate}"
                                   LatestResult="{StaticResource LatestResultTemplate}"
                                   Group="{StaticResource GroupTemplate}"
                                   Discovery="{StaticResource DiscoveryTemplate}"
                                   Development="{StaticResource DevelopmentTemplate}" />

    </SpinePage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!--
            Hjälten står utanför listan. Som CollectionView.Header mättes hälsningen innan texten
            fanns, och en header som en gång mätts som tom växer inte när innehållet kommer —
            rubriken klipptes och första kortet ritades ovanpå den.
        -->
        <Grid Grid.Row="0" HeightRequest="250">

            <!--
                Bilden är stämning och inte plats (beslut D12) — det enda undantaget från P7, och
                ett räknebart: exakt en bundlad icke-terrängbild, på exakt den här ytan.
            -->
            <Image Source="hero_home.jpg" Aspect="AspectFill"
                   AutomationProperties.IsInAccessibleTree="False" />

            <!--
                Gradienten, inte bilden, är det som gör vit text läsbar. Mätt mot bildens ljusaste
                pixel under texten: 2.25:1 utan den, 6.4:1 med. Klarar en bild inte kravet byts
                bilden — aldrig texten.
            -->
            <Border StrokeThickness="0" InputTransparent="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="{DynamicResource HeroScrim}" />
                        <GradientStop Offset="1" Color="Transparent" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Bilden går under statusfältet, texten insetar sig själv. -->
            <VerticalStackLayout Padding="{Binding HeroPadding}" Spacing="2" VerticalOptions="Start">
                <Label Style="{StaticResource HeroGreetingLabel}" Text="{Binding Greeting}" />
                <Label Style="{StaticResource HeroMetaLabel}" Text="{Binding TodayText}" />
            </VerticalStackLayout>

        </Grid>

        <!-- Offline utan sparade block: ett designat läge, inte en tom lista -->
        <VerticalStackLayout Grid.Row="1" Padding="32" Spacing="8" VerticalOptions="Center" IsVisible="{Binding IsOffline}">
            <Label Style="{StaticResource Heading2Label}" HorizontalTextAlignment="Center"
                   Text="Ingen anslutning" />
            <Label Style="{StaticResource BodySecondaryLabel}" HorizontalTextAlignment="Center"
                   Text="Tävlingar du sparat offline finns kvar under Tävlingar — PM, din starttid och arenan fungerar utan nätverk." />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1"
                    ItemsSource="{Binding Blocks}"
                    ItemTemplate="{StaticResource BlockSelector}"
                    Margin="16,0"
                    SelectionMode="None">

        <CollectionView.ItemsLayout>
            <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
        </CollectionView.ItemsLayout>

        <CollectionView.Footer>
            <!-- Margin carries the tab bar's own height; the height is the breathing room.
                 Bara underkanten: sedan hjälten tog över toppen bär SafeAreaInsets statusfältet
                 också, och hela tjockleken här hade lagt 59 punkter luft under sista kortet. -->
            <BoxView HeightRequest="{StaticResource ListBottomSpacer}"
                     Margin="{Binding ListBottomInset}"
                     Color="Transparent" />
        </CollectionView.Footer>

        </CollectionView>

    
        <ActivityIndicator Style="{StaticResource PageLoading}"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}" />

</Grid>

</SpinePage>
