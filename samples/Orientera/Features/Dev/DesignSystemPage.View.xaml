<SpinePage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Orientera.Features.Dev.DesignSystemPage"
    x:TypeArguments="DesignSystemPageViewModel"
    x:DataType="DesignSystemPageViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource ScreenPadding}" Spacing="24">

            <!-- ============ Ytor ============ -->
            <VerticalStackLayout Spacing="8">
                <Label Style="{StaticResource SectionLabel}" Text="Ytor" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="10">
                            <BoxView WidthRequest="40" HeightRequest="40" CornerRadius="8" Color="{DynamicResource SurfacePage}" />
                            <BoxView WidthRequest="40" HeightRequest="40" CornerRadius="8" Color="{DynamicResource SurfaceCard}" />
                            <BoxView WidthRequest="40" HeightRequest="40" CornerRadius="8" Color="{DynamicResource SurfaceRaised}" />
                            <BoxView WidthRequest="40" HeightRequest="40" CornerRadius="8" Color="{DynamicResource SurfaceSubtle}" />
                            <BoxView WidthRequest="40" HeightRequest="40" CornerRadius="8" Color="{DynamicResource Outline}" />
                            <BoxView WidthRequest="40" HeightRequest="40" CornerRadius="8" Color="{DynamicResource OutlineStrong}" />
                        </HorizontalStackLayout>
                        <Label Style="{StaticResource CaptionLabel}"
                               Text="SurfacePage · SurfaceCard · SurfaceRaised · SurfaceSubtle · Outline · OutlineStrong" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- ============ Bläck ============ -->
            <VerticalStackLayout Spacing="8">
                <Label Style="{StaticResource SectionLabel}" Text="Bläck och semantik" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="6">
                        <Label Style="{StaticResource BodyLabel}" Text="TextPrimary — rubriker och värden" />
                        <Label Style="{StaticResource BodySecondaryLabel}" Text="TextSecondary — metadata och etiketter" />
                        <Label Style="{StaticResource BodyLabel}" TextColor="{DynamicResource AccentAction}" Text="AccentAction — primär handling" />
                        <Label Style="{StaticResource BodyLabel}" TextColor="{DynamicResource SignalUrgent}" Text="SignalUrgent — live, sista dygnet, tapp mot vinnaren" />
                        <Label Style="{StaticResource BodyLabel}" TextColor="{DynamicResource PositiveDelta}" Text="PositiveDelta — vinst, +0:14" />
                        <Label Style="{StaticResource BodyLabel}" TextColor="{DynamicResource NegativeDelta}" Text="NegativeDelta — tapp, −1:07" />
                        <Label Style="{StaticResource BodyLabel}" TextColor="{DynamicResource EstimateInk}" Text="EstimateInk — modellerat, ej observerat" />
                        <Label Style="{StaticResource BodyLabel}" TextColor="{DynamicResource LinkInk}" Text="LinkInk — länk ut ur en text" />
                        <Label Style="{StaticResource BodyLabel}" TextColor="{DynamicResource MapInk}" Text="MapInk — kartidentitet (dekor, ej text-AA)" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- ============ Dekorytor ============ -->
            <VerticalStackLayout Spacing="8">
                <Label Style="{StaticResource SectionLabel}" Text="Dekor och identitet" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="10">
                            <BoxView WidthRequest="40" HeightRequest="40" CornerRadius="8" Color="{DynamicResource SkeletonBase}" />
                            <BoxView WidthRequest="40" HeightRequest="40" CornerRadius="20" Color="{DynamicResource AvatarBackground}" />
                            <BoxView WidthRequest="40" HeightRequest="40" CornerRadius="8" Color="{DynamicResource HeroScrim}" />
                            <BoxView WidthRequest="40" HeightRequest="40" CornerRadius="8" Color="{DynamicResource BrandTint}" />
                        </HorizontalStackLayout>
                        <Label Style="{StaticResource CaptionLabel}"
                               Text="SkeletonBase · AvatarBackground · HeroScrim · BrandTint (temaoberoende: tabbar, ikon, splash)" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- ============ Mörk yta i båda temana ============ -->
            <VerticalStackLayout Spacing="8">
                <Label Style="{StaticResource SectionLabel}" Text="Live-kortets yta" />
                <Border Style="{StaticResource Card}"
                        BackgroundColor="{DynamicResource SurfaceLive}"
                        Stroke="Transparent">
                    <VerticalStackLayout Spacing="10">
                        <Border Style="{StaticResource Badge}"
                                BackgroundColor="{DynamicResource SignalOnDark}"
                                HorizontalOptions="Start">
                            <Label Style="{StaticResource BadgeLabel}"
                                   TextColor="{DynamicResource TextOnSignalDark}"
                                   Text="Live nu" />
                        </Border>
                        <Label Style="{StaticResource Heading1Label}"
                               TextColor="{DynamicResource TextOnDark}"
                               Text="TextOnDark — rubrik på mörk yta" />
                        <Label Style="{StaticResource BodyLabel}"
                               TextColor="{DynamicResource TextOnDarkMuted}"
                               Text="TextOnDarkMuted — arrangör, distrikt, antal löpare" />
                        <Button Text="SurfaceLiveAction + TextOnLiveAction"
                                Style="{StaticResource PrimaryButton}"
                                BackgroundColor="{DynamicResource SurfaceLiveAction}"
                                TextColor="{DynamicResource TextOnLiveAction}" />
                        <BoxView HeightRequest="24" CornerRadius="4" Color="{DynamicResource TopoInk}" />
                        <Label Style="{StaticResource CaptionLabel}"
                               TextColor="{DynamicResource TextOnDarkMuted}"
                               Text="TopoInk — banmärket i bakgrunden, aldrig bärare av mening" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- ============ Typografi ============ -->
            <VerticalStackLayout Spacing="8">
                <Label Style="{StaticResource SectionLabel}" Text="Typografi" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource DisplayLabel}" Text="Display 28" />
                        <Label Style="{StaticResource Heading1Label}" Text="Heading 1 · 22" />
                        <Label Style="{StaticResource Heading2Label}" Text="Heading 2 · 17" />
                        <Label Style="{StaticResource BodyLabel}" Text="Body 15 — Norrlandsmästerskapen, Hemlingby, Gävle" />
                        <Label Style="{StaticResource CaptionLabel}" Text="Caption 13 — arrangör och distrikt" />
                        <Label Style="{StaticResource SectionLabel}" Text="Micro 11 · sektionsetikett" />
                        <Label Style="{StaticResource LinkActionLabel}" Text="Visa kalender ›" />
                        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="20">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Style="{StaticResource StatValueLabel}" Text="33" />
                                <Label Style="{StaticResource StatCaptionLabel}" Text="Placering" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Style="{StaticResource StatValueLabel}" Text="1:12:48" />
                                <Label Style="{StaticResource StatCaptionLabel}" Text="Tid" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Hjälten sätts på sin egen mörka yta: stilarna är vita och syns inte på kort. -->
                <Border Style="{StaticResource Card}"
                        BackgroundColor="{DynamicResource SurfaceLive}"
                        Stroke="Transparent">
                    <VerticalStackLayout Spacing="2">
                        <Label Style="{StaticResource HeroGreetingLabel}" Text="Hej Jonatan" />
                        <Label Style="{StaticResource HeroMetaLabel}" Text="måndag 24 augusti" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- ============ Tabulära siffror ============ -->
            <VerticalStackLayout Spacing="8">
                <Label Style="{StaticResource SectionLabel}" Text="Tabulära siffror" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Label Style="{StaticResource CaptionLabel}"
                               Text="Kolumnerna nedan ska ligga still. Vänster: proportionella siffror (fel). Höger: tabulära (rätt)." />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Style="{StaticResource BodyLabel}" Text="31:12" />
                                <Label Style="{StaticResource BodyLabel}" Text="11:11" />
                                <Label Style="{StaticResource BodyLabel}" Text="48:07" />
                                <Label Style="{StaticResource BodyLabel}" Text="1:04:59" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Style="{StaticResource NumericLabel}" Text="31:12" />
                                <Label Style="{StaticResource NumericLabel}" Text="11:11" />
                                <Label Style="{StaticResource NumericLabel}" Text="48:07" />
                                <Label Style="{StaticResource NumericLabel}" Text="1:04:59" />
                            </VerticalStackLayout>
                        </Grid>
                        <HorizontalStackLayout Spacing="8" VerticalOptions="End">
                            <Label Style="{StaticResource DisplayNumberLabel}" Text="3:a" />
                            <Label Style="{StaticResource NumericCaptionLabel}"
                                   TextColor="{DynamicResource PositiveDelta}"
                                   VerticalOptions="End" Margin="0,0,0,6" Text="+2 mot prognos" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- ============ Chips ============ -->
            <VerticalStackLayout Spacing="8">
                <Label Style="{StaticResource SectionLabel}" Text="Snabbfilter" />
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="8">
                        <Border Style="{StaticResource ChipSelected}">
                            <Label Style="{StaticResource ChipSelectedLabel}" Text="För dig" />
                        </Border>
                        <Border Style="{StaticResource Chip}">
                            <Label Style="{StaticResource ChipLabel}" Text="Nära" />
                        </Border>
                        <Border Style="{StaticResource Chip}">
                            <Label Style="{StaticResource ChipLabel}" Text="Gästrikland" />
                        </Border>
                        <Border Style="{StaticResource Chip}">
                            <Label Style="{StaticResource ChipLabel}" Text="Större" />
                        </Border>
                        <Border Style="{StaticResource Chip}">
                            <Label Style="{StaticResource ChipLabel}" Text="Denna vecka" />
                        </Border>
                    </HorizontalStackLayout>
                </ScrollView>
            </VerticalStackLayout>

            <!-- ============ Badges ============ -->
            <VerticalStackLayout Spacing="8">
                <Label Style="{StaticResource SectionLabel}" Text="Statusbadges" />
                <Border Style="{StaticResource Card}">
                    <HorizontalStackLayout Spacing="8">
                        <Border Style="{StaticResource BadgePositive}">
                            <Label Style="{StaticResource BadgeOnFillLabel}" Text="Anmäld" />
                        </Border>
                        <Border Style="{StaticResource BadgeLive}">
                            <Label Style="{StaticResource BadgeOnSignalLabel}" Text="Live" />
                        </Border>
                        <Border Style="{StaticResource BadgeAccent}">
                            <Label Style="{StaticResource BadgeAccentLabel}" Text="PM" />
                        </Border>
                        <Border Style="{StaticResource Badge}">
                            <Label Style="{StaticResource BadgeLabel}" Text="Grupp" />
                        </Border>
                    </HorizontalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- ============ Knappar ============ -->
            <VerticalStackLayout Spacing="8">
                <Label Style="{StaticResource SectionLabel}" Text="Handlingar" />
                <Button Style="{StaticResource PrimaryButton}" Text="Anmäl dig" />
                <Button Style="{StaticResource SecondaryButton}" Text="Läs PM" />
            </VerticalStackLayout>

            <!-- ============ Komponenter (etapp B) ============ -->
            <VerticalStackLayout Spacing="8">
                <Label Style="{StaticResource SectionLabel}" Text="IdentityView" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="12">
                            <IdentityView Size="48" Source="terrain_long_skog.jpg" />
                            <IdentityView Size="48" Fallback="EN" />
                            <IdentityView Size="28" Shape="Rounded" Source="terrain_sprint_urban.jpg" />
                            <IdentityView Size="28" Shape="Rounded" Fallback="GK" />
                            <IdentityView Size="48" />
                        </HorizontalStackLayout>
                        <Label Style="{StaticResource CaptionLabel}"
                               Text="Bild · initialer · klubbmärke · klubb utan märke. Den femte har varken bild eller initialer och kollapsar — en tom cirkel läser som trasig data (P8)." />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Style="{StaticResource SectionLabel}" Text="ListRow" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <ListRow Primary="Elin Norberg" Secondary="OK Gästrike" Value="38:33" ValueDetail="+1:07">
                            <ListRow.Identity>
                                <IdentityView Size="36" Fallback="EN" />
                            </ListRow.Identity>
                        </ListRow>
                        <BoxView Style="{StaticResource Divider}" />
                        <ListRow Primary="Johan Sandberg" Secondary="Gävle OK" Value="37:26" ValueDetail="vinnare">
                            <ListRow.Identity>
                                <IdentityView Size="36" Shape="Rounded" Source="terrain_middle_skog.jpg" />
                            </ListRow.Identity>
                        </ListRow>
                        <BoxView Style="{StaticResource Divider}" />
                        <ListRow Primary="Utan identitet och utan pil"
                                 Secondary="Kolumnbredderna får skilja, ordningen aldrig"
                                 Value="4" ShowChevron="False" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Style="{StaticResource SectionLabel}" Text="SegmentBar" />
                <SegmentBar ItemsSource="{Binding Segments}"
                            SelectedValue="{Binding SelectedSegment}"
                            Command="{Binding SelectSegmentCommand}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Style="{StaticResource SectionLabel}" Text="HeroImage" />
                <HeroImage Discipline="long" Terrain="fjall" HeightRequest="160" />
                <Label Style="{StaticResource CaptionLabel}"
                       Text="Uppslag på disciplin + terräng, med scrim i underkanten. Utan träff visas fallbacken:" />
                <HeroImage Discipline="okänd" HeightRequest="80">
                    <HeroImage.Fallback>
                        <Border Style="{StaticResource Card}">
                            <Label Style="{StaticResource BodySecondaryLabel}"
                                   HorizontalOptions="Center" VerticalOptions="Center"
                                   Text="Kartrutan — den som är sann geografi" />
                        </Border>
                    </HeroImage.Fallback>
                </HeroImage>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Style="{StaticResource SectionLabel}" Text="StateView — fyra lägen" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <StateView State="Loading">
                            <StateView.Skeleton>
                                <VerticalStackLayout Spacing="8">
                                    <BoxView HeightRequest="14" CornerRadius="4" WidthRequest="220"
                                             HorizontalOptions="Start"
                                             Color="{DynamicResource SkeletonBase}" />
                                    <BoxView HeightRequest="14" CornerRadius="4" WidthRequest="160"
                                             HorizontalOptions="Start"
                                             Color="{DynamicResource SkeletonBase}" />
                                </VerticalStackLayout>
                            </StateView.Skeleton>
                        </StateView>
                        <BoxView Style="{StaticResource Divider}" />
                        <StateView State="Content">
                            <StateView.Body>
                                <Label Style="{StaticResource BodyLabel}" Text="Innehållet, när det finns." />
                            </StateView.Body>
                        </StateView>
                        <BoxView Style="{StaticResource Divider}" />
                        <StateView State="Empty"
                                   EmptyMessage="Inga resultat än"
                                   EmptyHint="De dyker upp när tävlingen är klar." />
                        <BoxView Style="{StaticResource Divider}" />
                        <StateView State="Error"
                                   ErrorMessage="Kunde inte läsa resultaten"
                                   ErrorDetail="Sparade tävlingar och PM fungerar fortfarande."
                                   RetryCommand="{Binding ToggleThemeCommand}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Style="{StaticResource SectionLabel}" Text="HandoffCard" />
                <HandoffCard Title="Anmäl dig"
                             Destination="Eventors sida"
                             Transfers="Din klass D21 följer med"
                             StaysInApp="True" />
                <HandoffCard Title="Bana och vägval"
                             Destination="Livelox"
                             Transfers="Öppnas utanför appen" />
            </VerticalStackLayout>


            <!-- Tabbaren flyter ovanpå innehållet, så sidan betalar för dess höjd själv. -->
            <BoxView HeightRequest="{StaticResource ListBottomSpacer}"
                     Margin="{Binding SafeAreaInsets}"
                     Color="Transparent" />

        </VerticalStackLayout>
    </ScrollView>

</SpinePage>
