<SpinePage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Orientera.Features.Events.EventDetailsPage"
    x:TypeArguments="EventDetailsPageViewModel"
    xmlns:events="clr-namespace:Orientera.Features.Events"
    x:DataType="EventDetailsPageViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource ScreenPadding}" Spacing="20">

            <!--
                Offline är ett designat läge: det cachade paketet visas med sin tidsstämpel,
                inte en spinner och inte tyst gammal data.
            -->
            <Border Style="{StaticResource BadgeAccent}"
                    HorizontalOptions="Fill"
                    Padding="12,8"
                    IsVisible="{Binding IsFromCache}">
                <Label Style="{StaticResource CaptionStrongLabel}"
                       TextColor="{DynamicResource AccentAction}"
                       Text="{Binding CacheLabel}" />
            </Border>

            <VerticalStackLayout Spacing="6" IsVisible="{Binding IsUnavailable}">
                <Label Style="{StaticResource Heading2Label}" Text="Kunde inte hämta tävlingen" />
                <Label Style="{StaticResource BodySecondaryLabel}"
                       Text="Ingen anslutning, och tävlingen finns inte sparad offline. Den sparas automatiskt när du är anmäld, följer den eller favoritmarkerar den." />
            </VerticalStackLayout>

            <!--
                Stjärnan delar rad med den korta metaraden, inte med titeln. Ett 44 pt-mål
                bredvid rubriken kapade textkolumnen så att "Norrlandsmästerskapen" bröts mitt
                i ordet.
            -->
            <VerticalStackLayout Spacing="4">
                <Grid ColumnDefinitions="*,44" ColumnSpacing="12">
                    <Label Grid.Column="0"
                           Style="{StaticResource SectionLabel}"
                           VerticalOptions="Center"
                           Text="{Binding MetaLine}" />

                    <Label Grid.Column="1"
                           Style="{StaticResource Heading1Label}"
                           SemanticProperties.HeadingLevel="None"
                           TextColor="{DynamicResource AccentAction}"
                           WidthRequest="44" HeightRequest="44"
                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                           SemanticProperties.Description="{Binding FavouriteDescription}"
                           Text="{Binding FavouriteGlyph}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleFavouriteCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <Label Style="{StaticResource DisplayLabel}" SemanticProperties.HeadingLevel="Level1"
                       Text="{Binding Name}" />
                <HorizontalStackLayout Spacing="7">
                    <Border Style="{StaticResource ClubBadge}" IsVisible="{Binding HasOrganiserLogo}">
                        <Image WidthRequest="18" HeightRequest="18"
                               AutomationProperties.IsInAccessibleTree="False"
                               Source="{Binding OrganiserLogo}" />
                    </Border>
                    <Label Style="{StaticResource BodySecondaryLabel}" Text="{Binding OrganiserLine}" />
                </HorizontalStackLayout>
                <Label Style="{StaticResource NumericStrongLabel}" Text="{Binding DateLine}" />
            </VerticalStackLayout>

            <!-- ============ För dig ============ -->
            <VerticalStackLayout Spacing="8">
                <!-- Var ligger tävlingen? En tävling är en plats innan den är något annat. -->
                <VerticalStackLayout Spacing="4" IsVisible="{Binding HasArena}">
                    <Border Stroke="{DynamicResource Outline}" StrokeThickness="1" Padding="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <events:ArenaMap HeightRequest="170" Arena="{Binding Arena}" />
                    </Border>
                </VerticalStackLayout>

                <Label Style="{StaticResource SectionLabel}" Text="För dig" />

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">

                        <HorizontalStackLayout Spacing="8">
                            <Border Style="{StaticResource BadgeAccent}">
                                <Label Style="{StaticResource BadgeAccentLabel}" Text="{Binding StateText}" />
                            </Border>
                            <Border Style="{StaticResource Badge}">
                                <Label Style="{StaticResource BadgeLabel}" Text="{Binding MyClass}" />
                            </Border>
                        </HorizontalStackLayout>

                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="10">
                            <VerticalStackLayout Grid.Row="0" Grid.Column="0" IsVisible="{Binding HasMyStart}">
                                <Label Style="{StaticResource CaptionLabel}" Text="Min start" />
                                <Label Style="{StaticResource NumericHeading2Label}" Text="{Binding MyStartText}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="0" Grid.Column="{Binding TravelColumn}" Grid.ColumnSpan="{Binding TravelColumnSpan}">
                                <Label Style="{StaticResource CaptionLabel}" Text="Resa" />
                                <!-- Uppskattat, inte uppmätt: EstimateInk säger samma sak som bomtiden i Analys. -->
                                <Label Style="{StaticResource NumericStrongLabel}"
                                       TextColor="{DynamicResource EstimateInk}"
                                       SemanticProperties.Description="{Binding TravelSpoken}"
                                       Text="{Binding TravelDurationText}" />
                                <Label Style="{StaticResource CaptionLabel}"
                                       SemanticProperties.Description=""
                                       Text="{Binding TravelText}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                 IsVisible="{Binding HasDeadline}">
                                <Label Style="{StaticResource CaptionLabel}" Text="Deadline" />
                                <Label Style="{StaticResource BodyStrongLabel}" Text="{Binding DeadlineText}" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Prediction är modellerad data och märks som sådan -->
                        <Border Style="{StaticResource Badge}"
                                HorizontalOptions="Start"
                                IsVisible="{Binding HasPrediction}"
                                BackgroundColor="Transparent"
                                Padding="0"
                                SemanticProperties.Description="{Binding PredictionAccessibility}"
                                SemanticProperties.Hint="Förklarar vad prognosen bygger på">
                            <HorizontalStackLayout Spacing="6">
                                <Label Style="{StaticResource BodyStrongLabel}"
                                       TextColor="{DynamicResource EstimateInk}"
                                       Text="{Binding PredictionText}" />
                                <Label Style="{StaticResource CaptionLabel}"
                                       TextColor="{DynamicResource EstimateInk}"
                                       VerticalOptions="Center"
                                       Text="ⓘ uppskattning" />
                            </HorizontalStackLayout>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenPredictionCommand}" />
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- En primär CTA per vy, satt av Context Engine -->
                        <Button Style="{StaticResource PrimaryButton}"
                                IsVisible="{Binding HasPrimaryAction}"
                                Text="{Binding PrimaryActionText}"
                                Command="{Binding PrimaryActionCommand}" />

                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- ============ Snabbhandlingar ============ -->
            <VerticalStackLayout Spacing="8">
                <Label Style="{StaticResource SectionLabel}" Text="Snabbhandlingar" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Style="{StaticResource SecondaryButton}" Text="Klass"
                            Command="{Binding OpenChooseClassCommand}" />
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Text="Live"
                            IsEnabled="{Binding CanFollowLive}" Command="{Binding OpenLiveCommand}" />
                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Text="Resultat"
                            IsEnabled="{Binding HasResults}" Command="{Binding OpenResultsCommand}" />
                </Grid>
            </VerticalStackLayout>

            <!-- ============ PM-briefing ============ -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding HasBriefing}">
                <Label Style="{StaticResource SectionLabel}" Text="Det viktigaste ur PM" />

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Briefing}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="BriefingItem">
                                <VerticalStackLayout Spacing="2">
                                    <Label Style="{StaticResource CaptionLabel}" Text="{Binding Label}" />
                                    <Label Style="{StaticResource BodyStrongLabel}" Text="{Binding Value}" />
                                    <HorizontalStackLayout Spacing="6">
                                        <Border Style="{StaticResource Badge}">
                                            <Label Style="{StaticResource BadgeLabel}" Text="{Binding Source}" />
                                        </Border>
                                        <Border Style="{StaticResource Badge}" IsVisible="{Binding IsUncertain}">
                                            <Label Style="{StaticResource BadgeLabel}"
                                                   TextColor="{DynamicResource EstimateInk}"
                                                   Text="Osäker tolkning" />
                                        </Border>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- ============ Tävlingsinfo ============ -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding HasBriefing}">
                <Label Style="{StaticResource SectionLabel}" Text="Tävlingsinfo" />

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Facts}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="BriefingItem">
                                <Grid ColumnDefinitions="120,*" ColumnSpacing="12">
                                    <Label Grid.Column="0" Style="{StaticResource CaptionLabel}" Text="{Binding Label}" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="1">
                                        <Label Style="{StaticResource BodyLabel}" Text="{Binding Value}" />
                                        <Label Style="{StaticResource CaptionLabel}" Text="{Binding Source}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- ============ Dokument ============ -->
            <!-- Livelox äger kartorna och vägvalen; appen erbjuder dörren och säger vems huset är -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding HasLivelox}">
                <Label Style="{StaticResource SectionLabel}" Text="Vägval" />

                <Border Style="{StaticResource Card}" Padding="14,12"
                        SemanticProperties.Hint="Öppnas i Livelox utanför appen">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="1">
                            <Label Style="{StaticResource BodyStrongLabel}" Text="{Binding LiveloxText}" />
                            <Label Style="{StaticResource CaptionLabel}"
                                   Text="Kartor och rutter visas av Livelox" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1"
                               Style="{StaticResource BodyLabel}"
                               TextColor="{DynamicResource TextSecondary}"
                               VerticalOptions="Center"
                               AutomationProperties.IsInAccessibleTree="False"
                               Text="&#x2197;&#xFE0E;" />
                    </Grid>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenLiveloxCommand}" />
                    </Border.GestureRecognizers>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8" IsVisible="{Binding HasDocuments}">
                <Label Style="{StaticResource SectionLabel}" Text="Dokument" />

                <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Documents}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="DocumentItem">
                            <Border Style="{StaticResource Card}" Padding="14,12"
                                    SemanticProperties.Description="{Binding Accessibility}"
                                    SemanticProperties.Hint="Öppnas utanför appen">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0" Spacing="1">
                                        <Label Style="{StaticResource BodyStrongLabel}" Text="{Binding Title}" />
                                        <Label Style="{StaticResource CaptionLabel}" Text="{Binding Meta}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1"
                                           Style="{StaticResource BodyLabel}"
                                           TextColor="{DynamicResource TextSecondary}"
                                           VerticalOptions="Center"
                                           AutomationProperties.IsInAccessibleTree="False"
                                           Text="&#x2197;&#xFE0E;" />
                                </Grid>

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ScrollView}}, Path=BindingContext.OpenExternalCommand}"
                                        CommandParameter="{Binding Url}" />
                                </Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</SpinePage>
