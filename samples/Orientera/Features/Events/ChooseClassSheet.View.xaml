<SpinePage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Orientera.Features.Events.ChooseClassSheet"
    x:TypeArguments="ChooseClassSheetViewModel"
    x:DataType="ChooseClassSheetViewModel">

    <Grid RowDefinitions="Auto,*">

        <Label Grid.Row="0"
               Style="{StaticResource CaptionLabel}"
               Padding="16,0,16,10"
               Text="{Binding Explanation}" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,0,16,16" Spacing="16">

                <VerticalStackLayout Spacing="8" IsVisible="{Binding HasAgeClasses}">
                    <Label Style="{StaticResource SectionLabel}" Text="Åldersklasser" />
                    <Border Style="{StaticResource Card}" Padding="16,6">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding AgeClasses}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="ClassRow">
                                    <ListRow Primary="{Binding Name}"
                                             Value="{Binding Check}"
                                             Description="{Binding Accessibility}"
                                             ShowChevron="False"
                                             Command="{Binding Source={RelativeSource AncestorType={x:Type ScrollView}}, Path=BindingContext.ChooseCommand}"
                                             CommandParameter="{Binding Name}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8" IsVisible="{Binding HasCourses}">
                    <Label Style="{StaticResource SectionLabel}" Text="Banor" />
                    <Border Style="{StaticResource Card}" Padding="16,6">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Courses}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="ClassRow">
                                    <ListRow Primary="{Binding Name}"
                                             Value="{Binding Check}"
                                             Description="{Binding Accessibility}"
                                             ShowChevron="False"
                                             Command="{Binding Source={RelativeSource AncestorType={x:Type ScrollView}}, Path=BindingContext.ChooseCommand}"
                                             CommandParameter="{Binding Name}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</SpinePage>
