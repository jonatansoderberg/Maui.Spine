<SpinePage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Orientera.Features.Events.EventorEntrySheet"
    x:TypeArguments="EventorEntrySheetViewModel"
    x:DataType="EventorEntrySheetViewModel">

    <Grid RowDefinitions="Auto,*,Auto">

        <Label Grid.Row="0"
               Style="{StaticResource CaptionLabel}"
               Padding="16,4,16,10"
               Text="{Binding SessionText}" />

        <!--
            Eventors egen anmälningssida, i appens web view — där sessionen finns. Sidhuvud, meny
            och annonsytor döljs efter varje navigering (se EventorEntryChrome); själva formuläret
            och allt Eventor gör med det är orört.
        -->
        <WebView x:Name="Form" Grid.Row="1" Source="{Binding EntryUrl}" />

        <Button Grid.Row="2"
                Style="{StaticResource SecondaryButton}"
                Margin="16,10"
                Text="Klar"
                Command="{Binding CloseCommand}" />
    </Grid>
</SpinePage>
