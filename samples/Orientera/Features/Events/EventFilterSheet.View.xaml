<SpinePage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Orientera.Features.Events.EventFilterSheet"
    x:TypeArguments="EventFilterSheetViewModel"
    x:DataType="EventFilterSheetViewModel">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <!--
                Överkanten lämnar plats åt arkets egen stängningsknapp. Innehållet flyter under
                arkets krom, och första sektionens chevron hamnar annars rakt under krysset.
            -->
            <VerticalStackLayout Padding="16,36,16,16" Spacing="4">

                <!--
                    Fem hopfällda grupper i stället för fyra Picker och fem vågräta rullningar.
                    Var grupp säger i sitt huvud vad som är valt, så inget som är satt göms — bara
                    de tjugofyra chippen det valdes ur. Utfälld radbryter WrapLayout dem: alla på
                    skärmen samtidigt, ingen sidled att svepa i.
                -->

                <FilterSection Title="Distrikt" Summary="{Binding DistrictGroup.Summary}"
                               IsVisible="{Binding HasDistricts}">
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource CaptionLabel}" Text="{Binding DistrictHint}" />
                        <WrapLayout Spacing="8" LineSpacing="8"
                                    BindableLayout.ItemsSource="{Binding DistrictGroup.Options}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="ChipOption">
                                    <ChipView IsCompact="True"
                                              Text="{Binding Label}"
                                              IsSelected="{Binding IsSelected}"
                                              Command="{Binding ToggleCommand}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </WrapLayout>
                    </VerticalStackLayout>
                </FilterSection>

                <BoxView Style="{StaticResource Divider}" />

                <FilterSection Title="Tidsintervall" Summary="{Binding PeriodGroup.Summary}">
                    <WrapLayout Spacing="8" LineSpacing="8"
                                BindableLayout.ItemsSource="{Binding PeriodGroup.Options}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="ChipOption">
                                <ChipView IsCompact="True"
                                          Text="{Binding Label}"
                                          IsSelected="{Binding IsSelected}"
                                          Command="{Binding ToggleCommand}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </WrapLayout>
                </FilterSection>

                <BoxView Style="{StaticResource Divider}" />

                <FilterSection Title="Tävlingsnivå" Summary="{Binding LevelGroup.Summary}">
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource CaptionLabel}" Text="Flera går att välja." />
                        <WrapLayout Spacing="8" LineSpacing="8"
                                    BindableLayout.ItemsSource="{Binding LevelGroup.Options}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="ChipOption">
                                    <ChipView IsCompact="True"
                                              Text="{Binding Label}"
                                              IsSelected="{Binding IsSelected}"
                                              Command="{Binding ToggleCommand}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </WrapLayout>
                    </VerticalStackLayout>
                </FilterSection>

                <BoxView Style="{StaticResource Divider}" />

                <!--
                    Grenen är en egen axel, inte ett av distansens värden. "Sprint" svarar på hur
                    långt; "MTBO" på vad man tar sig fram med.
                -->
                <FilterSection Title="Gren" Summary="{Binding SportGroup.Summary}">
                    <WrapLayout Spacing="8" LineSpacing="8"
                                BindableLayout.ItemsSource="{Binding SportGroup.Options}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="ChipOption">
                                <ChipView IsCompact="True"
                                          Text="{Binding Label}"
                                          IsSelected="{Binding IsSelected}"
                                          Command="{Binding ToggleCommand}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </WrapLayout>
                </FilterSection>

                <BoxView Style="{StaticResource Divider}" />

                <FilterSection Title="Disciplin" Summary="{Binding DisciplineGroup.Summary}">
                    <WrapLayout Spacing="8" LineSpacing="8"
                                BindableLayout.ItemsSource="{Binding DisciplineGroup.Options}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="ChipOption">
                                <ChipView IsCompact="True"
                                          Text="{Binding Label}"
                                          IsSelected="{Binding IsSelected}"
                                          Command="{Binding ToggleCommand}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </WrapLayout>
                </FilterSection>

                <BoxView Style="{StaticResource Divider}" />

                <!-- Avståndet är det Eventor inte kan: kalendern där vet inte var man bor. -->
                <FilterSection Title="Avstånd hemifrån" Summary="{Binding DistanceSummary}">
                    <VerticalStackLayout Spacing="4">
                        <!--
                            Reglaget läser upp sitt värde som andel av skalan, inte som mil. Därför
                            bär det avståndet i ord i stället, och uppdaterar dem medan det dras.
                        -->
                        <Slider Minimum="5" Maximum="200"
                                Value="{Binding DistanceKm}"
                                MinimumTrackColor="{DynamicResource AccentAction}"
                                ThumbColor="{DynamicResource AccentAction}"
                                SemanticProperties.Description="Avstånd hemifrån"
                                SemanticProperties.Hint="{Binding DistanceSummary}" />

                        <Grid ColumnDefinitions="*,*">
                            <Label Style="{StaticResource CaptionLabel}" Text="5 km" />
                            <Label Grid.Column="1" Style="{StaticResource CaptionLabel}"
                                   HorizontalTextAlignment="End" Text="Alla" />
                        </Grid>
                    </VerticalStackLayout>
                </FilterSection>

                <BoxView Style="{StaticResource Divider}" />

                <VerticalStackLayout Spacing="4" Margin="0,8,0,0">
                    <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="44">
                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                            <Label Style="{StaticResource BodyLabel}" Text="Visa träningar" />
                            <Label Style="{StaticResource CaptionLabel}" Text="Motion och återkommande träning" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" VerticalOptions="Center" IsToggled="{Binding ShowTraining}" />
                    </Grid>

                    <BoxView Style="{StaticResource Divider}" />

                    <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="44">
                        <Label Grid.Column="0" Style="{StaticResource BodyLabel}"
                               VerticalOptions="Center" Text="Endast där min klass finns" />
                        <Switch Grid.Column="1" VerticalOptions="Center" IsToggled="{Binding OnlyMyClass}" />
                    </Grid>

                    <BoxView Style="{StaticResource Divider}" />

                    <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="44">
                        <Label Grid.Column="0" Style="{StaticResource BodyLabel}"
                               VerticalOptions="Center" Text="Endast anmälningsbara" />
                        <Switch Grid.Column="1" VerticalOptions="Center" IsToggled="{Binding OnlyRegisterable}" />
                    </Grid>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="1" Padding="16,8,16,16" Spacing="8">
            <!--
                Knappen räknar. Eventor har sin kalender kvar bakom filterlådan; ett ark kan inte
                det, så antalet står här — och det är det enda som fångar en kombination som inte
                ger något innan man stängt arket för att se det.
            -->
            <Button Style="{StaticResource PrimaryButton}"
                    Text="{Binding ApplyLabel}"
                    Command="{Binding ApplyCommand}" />
            <Button Style="{StaticResource SecondaryButton}" Text="Rensa filter" Command="{Binding ClearCommand}" />
        </VerticalStackLayout>

    </Grid>

</SpinePage>
