<SpinePage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Orientera.Features.Events.Participants.ParticipantsPage"
    x:TypeArguments="ParticipantsPageViewModel"
    x:DataType="ParticipantsPageViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">

        <!-- Vilken tävling, och hur färsk listan är -->
        <VerticalStackLayout Grid.Row="0" Padding="16,4,16,8" Spacing="4">
            <Label Style="{StaticResource Heading2Label}"
                   SemanticProperties.HeadingLevel="Level1"
                   Text="{Binding CompetitionName}" />

            <HorizontalStackLayout Spacing="8">
                <Border Style="{StaticResource BadgeLive}" IsVisible="{Binding IsRunningNow}">
                    <Label Style="{StaticResource BadgeOnSignalLabel}" Text="Live" />
                </Border>
                <!--
                    Preliminärt är ett påstående om källan, inte en stilnyans (D11): samma läge
                    visar den publicerade listan och den som fylls på medan folk kommer i mål,
                    och skillnaden får aldrig bara ligga i färgen.
                -->
                <Border Style="{StaticResource Badge}" IsVisible="{Binding IsPreliminary}">
                    <Label Style="{StaticResource BadgeLabel}" Text="Preliminärt" />
                </Border>
                <Label Style="{StaticResource NumericCaptionLabel}"
                       VerticalOptions="Center"
                       IsVisible="{Binding UpdatedText.Length}"
                       Text="{Binding UpdatedText}" />
            </HorizontalStackLayout>

            <Border Style="{StaticResource BadgeAccent}"
                    HorizontalOptions="Fill" Padding="12,8"
                    IsVisible="{Binding IsFromCache}">
                <Label Style="{StaticResource CaptionStrongLabel}"
                       TextColor="{DynamicResource AccentAction}"
                       Text="{Binding CacheLabel}" />
            </Border>
        </VerticalStackLayout>

        <!-- Lägena: anmälda → startlista → live → resultat -->
        <SegmentBar Grid.Row="1" Margin="16,0,16,8"
                    IsVisible="{Binding HasCompetition}"
                    ItemsSource="{Binding Modes}"
                    SelectedValue="{Binding Mode}"
                    Command="{Binding SelectModeCommand}" />

        <!-- Urvalet inuti läget, och startlistans egen ordning -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Padding="16,0,16,8" ColumnSpacing="8"
              IsVisible="{Binding HasCompetition}">
            <HorizontalStackLayout Spacing="8">
                <ChipView Text="Min grupp" IsSelected="{Binding IsMyGroup}"
                          IsVisible="{Binding CanScopeToGroup}"
                          Command="{Binding SelectScopeCommand}" CommandParameter="MyGroup" />
                <ChipView Text="Min klass" IsSelected="{Binding IsMyClass}"
                          Command="{Binding SelectScopeCommand}" CommandParameter="MyClass" />
                <!-- Klasschipet är en väljare: att trycka på det frågar alltid vilken klass -->
                <ChipView Text="{Binding ClassChipText}" IsSelected="{Binding IsClass}"
                          IsVisible="{Binding CanPickClass}"
                          Command="{Binding PickClassCommand}" />
            </HorizontalStackLayout>

            <!--
                "När går jag" och "vilka är fältet" är två frågor till samma lista. Växeln ligger
                i listans huvud i stället för som ett tredje chip: raden ovanför är redan två
                kontroller djup på en telefonskärm.
            -->
            <Label Grid.Column="1"
                   Style="{StaticResource CaptionStrongLabel}"
                   TextColor="{DynamicResource AccentAction}"
                   VerticalOptions="Center"
                   IsVisible="{Binding IsStartList}"
                   SemanticProperties.Hint="Byt listans ordning"
                   Text="{Binding SortText}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleSortCommand}" />
                </Label.GestureRecognizers>
            </Label>
        </Grid>

        <Label Grid.Row="3" Style="{StaticResource BodySecondaryLabel}"
               Padding="16,0,16,8"
               IsVisible="{Binding CaptionText.Length}"
               Text="{Binding CaptionText}" />

        <!-- Tomt läge är ett svar, inte ett väntrum (P10) -->
        <VerticalStackLayout Grid.Row="4" Padding="32" Spacing="8" VerticalOptions="Center"
                             IsVisible="{Binding IsEmpty}">
            <Label Style="{StaticResource Heading2Label}" SemanticProperties.HeadingLevel="Level2"
                   HorizontalTextAlignment="Center" Text="{Binding EmptyHeading}" />
            <Label Style="{StaticResource BodySecondaryLabel}" HorizontalTextAlignment="Center"
                   Text="{Binding EmptyMessage}" />
        </VerticalStackLayout>

        <!-- ============ Anmälda / Startlista / Resultat: en rad per löpare ============ -->
        <CollectionView Grid.Row="4"
                        ItemsSource="{Binding Groups}"
                        IsGrouped="True" SelectionMode="None"
                        IsVisible="{Binding IsList}">

            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="ParticipantClassGroup">
                    <Label Style="{StaticResource SectionLabel}"
                           Padding="16,14,16,6"
                           SemanticProperties.HeadingLevel="Level2"
                           Text="{Binding Name}" />
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <CollectionView.Footer>
                <VerticalStackLayout Padding="16,8,16,0" Spacing="12">
                    <!-- Livelox är en dörr och inget annat: kartor och vägval är deras (P11) -->
                    <HandoffCard IsVisible="{Binding HasLivelox}"
                                 Title="{Binding LiveloxText}"
                                 Destination="Livelox"
                                 Command="{Binding OpenLiveloxCommand}" />

                    <!-- Margin carries the tab bar's own height; the height is the breathing room. -->
                    <BoxView HeightRequest="{StaticResource ListBottomSpacer}"
                             Margin="{Binding SafeAreaInsets}"
                             Color="Transparent" />
                </VerticalStackLayout>
            </CollectionView.Footer>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="ParticipantRow">
                    <VerticalStackLayout>
                        <ListRow Padding="16,6"
                                 Primary="{Binding Name}"
                                 Secondary="{Binding Club}"
                                 Value="{Binding ValueText}"
                                 ValueDetail="{Binding ValueDetailText}"
                                 ShowChevron="{Binding CanOpen}"
                                 IsHighlighted="{Binding IsMe}"
                                 Description="{Binding Accessibility}"
                                 Command="{Binding Source={RelativeSource AncestorType={x:Type CollectionView}}, Path=BindingContext.OpenRunnerCommand}"
                                 CommandParameter="{Binding .}">
                            <ListRow.Identity>
                                <Grid WidthRequest="{StaticResource PlaceColumnWidth}">
                                    <Label Style="{StaticResource NumericStrongLabel}"
                                           HorizontalTextAlignment="Center"
                                           IsVisible="{Binding LeadText.Length}"
                                           Text="{Binding LeadText}" />
                                    <Label Style="{StaticResource Heading2Label}"
                                           HorizontalTextAlignment="Center"
                                           IsVisible="{Binding HasMedal}"
                                           Text="{Binding MedalText}" />
                                </Grid>
                            </ListRow.Identity>
                        </ListRow>
                        <BoxView Style="{StaticResource Divider}" Margin="16,0" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- ============ Live: en kolumn per radiokontroll ============ -->
        <ScrollView Grid.Row="4" x:Name="Table"
                    Orientation="Horizontal"
                    BackgroundColor="{DynamicResource SurfaceCard}"
                    IsVisible="{Binding IsLive}">

            <CollectionView WidthRequest="{Binding TableWidth}"
                            HeightRequest="{Binding Source={RelativeSource AncestorType={x:Type ScrollView}}, Path=Height}"
                            ItemsSource="{Binding Groups}"
                            IsGrouped="True" SelectionMode="None">

                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="ParticipantClassGroup">
                        <Grid ColumnDefinitions="156,*" Padding="0,14,0,6">

                            <HorizontalStackLayout Grid.Column="1"
                                                   BindableLayout.ItemsSource="{Binding Columns}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Label Style="{StaticResource SectionLabel}"
                                               WidthRequest="{Binding Source={RelativeSource AncestorType={x:Type CollectionView}}, Path=BindingContext.CellWidth}"
                                               Margin="0,0,10,0"
                                               HorizontalTextAlignment="End"
                                               Text="{Binding .}" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>

                            <Label Grid.Column="0"
                                   Style="{StaticResource SectionLabel}"
                                   Padding="16,0,0,0"
                                   BackgroundColor="{DynamicResource SurfaceCard}"
                                   TranslationX="{Binding Source={RelativeSource AncestorType={x:Type ScrollView}}, Path=ScrollX}"
                                   SemanticProperties.HeadingLevel="Level2"
                                   SemanticProperties.Description="{Binding Accessibility}"
                                   Text="{Binding Name}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>

                <CollectionView.Footer>
                    <BoxView HeightRequest="{StaticResource ListBottomSpacer}"
                             Margin="{Binding SafeAreaInsets}"
                             Color="Transparent" />
                </CollectionView.Footer>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="ParticipantRow">
                        <Grid ColumnDefinitions="156,*" RowDefinitions="Auto,Auto">

                            <Grid.Triggers>
                                <DataTrigger TargetType="Grid" Binding="{Binding IsMe}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource AccentSubtle}" />
                                </DataTrigger>
                            </Grid.Triggers>

                            <HorizontalStackLayout Grid.Column="1" Grid.Row="0"
                                                   Padding="0,7" VerticalOptions="Center"
                                                   BindableLayout.ItemsSource="{Binding Cells}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="ParticipantCell">
                                        <VerticalStackLayout Margin="0,0,10,0"
                                                             WidthRequest="{Binding Source={RelativeSource AncestorType={x:Type CollectionView}}, Path=BindingContext.CellWidth}"
                                                             SemanticProperties.Description="{Binding Accessibility}">
                                            <Label Style="{StaticResource NumericStrongLabel}"
                                                   HorizontalTextAlignment="End"
                                                   Text="{Binding TimeText}">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsLeading}" Value="True">
                                                        <Setter Property="TextColor" Value="{DynamicResource AccentAction}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            <Label Style="{StaticResource NumericCaptionLabel}"
                                                   HorizontalTextAlignment="End"
                                                   Text="{Binding DetailText}" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>

                            <!-- Namnkolumnen målas sist: kontrollerna scrollar in under den -->
                            <Grid Grid.Column="0" Grid.Row="0"
                                  Padding="16,7,8,7"
                                  BackgroundColor="{DynamicResource SurfaceCard}"
                                  TranslationX="{Binding Source={RelativeSource AncestorType={x:Type ScrollView}}, Path=ScrollX}"
                                  SemanticProperties.Description="{Binding Accessibility}">

                                <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                        <Label Style="{StaticResource BodyStrongLabel}"
                                               LineBreakMode="TailTruncation"
                                               Text="{Binding Name}" />
                                        <Label Grid.Column="1"
                                               Style="{StaticResource CaptionLabel}"
                                               TextColor="{DynamicResource AccentAction}"
                                               VerticalOptions="Center"
                                               Text="{Binding GroupGlyph}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5">
                                        <Border Style="{StaticResource ClubBadge}" IsVisible="{Binding HasClubLogo}">
                                            <Image WidthRequest="14" HeightRequest="14"
                                                   AutomationProperties.IsInAccessibleTree="False"
                                                   Source="{Binding ClubLogo}" />
                                        </Border>
                                        <Label Grid.Column="1"
                                               Style="{StaticResource CaptionLabel}"
                                               LineBreakMode="TailTruncation"
                                               Text="{Binding Club}" />
                                    </Grid>
                                    <Label Style="{StaticResource CaptionLabel}"
                                           IsVisible="{Binding HasStatus}"
                                           Text="{Binding StatusText}" />
                                </VerticalStackLayout>

                                <Grid.Triggers>
                                    <DataTrigger TargetType="Grid" Binding="{Binding IsMe}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource AccentSubtle}" />
                                    </DataTrigger>
                                </Grid.Triggers>
                            </Grid>

                            <BoxView Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Divider}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </ScrollView>

        <ActivityIndicator Grid.Row="4"
                           Style="{StaticResource PageLoading}"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}" />
    </Grid>

</SpinePage>
