<SpinePage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Orientera.Features.Events.EventsPage"
    x:TypeArguments="EventsPageViewModel"
    x:DataType="EventsPageViewModel">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Sökrutan står på sidan, inte i filterarket: man skriver och ser, utan att stänga något -->
        <!--
            En Entry och inte en SearchBar: iOS ritar UISearchBar med sin egen svarta bakgrund som
            inte viker sig för BackgroundColor, och en svart platta över appens yta är inte designen.
        -->
        <Entry Grid.Row="0"
               Margin="16,0,16,8"
               ClearButtonVisibility="WhileEditing"
               ReturnType="Search"
               Placeholder="Sök tävling, arrangör eller plats"
               SemanticProperties.Description="Sök bland tävlingar på namn, arrangör eller plats"
               Text="{Binding Query}" />

        <!-- Snabbfilter: en rad, horisontellt scrollbar, vald chip = accentfyllning -->
        <ScrollView Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never"
                    Padding="16,4,16,10">
            <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Chips}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="FilterChip">
                        <ChipView Text="{Binding Label}"
                                  IsSelected="{Binding IsSelected}"
                                  Command="{Binding Source={RelativeSource AncestorType={x:Type HorizontalStackLayout}}, Path=BindingContext.SelectChipCommand}"
                                  CommandParameter="{Binding .}" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Tomt läge är ett designat läge, inte en spinner -->
        <VerticalStackLayout Grid.Row="2"
                             Padding="32"
                             Spacing="8"
                             VerticalOptions="Center"
                             IsVisible="{Binding IsEmpty}">
            <Label Style="{StaticResource Heading2Label}"
                   SemanticProperties.HeadingLevel="Level2"
                   HorizontalTextAlignment="Center"
                   Text="Inget att visa" />
            <Label Style="{StaticResource BodySecondaryLabel}"
                   HorizontalTextAlignment="Center"
                   Text="{Binding EmptyMessage}" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Sections}"
                        IsGrouped="True"
                        SelectionMode="None"
                        IsVisible="{Binding HasCards}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
            </CollectionView.ItemsLayout>

            <CollectionView.Footer>
                <BoxView HeightRequest="{StaticResource ListBottomSpacer}" Color="Transparent" />
            </CollectionView.Footer>

            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="EventSection">
                    <!-- Vänsterkanten följer kortens, inte listans -->
                    <Label Style="{StaticResource SectionLabel}"
                           Padding="16,14,0,4"
                           SemanticProperties.Description="{Binding Accessibility}"
                           Text="{Binding Name}" />
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="EventCard">
                    <!--
                        Stjärnan ligger utanför kortets Border. Kortet är ett element för
                        skärmläsaren — annars blir varje kort sex svep — och en Description på
                        Bordern gör dess barn oåtkomliga på iOS. Favoritknappen måste därför
                        vara ett syskon för att gå att nå.
                    -->
                    <Grid Padding="16,0">
                        <Border Style="{StaticResource Card}"
                                SemanticProperties.Description="{Binding Accessibility}"
                                SemanticProperties.Hint="Öppnar tävlingen">
                            <Grid ColumnDefinitions="*,44" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="4">

                                <Label Grid.Row="0" Grid.Column="0"
                                       Style="{StaticResource SectionLabel}"
                                       Text="{Binding DateLabel}" />

                                <Label Grid.Row="1" Grid.Column="0"
                                       Style="{StaticResource Heading2Label}"
                                       Text="{Binding Title}" />

                                <VerticalStackLayout Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Spacing="2">
                                    <HorizontalStackLayout Spacing="6">
                                        <Border Style="{StaticResource ClubBadge}" IsVisible="{Binding HasOrganiserLogo}">
                                            <Image WidthRequest="15" HeightRequest="15"
                                                   AutomationProperties.IsInAccessibleTree="False"
                                                   Source="{Binding OrganiserLogo}" />
                                        </Border>
                                        <Label Style="{StaticResource CaptionLabel}" Text="{Binding PlaceLabel}" />
                                    </HorizontalStackLayout>
                                    <Label Style="{StaticResource CaptionLabel}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding MetaLabel}" />
                                                <Span Text=" · " />
                                                <Span Text="{Binding DistanceLabel}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>

                                <HorizontalStackLayout Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                                       Spacing="6" Margin="0,6,0,0">
                                    <Border Style="{StaticResource BadgeLive}" IsVisible="{Binding IsLive}">
                                        <Label Style="{StaticResource BadgeOnFillLabel}" Text="Live" />
                                    </Border>
                                    <Border Style="{StaticResource BadgePositive}" IsVisible="{Binding IsRegistered}">
                                        <Label Style="{StaticResource BadgeOnFillLabel}" Text="Anmäld" />
                                    </Border>
                                    <Border Style="{StaticResource Badge}" IsVisible="{Binding HasGroupEntry}">
                                        <Label Style="{StaticResource BadgeLabel}" Text="Min grupp" />
                                    </Border>
                                    <Border Style="{StaticResource Badge}" IsVisible="{Binding IsRecurring}">
                                        <Label Style="{StaticResource BadgeLabel}" Text="{Binding OccurrenceLabel}" />
                                    </Border>
                                    <Border Style="{StaticResource BadgeAccent}" IsVisible="{Binding ShowContextBadge}">
                                        <Label Style="{StaticResource BadgeAccentLabel}" Text="{Binding ContextLabel}" />
                                    </Border>
                                </HorizontalStackLayout>
                            </Grid>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type CollectionView}}, Path=BindingContext.OpenDetailsCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                        </Border>

                        <Label Style="{StaticResource Heading2Label}"
                               TextColor="{DynamicResource AccentAction}"
                               HorizontalOptions="End" VerticalOptions="Start"
                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                               WidthRequest="44" HeightRequest="44"
                               Margin="0,4,6,0"
                               SemanticProperties.Description="{Binding FavouriteDescription}"
                               Text="{Binding FavouriteGlyph}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type CollectionView}}, Path=BindingContext.ToggleFavouriteCommand}"
                                    CommandParameter="{Binding .}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</SpinePage>
