<SpinePage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Orientera.Features.Events.EventsPage"
    x:TypeArguments="EventsPageViewModel"
    x:DataType="EventsPageViewModel">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Sökrutan står på sidan, inte i filterarket: man skriver och ser, utan att stänga något -->
        <!--
            En Entry och inte en SearchBar: iOS ritar UISearchBar med sin egen svarta bakgrund som
            inte viker sig för BackgroundColor, och en svart platta över appens yta är inte designen.
        -->
        <Entry Grid.Row="0"
               Margin="16,0,16,8"
               ClearButtonVisibility="WhileEditing"
               ReturnType="Search"
               Placeholder="Sök tävling, arrangör eller plats"
               SemanticProperties.Description="Sök bland tävlingar på namn, arrangör eller plats"
               Text="{Binding Query}" />

        <!-- Snabbfilter: en rad, horisontellt scrollbar, vald chip = accentfyllning -->
        <ScrollView Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never"
                    Padding="16,4,16,10">
            <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Chips}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="FilterChip">
                        <ChipView Text="{Binding Label}"
                                  IsSelected="{Binding IsSelected}"
                                  Command="{Binding Source={RelativeSource AncestorType={x:Type HorizontalStackLayout}}, Path=BindingContext.SelectChipCommand}"
                                  CommandParameter="{Binding .}" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Tomt läge är ett designat läge, inte en spinner -->
        <VerticalStackLayout Grid.Row="2"
                             Padding="32"
                             Spacing="8"
                             VerticalOptions="Center"
                             IsVisible="{Binding IsEmpty}">
            <Label Style="{StaticResource Heading2Label}"
                   SemanticProperties.HeadingLevel="Level2"
                   HorizontalTextAlignment="Center"
                   Text="Inget att visa" />
            <Label Style="{StaticResource BodySecondaryLabel}"
                   HorizontalTextAlignment="Center"
                   Text="{Binding EmptyMessage}" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Sections}"
                        IsGrouped="True"
                        SelectionMode="None"
                        BackgroundColor="{DynamicResource SurfaceCard}"
                        IsVisible="{Binding HasCards}">
            <!-- Rader på en delad yta, inte ett kort per tävling: avdelarna bär listan. -->
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
            </CollectionView.ItemsLayout>

            <CollectionView.Footer>
                <!-- Margin carries the tab bar's own height; the height is the breathing room. -->
                <BoxView HeightRequest="{StaticResource ListBottomSpacer}"
                         Margin="{Binding SafeAreaInsets}"
                         Color="Transparent" />
            </CollectionView.Footer>

            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="EventSection">
                    <Label Style="{StaticResource SectionLabel}"
                           Padding="16,16,16,6"
                           SemanticProperties.Description="{Binding Accessibility}"
                           Text="{Binding Name}" />
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="EventCard">
                    <!--
                        Stjärnan ligger utanför radens Grid. Raden är ett element för
                        skärmläsaren — annars blir varje rad sex svep — och en Description på
                        radens layout gör dess barn oåtkomliga på iOS. Stjärnan måste därför
                        vara ett syskon för att gå att nå.
                    -->
                    <Grid RowDefinitions="Auto,Auto">
                        <Grid ColumnDefinitions="40,20,*,44" RowDefinitions="Auto,Auto,Auto"
                              ColumnSpacing="10" RowSpacing="2"
                              Padding="16,9,4,9"
                              SemanticProperties.Description="{Binding Accessibility}"
                              SemanticProperties.Hint="Öppnar tävlingen">

                            <!--
                                Datumryggraden. Ritas på raden där datumet byter och lämnas tom
                                under de tävlingar som delar den dagen; månaden på samma villkor
                                ett steg upp, eftersom "Mest relevant" varken har månad i
                                sektionshuvudet eller ordning i datumen.
                            -->
                            <VerticalStackLayout Grid.Row="0" Grid.RowSpan="3" Grid.Column="0"
                                                 Spacing="0"
                                                 IsVisible="{Binding ShowDate}">
                                <Label Style="{StaticResource NumericHeading2Label}"
                                       Text="{Binding DayLabel}" />
                                <Label Style="{StaticResource CaptionLabel}"
                                       Text="{Binding WeekdayLabel}" />
                                <Label Style="{StaticResource MicroLabel}"
                                       IsVisible="{Binding ShowMonth}"
                                       Text="{Binding MonthLabel}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="0" Grid.RowSpan="3" Grid.Column="1"
                                                 Spacing="4" Margin="0,3,0,0">
                                <Path Style="{StaticResource DisciplineGlyph}"
                                      Data="{Binding DisciplineShape}" />
                                <Path Style="{StaticResource LevelGlyph}"
                                      Data="{Binding LevelShape}"
                                      IsVisible="{Binding HasLevelShape}" />
                            </VerticalStackLayout>

                            <Label Grid.Row="0" Grid.Column="2"
                                   Style="{StaticResource BodyStrongLabel}"
                                   LineBreakMode="TailTruncation"
                                   Text="{Binding Title}" />

                            <!--
                                Avståndet står i egen kolumn i stället för sist i metameningen.
                                Det är relevanspremissen — det enda listan vet som Eventor inte
                                vet — och får inte vara det som trunkeras bort.
                            -->
                            <Grid Grid.Row="1" Grid.Column="2"
                                  ColumnDefinitions="20,*,Auto" ColumnSpacing="6">
                                <Border Grid.Column="0"
                                        Style="{StaticResource ClubBadge}"
                                        IsVisible="{Binding HasOrganiserLogo}">
                                    <Image WidthRequest="14" HeightRequest="14"
                                           AutomationProperties.IsInAccessibleTree="False"
                                           Source="{Binding OrganiserLogo}" />
                                </Border>
                                <Label Grid.Column="1"
                                       Style="{StaticResource CaptionLabel}"
                                       VerticalOptions="Center"
                                       LineBreakMode="TailTruncation"
                                       Text="{Binding MetaLine}" />
                                <Label Grid.Column="2"
                                       Style="{StaticResource NumericCaptionLabel}"
                                       VerticalOptions="Center"
                                       HorizontalTextAlignment="End"
                                       Text="{Binding DistanceLabel}" />
                            </Grid>

                            <HorizontalStackLayout Grid.Row="2" Grid.Column="2"
                                                   Spacing="6" Margin="0,2,0,0"
                                                   IsVisible="{Binding HasBadges}">
                                <Border Style="{StaticResource BadgeLive}" IsVisible="{Binding IsLive}">
                                    <Label Style="{StaticResource BadgeOnSignalLabel}" Text="Live" />
                                </Border>
                                <Border Style="{StaticResource BadgePositive}" IsVisible="{Binding IsRegistered}">
                                    <Label Style="{StaticResource BadgeOnFillLabel}" Text="Anmäld" />
                                </Border>
                                <Border Style="{StaticResource Badge}" IsVisible="{Binding HasGroupEntry}">
                                    <Label Style="{StaticResource BadgeLabel}" Text="Min grupp" />
                                </Border>
                                <Border Style="{StaticResource Badge}" IsVisible="{Binding HasSpan}">
                                    <Label Style="{StaticResource BadgeLabel}" Text="{Binding SpanLabel}" />
                                </Border>
                                <Border Style="{StaticResource BadgeAccent}" IsVisible="{Binding ShowContextBadge}">
                                    <Label Style="{StaticResource BadgeAccentLabel}" Text="{Binding ContextLabel}" />
                                </Border>
                            </HorizontalStackLayout>

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type CollectionView}}, Path=BindingContext.OpenDetailsCommand}"
                                    CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>
                        </Grid>

                        <Label Grid.Row="0"
                               Style="{StaticResource Heading2Label}"
                               TextColor="{DynamicResource AccentAction}"
                               HorizontalOptions="End" VerticalOptions="Start"
                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                               WidthRequest="44" HeightRequest="44"
                               SemanticProperties.Description="{Binding InterestDescription}"
                               Text="{Binding InterestGlyph}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type CollectionView}}, Path=BindingContext.ToggleInterestCommand}"
                                    CommandParameter="{Binding .}" />
                            </Label.GestureRecognizers>
                        </Label>

                        <BoxView Grid.Row="1" Style="{StaticResource Divider}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    
        <ActivityIndicator Grid.Row="2" Style="{StaticResource PageLoading}"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}" />

</Grid>

</SpinePage>
