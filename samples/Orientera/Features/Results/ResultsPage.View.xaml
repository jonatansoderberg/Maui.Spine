<SpinePage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Orientera.Features.Results.ResultsPage"
    x:TypeArguments="ResultsPageViewModel"
    x:DataType="ResultsPageViewModel">

    <Grid>

        <!-- Tomt läge är ett svar, inte ett väntrum (P10): aldrig medan en hämtning pågår. -->
        <VerticalStackLayout Padding="32" Spacing="8" VerticalOptions="Center"
                             IsVisible="{Binding IsEmpty}">
            <Label Style="{StaticResource Heading2Label}" SemanticProperties.HeadingLevel="Level2"
                   HorizontalTextAlignment="Center" Text="{Binding EmptyHeading}" />
            <Label Style="{StaticResource BodySecondaryLabel}" HorizontalTextAlignment="Center"
                   Text="{Binding EmptyDetail}" />
        </VerticalStackLayout>

        <CollectionView ItemsSource="{Binding Seasons}" IsGrouped="True"
                        SelectionMode="None" IsVisible="{Binding HasResults}">

            <!-- Säsongsrubrik: listan gick tidigare rakt bakåt genom åren utan att säga var
                 ett år slutade och nästa började. -->
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="ResultSeason">
                    <Grid Padding="16,16,16,6" ColumnDefinitions="*,Auto">
                        <Label Style="{StaticResource SectionLabel}"
                               SemanticProperties.HeadingLevel="Level2"
                               Text="{Binding Heading}" />
                        <Label Grid.Column="1" Style="{StaticResource CaptionLabel}"
                               Text="{Binding Summary}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
            </CollectionView.ItemsLayout>

            <CollectionView.Footer>
                <!-- Margin carries the tab bar's own height; the height is the breathing room. -->
                <BoxView HeightRequest="{StaticResource ListBottomSpacer}"
                         Margin="{Binding SafeAreaInsets}"
                         Color="Transparent" />
            </CollectionView.Footer>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="MyResultRow">
                    <Grid Padding="16,0">
                        <Border Style="{StaticResource Card}"
                                SemanticProperties.Description="{Binding Accessibility}"
                                SemanticProperties.Hint="Öppnar resultatet">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">

                                <Label Grid.Column="0"
                                       Style="{StaticResource DisplayNumberLabel}"
                                       VerticalOptions="Center"
                                       Text="{Binding PlaceText}" />

                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Style="{StaticResource Heading2Label}" Text="{Binding Name}" />
                                    <HorizontalStackLayout Spacing="6">
                                        <Path Style="{StaticResource DisciplineGlyph}"
                                              Data="{Binding DisciplineShape}"
                                              IsVisible="{Binding HasDiscipline}" />
                                        <Label Style="{StaticResource CaptionLabel}" VerticalOptions="Center"
                                               Text="{Binding Meta}" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Spacing="6">
                                        <Border Style="{StaticResource Badge}" IsVisible="{Binding HasSplits}">
                                            <Label Style="{StaticResource BadgeLabel}" Text="Sträcktider" />
                                        </Border>
                                        <Border Style="{StaticResource BadgeAccent}" IsVisible="{Binding IsPreliminary}">
                                            <Label Style="{StaticResource BadgeAccentLabel}" Text="Preliminärt" />
                                        </Border>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center">
                                    <Label Style="{StaticResource NumericHeading2Label}"
                                           HorizontalTextAlignment="End"
                                           Text="{Binding TimeText}" />
                                    <!--
                                        Två färdigstylade etiketter i stället för en trigger, av
                                        samma skäl som ChipView: en trigger minns färgen den
                                        ersatte och lämnar tillbaka fel temas färg efter ett byte.
                                    -->
                                    <Label Style="{StaticResource NumericCaptionLabel}"
                                           HorizontalTextAlignment="End"
                                           IsVisible="{Binding HasNeutralGap}"
                                           Text="{Binding BehindText}" />
                                    <Label Style="{StaticResource NumericCaptionLabel}"
                                           HorizontalTextAlignment="End"
                                           TextColor="{DynamicResource SignalUrgent}"
                                           IsVisible="{Binding HasMaterialGap}"
                                           Text="{Binding BehindText}" />
                                </VerticalStackLayout>
                            </Grid>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type CollectionView}}, Path=BindingContext.OpenResultCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    
        <!-- Skelett i listans egen form: sidan byter inte utseende när datan kommer, den fylls i. -->
        <VerticalStackLayout Padding="16,8" Spacing="8" IsVisible="{Binding ShowSkeleton}"
                             InputTransparent="True">
            <BoxView HeightRequest="92" CornerRadius="16" Color="{DynamicResource SkeletonBase}" />
            <BoxView HeightRequest="92" CornerRadius="16" Color="{DynamicResource SkeletonBase}" />
            <BoxView HeightRequest="92" CornerRadius="16" Color="{DynamicResource SkeletonBase}" />
            <BoxView HeightRequest="92" CornerRadius="16" Color="{DynamicResource SkeletonBase}" />
        </VerticalStackLayout>

</Grid>

</SpinePage>
