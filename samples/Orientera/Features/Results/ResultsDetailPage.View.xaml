<SpinePage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Orientera.Features.Results.ResultsDetailPage"
    x:TypeArguments="ResultsDetailPageViewModel"
    x:DataType="ResultsDetailPageViewModel">

    <Grid RowDefinitions="Auto,*">

        <!-- Översikt / Sträckor / Analys -->
        <HorizontalStackLayout Grid.Row="0" Spacing="8" Padding="16,4,16,10" IsVisible="{Binding HasResult}">
            <ChipView Text="Översikt" IsSelected="{Binding IsOverview}"
                      Command="{Binding SelectTabCommand}" CommandParameter="Overview" />
            <ChipView Text="Sträckor" IsSelected="{Binding IsLegs}" IsEnabled="{Binding HasSplits}"
                      Command="{Binding SelectTabCommand}" CommandParameter="Legs" />
            <ChipView Text="Analys" IsSelected="{Binding IsAnalysis}" IsEnabled="{Binding HasSplits}"
                      Command="{Binding SelectTabCommand}" CommandParameter="Analysis" />
        </HorizontalStackLayout>

        <!--
            Tomt läge är ett svar, inte ett väntrum (P10). Det stod "Inget resultat ännu" under
            hämtningen, med snurran ovanpå texten, och fyra sekunder senare fanns hela resultatet:
            två påståenden som motsade varandra samtidigt. IsIdle är sant först när en hämtning
            är klar och inget kom.
        -->
        <VerticalStackLayout Grid.Row="1" Padding="32" Spacing="8" VerticalOptions="Center"
                             IsVisible="{Binding IsIdle}">
            <Label Style="{StaticResource Heading2Label}" SemanticProperties.HeadingLevel="Level2"
                   HorizontalTextAlignment="Center" Text="Inget resultat ännu" />
            <Label Style="{StaticResource BodySecondaryLabel}" HorizontalTextAlignment="Center" Text="{Binding EmptyMessage}" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1" IsVisible="{Binding HasResult}">
            <VerticalStackLayout Padding="{StaticResource ScreenPadding}" Spacing="16">

                <!-- ============ Översikt ============ -->
                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsOverview}">

                    <Border Style="{StaticResource Card}" IsVisible="{Binding HasMine}">
                        <VerticalStackLayout Spacing="10">
                            <Label Style="{StaticResource SectionLabel}" Text="{Binding ClassLine}" />

                            <HorizontalStackLayout Spacing="10" VerticalOptions="End">
                                <Label Style="{StaticResource DisplayNumberLabel}"
                                       SemanticProperties.Description="{Binding PlaceSpoken}"
                                       Text="{Binding PlaceText}" />
                                <Label Style="{StaticResource NumericCaptionLabel}"
                                       AutomationProperties.IsInAccessibleTree="False"
                                       VerticalOptions="End" Margin="0,0,0,6"
                                       Text="{Binding PlaceOfText}" />
                            </HorizontalStackLayout>

                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0">
                                    <Label Style="{StaticResource CaptionLabel}" Text="Tid" />
                                    <Label Style="{StaticResource NumericHeading2Label}"
                                           SemanticProperties.Description="{Binding TimeSpoken}"
                                           Text="{Binding TimeText}" />
                                </VerticalStackLayout>
                                <!--
                                    Tre färdigstylade etiketter i stället för en trigger, av samma
                                    skäl som ChipView. Marginalen före tvåan är grön, ett verkligt
                                    tapp mot vinnaren är SignalUrgent — en av dess tre tillåtna
                                    användningar (D1) — och allt däremellan står neutralt. Rött på
                                    varje differens sa bara "inte vinnare".
                                -->
                                <VerticalStackLayout Grid.Column="1">
                                    <Label Style="{StaticResource CaptionLabel}" Text="{Binding BehindLabel}" />
                                    <Label Style="{StaticResource NumericHeading2Label}"
                                           TextColor="{DynamicResource PositiveDelta}"
                                           IsVisible="{Binding IsWinner}"
                                           SemanticProperties.Description="{Binding BehindSpoken}"
                                           Text="{Binding BehindText}" />
                                    <Label Style="{StaticResource NumericHeading2Label}"
                                           TextColor="{DynamicResource SignalUrgent}"
                                           IsVisible="{Binding HasMaterialGap}"
                                           SemanticProperties.Description="{Binding BehindSpoken}"
                                           Text="{Binding BehindText}" />
                                    <Label Style="{StaticResource NumericHeading2Label}"
                                           IsVisible="{Binding HasNeutralGap}"
                                           SemanticProperties.Description="{Binding BehindSpoken}"
                                           Text="{Binding BehindText}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2">
                                    <Label Style="{StaticResource CaptionLabel}" Text="Status" />
                                    <Label Style="{StaticResource BodyStrongLabel}" Text="{Binding StatusText}" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Prognos mot utfall -->
                    <Border Style="{StaticResource Card}" IsVisible="{Binding HasPrediction}">
                        <VerticalStackLayout Spacing="6">
                            <Label Style="{StaticResource SectionLabel}" Text="Prognos mot utfall" />
                            <HorizontalStackLayout Spacing="10">
                                <Label Style="{StaticResource BodyStrongLabel}"
                                       TextColor="{DynamicResource EstimateInk}"
                                       Text="{Binding PredictionText}" />
                                <Label Style="{StaticResource BodyStrongLabel}" Text="{Binding PredictionOutcomeText}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding BeatPrediction}" Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource PositiveDelta}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </HorizontalStackLayout>
                            <Label Style="{StaticResource CaptionLabel}" Text="Tryck för att se vad prognosen byggde på." />

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenPredictionCommand}" />
                            </Border.GestureRecognizers>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Resultatlistan: det man kom för att se även när man inte är med själv -->
                    <Label Style="{StaticResource BodySecondaryLabel}"
                           IsVisible="{Binding NotInFieldText.Length}"
                           Text="{Binding NotInFieldText}" />

                    <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding Field}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="ResultClassGroup">
                                <VerticalStackLayout Spacing="4">
                                    <Label Style="{StaticResource SectionLabel}"
                                           Margin="0,8,0,0"
                                           SemanticProperties.HeadingLevel="Level2"
                                           SemanticProperties.Description="{Binding Accessibility}"
                                           Text="{Binding Name}" />

                                    <Border Style="{StaticResource Card}" Padding="0">
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding .}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="ResultRow">
                                                    <VerticalStackLayout>
                                                        <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="10"
                                                              Padding="14,8"
                                                              SemanticProperties.Description="{Binding Accessibility}">

                                                            <Label Grid.Column="0"
                                                                   Style="{StaticResource NumericStrongLabel}"
                                                                   LineBreakMode="NoWrap"
                                                                   VerticalOptions="Center"
                                                                   Text="{Binding PlaceText}" />

                                                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                                                <Label Style="{StaticResource BodyStrongLabel}"
                                                                       LineBreakMode="TailTruncation"
                                                                       Text="{Binding Name}" />
                                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5">
                                                                    <Border Style="{StaticResource ClubBadge}" IsVisible="{Binding HasClubLogo}">
                                                                        <Image WidthRequest="14" HeightRequest="14"
                                                                               AutomationProperties.IsInAccessibleTree="False"
                                                                               Source="{Binding ClubLogo}" />
                                                                    </Border>
                                                                    <Label Grid.Column="1"
                                                                           Style="{StaticResource CaptionLabel}"
                                                                           LineBreakMode="TailTruncation"
                                                                           Text="{Binding Club}" />
                                                                </Grid>
                                                            </VerticalStackLayout>

                                                            <VerticalStackLayout Grid.Column="2" Spacing="1" VerticalOptions="Center">
                                                                <Label Style="{StaticResource NumericStrongLabel}"
                                                                       HorizontalTextAlignment="End"
                                                                       Text="{Binding TimeText}" />
                                                                <Label Style="{StaticResource NumericCaptionLabel}"
                                                                       HorizontalTextAlignment="End"
                                                                       Text="{Binding BehindText}" />
                                                            </VerticalStackLayout>

                                                            <!-- Jag-raden får samma accentton som i livelistan -->
                                                            <Grid.Triggers>
                                                                <DataTrigger TargetType="Grid" Binding="{Binding IsMe}" Value="True">
                                                                    <Setter Property="BackgroundColor" Value="{DynamicResource AccentSubtle}" />
                                                                </DataTrigger>
                                                            </Grid.Triggers>
                                                        </Grid>

                                                        <BoxView Style="{StaticResource Divider}" />
                                                    </VerticalStackLayout>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </Border>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>

                <!-- ============ Sträckor ============ -->
                <VerticalStackLayout Spacing="4" IsVisible="{Binding IsLegs}">

                    <!--
                        Rubrikerna förklaras en gång i stället för att skrivas ut i sina kolumner:
                        de är fyra och sex tecken breda och rymmer inte "Sträcka" och "Totalt" utan
                        att radbrytas mitt i ordet — vilket är svårare att läsa än förkortningen var.
                    -->
                    <Label Style="{StaticResource CaptionLabel}"
                           Padding="14,0,14,4"
                           Text="Str = placering på sträckan · Tot = placering totalt · Tapp = mot din egen fart" />

                    <Grid ColumnDefinitions="72,*,44,44,72" Padding="14,0,14,6" ColumnSpacing="6">
                        <Label Grid.Column="0" Style="{StaticResource SectionLabel}" Text="Kontroll" />
                        <Label Grid.Column="1" Style="{StaticResource SectionLabel}" Text="Tid" />
                        <Label Grid.Column="2" Style="{StaticResource SectionLabel}" Text="Str" />
                        <Label Grid.Column="3" Style="{StaticResource SectionLabel}" Text="Tot" />
                        <Label Grid.Column="4" Style="{StaticResource SectionLabel}" HorizontalTextAlignment="End" Text="Tapp" />
                    </Grid>

                    <Border Style="{StaticResource Card}" Padding="0">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Legs}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="LegRow">
                                    <VerticalStackLayout SemanticProperties.Description="{Binding Accessibility}">
                                        <Grid ColumnDefinitions="72,*,44,44,72" Padding="14,8" ColumnSpacing="6">
                                            <Label Grid.Column="0" Style="{StaticResource NumericCaptionLabel}"
                                                   VerticalOptions="Center" Text="{Binding Control}" />
                                            <Label Grid.Column="1" Style="{StaticResource NumericStrongLabel}"
                                                   VerticalOptions="Center" Text="{Binding LegTime}" />
                                            <Label Grid.Column="2" Style="{StaticResource NumericCaptionLabel}"
                                                   VerticalOptions="Center" Text="{Binding LegPlace}" />
                                            <Label Grid.Column="3" Style="{StaticResource NumericCaptionLabel}"
                                                   VerticalOptions="Center" Text="{Binding PositionAfter}" />
                                            <Label Grid.Column="4" Style="{StaticResource NumericStrongLabel}"
                                                   HorizontalTextAlignment="End" VerticalOptions="Center"
                                                   Text="{Binding Loss}">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsLikelyMistake}" Value="True">
                                                        <Setter Property="TextColor" Value="{DynamicResource NegativeDelta}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Grid>

                                        <!-- Modellerad bedömning, tydligt separerad från mätdata -->
                                        <Label Style="{StaticResource CaptionLabel}"
                                               TextColor="{DynamicResource EstimateInk}"
                                               Padding="14,0,14,8"
                                               IsVisible="{Binding IsLikelyMistake}"
                                               Text="{Binding MistakeText}" />

                                        <BoxView Style="{StaticResource Divider}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ============ Analys ============ -->
                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsAnalysis}">

                    <!-- Loppberättelsen skrivs medan resten av fliken redan går att läsa. -->
                    <Border Style="{StaticResource Card}" IsVisible="{Binding IsWritingStory}">
                        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                            <ActivityIndicator IsRunning="{Binding IsWritingStory}" WidthRequest="16" HeightRequest="16" />
                            <Label Style="{StaticResource CaptionLabel}" VerticalOptions="Center"
                                   Text="Skriver om ditt lopp…" />
                        </HorizontalStackLayout>
                    </Border>

                    <Border Style="{StaticResource Card}" IsVisible="{Binding HasStory}">
                        <VerticalStackLayout Spacing="6">
                            <Label Style="{StaticResource SectionLabel}" Text="Ditt lopp" />
                            <Label Style="{StaticResource BodyLabel}" Text="{Binding StoryText}" />
                            <Label Style="{StaticResource CaptionLabel}"
                                   Text="Sammanfattad av AI ur dina sträcktider." />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource Card}" IsVisible="{Binding HasMistakes}">
                        <VerticalStackLayout Spacing="6">
                            <Label Style="{StaticResource SectionLabel}" Text="Största tapp" />
                            <Label Style="{StaticResource Heading1Label}" SemanticProperties.HeadingLevel="Level2"
                                   Text="{Binding BiggestLossControl}" />
                            <Label Style="{StaticResource BodyStrongLabel}"
                                   TextColor="{DynamicResource EstimateInk}"
                                   Text="{Binding BiggestLossText}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="12">
                            <Label Style="{StaticResource SectionLabel}" Text="Uppskattat" />

                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0">
                                    <Label Style="{StaticResource CaptionLabel}" Text="Bomtid" />
                                    <Label Style="{StaticResource NumericHeading2Label}"
                                           TextColor="{DynamicResource EstimateInk}"
                                           SemanticProperties.Description="{Binding TotalMistakeSpoken}"
                                           Text="{Binding TotalMistakeText}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1">
                                    <Label Style="{StaticResource CaptionLabel}" Text="Utan bommar" />
                                    <Label Style="{StaticResource NumericHeading2Label}"
                                           TextColor="{DynamicResource EstimateInk}"
                                           SemanticProperties.Description="{Binding TheoreticalTimeSpoken}"
                                           Text="{Binding TheoreticalTimeText}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2">
                                    <Label Style="{StaticResource CaptionLabel}" Text="Stabilitet" />
                                    <Label Style="{StaticResource NumericHeading2Label}" Text="{Binding StabilityText}" />
                                </VerticalStackLayout>
                            </Grid>

                            <Label Style="{StaticResource CaptionLabel}"
                                   Text="Bomtid och tiden utan bommar är beräknade, inte uppmätta. De utgår från din egen fart på övriga sträckor." />
                        </VerticalStackLayout>
                    </Border>

                    <Button Style="{StaticResource SecondaryButton}"
                            Text="{Binding CompareTargetText}"
                            Command="{Binding CompareCommand}" />

                    <Border Style="{StaticResource Card}" Padding="0" IsVisible="{Binding Comparison.Count}">
                        <VerticalStackLayout>

                            <!-- Rubrikraden: tre tidskolumner utan namn gick inte att läsa. -->
                            <Grid ColumnDefinitions="76,*,*,72" Padding="14,10,14,6" ColumnSpacing="6">
                                <Label Grid.Column="0" Style="{StaticResource SectionLabel}" Text="Sträcka" />
                                <Label Grid.Column="1" Style="{StaticResource SectionLabel}" Text="{Binding MineHeading}" />
                                <Label Grid.Column="2" Style="{StaticResource SectionLabel}" Text="{Binding TheirsHeading}" />
                                <Label Grid.Column="3" Style="{StaticResource SectionLabel}"
                                       HorizontalTextAlignment="End" Text="Diff" />
                            </Grid>
                            <BoxView Style="{StaticResource Divider}" Margin="14,0" />

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Comparison}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="ComparisonRow">
                                    <Grid ColumnDefinitions="76,*,*,72" Padding="14,7" ColumnSpacing="6"
                                          SemanticProperties.Description="{Binding Accessibility}">
                                        <Label Grid.Column="0" Style="{StaticResource NumericCaptionLabel}" Text="{Binding Label}" />
                                        <Label Grid.Column="1" Style="{StaticResource NumericLabel}" Text="{Binding Mine}" />
                                        <Label Grid.Column="2" Style="{StaticResource NumericCaptionLabel}" Text="{Binding Theirs}" />
                                        <Label Grid.Column="3" Style="{StaticResource NumericStrongLabel}"
                                               HorizontalTextAlignment="End"
                                               TextColor="{DynamicResource PositiveDelta}"
                                               Text="{Binding Delta}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsBehind}" Value="True">
                                                    <Setter Property="TextColor" Value="{DynamicResource NegativeDelta}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Grid>
                                </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <ActivityIndicator Grid.Row="1"
                           Style="{StaticResource PageLoading}"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}" />

    </Grid>

</SpinePage>
