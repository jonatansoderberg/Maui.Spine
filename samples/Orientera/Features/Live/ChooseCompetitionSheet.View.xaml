<SpinePage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Orientera.Features.Live.ChooseCompetitionSheet"
    x:TypeArguments="ChooseCompetitionSheetViewModel"
    x:DataType="ChooseCompetitionSheetViewModel">

    <Grid RowDefinitions="Auto,*">

        <Label Grid.Row="0"
               Style="{StaticResource CaptionLabel}"
               Padding="16,0,16,10"
               Text="{Binding Explanation}" />

        <CollectionView Grid.Row="1" Margin="16,0,16,16" ItemsSource="{Binding Options}" SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="CompetitionOption">
                    <Border Style="{StaticResource Card}" Padding="16,12"
                            SemanticProperties.Description="{Binding Accessibility}"
                            SemanticProperties.Hint="Visar tävlingen i live">
                        <VerticalStackLayout Spacing="2">
                            <Label Style="{StaticResource BodyStrongLabel}" Text="{Binding Title}" />
                            <Label Style="{StaticResource CaptionLabel}" Text="{Binding Subtitle}" />
                        </VerticalStackLayout>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type CollectionView}}, Path=BindingContext.ChooseCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</SpinePage>
