<SpinePage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Orientera.Features.Live.LivePage"
    x:TypeArguments="LivePageViewModel"
    x:DataType="LivePageViewModel">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Vilken tävling och hur färsk datan är -->
        <VerticalStackLayout Grid.Row="0" Padding="16,4,16,8" Spacing="2" IsVisible="{Binding HasLive}">
            <Label Style="{StaticResource Heading2Label}"
                   SemanticProperties.HeadingLevel="Level1"
                   Text="{Binding CompetitionName}" />
            <HorizontalStackLayout Spacing="8">
                <Border Style="{StaticResource BadgeLive}">
                    <Label Style="{StaticResource BadgeOnFillLabel}" Text="Live" />
                </Border>
                <Label Style="{StaticResource NumericCaptionLabel}"
                       VerticalOptions="Center"
                       Text="{Binding UpdatedText}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <HorizontalStackLayout Grid.Row="1" Spacing="8" Padding="16,4,16,10" IsVisible="{Binding HasLive}">
            <ChipView Text="Min grupp" IsSelected="{Binding IsMyGroup}"
                      Command="{Binding SelectScopeCommand}" CommandParameter="MyGroup" />
            <ChipView Text="Min klass" IsSelected="{Binding IsMyClass}"
                      Command="{Binding SelectScopeCommand}" CommandParameter="MyClass" />
            <ChipView Text="Alla" IsSelected="{Binding IsEveryone}"
                      Command="{Binding SelectScopeCommand}" CommandParameter="Everyone" />
        </HorizontalStackLayout>

        <VerticalStackLayout Grid.Row="2" Padding="32" Spacing="8" VerticalOptions="Center"
                             IsVisible="{Binding IsEmpty}">
            <Label Style="{StaticResource Heading2Label}" SemanticProperties.HeadingLevel="Level2"
                   HorizontalTextAlignment="Center" Text="Inget live just nu" />
            <Label Style="{StaticResource BodySecondaryLabel}" HorizontalTextAlignment="Center"
                   Text="{Binding EmptyMessage}" />
        </VerticalStackLayout>

        <!-- Högre datatäthet än Hem: tabulära siffror och kompakta rader -->
        <CollectionView Grid.Row="2" Margin="16,0" ItemsSource="{Binding Rows}" SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="4" />
            </CollectionView.ItemsLayout>

            <CollectionView.Footer>
                <BoxView HeightRequest="{StaticResource TabBarSpacer}" Color="Transparent" />
            </CollectionView.Footer>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="LiveRow">
                    <Border Style="{StaticResource Card}" Padding="14,10"
                            SemanticProperties.Description="{Binding Accessibility}">
                        <Grid ColumnDefinitions="42,*,Auto" ColumnSpacing="10">

                            <Label Grid.Column="0"
                                   Style="{StaticResource NumericHeading2Label}"
                                   VerticalOptions="Center"
                                   Text="{Binding PositionText}" />

                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Style="{StaticResource BodyStrongLabel}" Text="{Binding Name}" />
                                    <Label Style="{StaticResource CaptionLabel}"
                                           TextColor="{DynamicResource AccentAction}"
                                           VerticalOptions="Center"
                                           Text="{Binding GroupGlyph}" />
                                </HorizontalStackLayout>
                                <Label Style="{StaticResource CaptionLabel}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Club}" />
                                            <Span Text=" · " />
                                            <Span Text="{Binding Class}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="2" Spacing="1" VerticalOptions="Center">
                                <Label Style="{StaticResource NumericStrongLabel}"
                                       HorizontalTextAlignment="End"
                                       Text="{Binding TimeText}" />
                                <Label Style="{StaticResource NumericCaptionLabel}"
                                       HorizontalTextAlignment="End"
                                       Text="{Binding ProgressText}" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Jag-raden får en accentton, aldrig bara en färg utan text -->
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsMe}" Value="True">
                                <Setter Property="BackgroundColor" Value="{DynamicResource AccentSubtle}" />
                            </DataTrigger>
                        </Border.Triggers>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</SpinePage>
