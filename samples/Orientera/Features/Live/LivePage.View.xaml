<SpinePage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Orientera.Features.Live.LivePage"
    x:TypeArguments="LivePageViewModel"
    x:DataType="LivePageViewModel">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Vilken tävling och hur färsk datan är -->
        <VerticalStackLayout Grid.Row="0" Padding="16,4,16,8" Spacing="2" IsVisible="{Binding HasLive}">
            <!-- Namnet blir valbart först när det finns en till tävling att byta till -->
            <HorizontalStackLayout Spacing="6">
                <Label Style="{StaticResource Heading2Label}"
                       SemanticProperties.HeadingLevel="Level1"
                       Text="{Binding CompetitionName}" />
                <Label Style="{StaticResource Heading2Label}"
                       VerticalOptions="Center"
                       IsVisible="{Binding CanPickCompetition}"
                       TextColor="{DynamicResource AccentAction}"
                       Text="▾" />

                <HorizontalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding PickCompetitionCommand}" />
                </HorizontalStackLayout.GestureRecognizers>
            </HorizontalStackLayout>
            <HorizontalStackLayout Spacing="8">
                <Border Style="{StaticResource BadgeLive}" IsVisible="{Binding IsRunningNow}">
                    <Label Style="{StaticResource BadgeOnFillLabel}" Text="Live" />
                </Border>
                <Label Style="{StaticResource NumericCaptionLabel}"
                       VerticalOptions="Center"
                       Text="{Binding UpdatedText}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <HorizontalStackLayout Grid.Row="1" Spacing="8" Padding="16,4,16,10" IsVisible="{Binding HasLive}">
            <ChipView Text="Favoriter" IsSelected="{Binding IsMyGroup}"
                      Command="{Binding SelectScopeCommand}" CommandParameter="MyGroup" />
            <ChipView Text="Min klass" IsSelected="{Binding IsMyClass}"
                      Command="{Binding SelectScopeCommand}" CommandParameter="MyClass" />
            <!-- Klasschipet är en väljare: att trycka på det frågar alltid vilken klass -->
            <ChipView Text="{Binding ClassChipText}" IsSelected="{Binding IsClass}"
                      IsVisible="{Binding CanPickClass}"
                      Command="{Binding PickClassCommand}" />
        </HorizontalStackLayout>

        <VerticalStackLayout Grid.Row="2" Padding="32" Spacing="8" VerticalOptions="Center"
                             IsVisible="{Binding IsEmpty}">
            <Label Style="{StaticResource Heading2Label}" SemanticProperties.HeadingLevel="Level2"
                   HorizontalTextAlignment="Center" Text="Inget live just nu" />
            <Label Style="{StaticResource BodySecondaryLabel}" HorizontalTextAlignment="Center"
                   Text="{Binding EmptyMessage}" />
        </VerticalStackLayout>

        <!--
            Sträcktabellen: en kolumn per radiokontroll. Namnkolumnen ligger sist i varje rad
            och skjuts tillbaka med tabellens scrollposition, så den står stilla medan
            kontrollerna passerar under den.
        -->
        <ScrollView Grid.Row="2" x:Name="Table"
                    Orientation="Horizontal"
                    BackgroundColor="{DynamicResource SurfaceCard}"
                    IsVisible="{Binding HasRows}">

            <CollectionView WidthRequest="{Binding TableWidth}"
                            HeightRequest="{Binding Source={RelativeSource AncestorType={x:Type ScrollView}}, Path=Height}"
                            ItemsSource="{Binding Groups}"
                            IsGrouped="True" SelectionMode="None">

                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="LiveClassGroup">
                        <Grid ColumnDefinitions="156,*" Padding="0,14,0,6">

                            <HorizontalStackLayout Grid.Column="1"
                                                   BindableLayout.ItemsSource="{Binding Columns}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <!-- Kolumnbredden växer så att den bredaste klassen fyller
                                             raden; smalare klasser slutar där deras kontroller tar slut -->
                                        <Label Style="{StaticResource SectionLabel}"
                                               WidthRequest="{Binding Source={RelativeSource AncestorType={x:Type CollectionView}}, Path=BindingContext.CellWidth}"
                                               Margin="0,0,10,0"
                                               HorizontalTextAlignment="End"
                                               Text="{Binding .}" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>

                            <Label Grid.Column="0"
                                   Style="{StaticResource SectionLabel}"
                                   Padding="16,0,0,0"
                                   BackgroundColor="{DynamicResource SurfaceCard}"
                                   TranslationX="{Binding Source={RelativeSource AncestorType={x:Type ScrollView}}, Path=ScrollX}"
                                   SemanticProperties.HeadingLevel="Level2"
                                   SemanticProperties.Description="{Binding Accessibility}"
                                   Text="{Binding Name}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>

                <CollectionView.Footer>
                    <!-- Margin carries the tab bar's own height; the height is the breathing room. -->
                    <BoxView HeightRequest="{StaticResource ListBottomSpacer}"
                             Margin="{Binding SafeAreaInsets}"
                             Color="Transparent" />
                </CollectionView.Footer>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="LiveRow">
                        <Grid ColumnDefinitions="156,*" RowDefinitions="Auto,Auto">

                            <Grid.Triggers>
                                <DataTrigger TargetType="Grid" Binding="{Binding IsMe}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource AccentSubtle}" />
                                </DataTrigger>
                            </Grid.Triggers>


                            <HorizontalStackLayout Grid.Column="1" Grid.Row="0"
                                                   Padding="0,7" VerticalOptions="Center"
                                                   BindableLayout.ItemsSource="{Binding Cells}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="LiveCell">
                                        <VerticalStackLayout Margin="0,0,10,0"
                                                             WidthRequest="{Binding Source={RelativeSource AncestorType={x:Type CollectionView}}, Path=BindingContext.CellWidth}"
                                                             SemanticProperties.Description="{Binding Accessibility}">
                                            <Label Style="{StaticResource NumericStrongLabel}"
                                                   HorizontalTextAlignment="End"
                                                   Text="{Binding TimeText}">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsLeading}" Value="True">
                                                        <Setter Property="TextColor" Value="{DynamicResource AccentAction}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            <Label Style="{StaticResource NumericCaptionLabel}"
                                                   HorizontalTextAlignment="End"
                                                   Text="{Binding DetailText}" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>

                            <!-- Namnkolumnen målas sist: kontrollerna scrollar in under den -->
                            <Grid Grid.Column="0" Grid.Row="0"
                                  Padding="16,7,8,7"
                                  BackgroundColor="{DynamicResource SurfaceCard}"
                                  TranslationX="{Binding Source={RelativeSource AncestorType={x:Type ScrollView}}, Path=ScrollX}"
                                  SemanticProperties.Description="{Binding Accessibility}">

                                <!--
                                    Ingen placeringskolumn: en placering hör till den kontroll
                                    den mättes vid, och tre löpare kan alla vara etta vid var
                                    sin. Ordningen i listan är rangordningen; siffrorna står i
                                    kolumnen de gäller.
                                -->
                                <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                        <Label Style="{StaticResource BodyStrongLabel}"
                                               LineBreakMode="TailTruncation"
                                               Text="{Binding Name}" />
                                        <Label Grid.Column="1"
                                               Style="{StaticResource CaptionLabel}"
                                               TextColor="{DynamicResource AccentAction}"
                                               VerticalOptions="Center"
                                               Text="{Binding GroupGlyph}" />
                                    </Grid>
                                    <!-- The class is the group heading; repeating it on every row
                                         is noise. It stays in the row's spoken description. -->
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5">
                                        <Border Style="{StaticResource ClubBadge}" IsVisible="{Binding HasClubLogo}">
                                            <Image WidthRequest="14" HeightRequest="14"
                                                   AutomationProperties.IsInAccessibleTree="False"
                                                   Source="{Binding ClubLogo}" />
                                        </Border>
                                        <Label Grid.Column="1"
                                               Style="{StaticResource CaptionLabel}"
                                               LineBreakMode="TailTruncation"
                                               Text="{Binding Club}" />
                                    </Grid>
                                    <Label Style="{StaticResource CaptionLabel}"
                                           IsVisible="{Binding HasStatus}"
                                           Text="{Binding StatusText}" />
                                </VerticalStackLayout>

                                <!-- Jag-raden får en accentton, aldrig bara en färg utan text -->
                                <Grid.Triggers>
                                    <DataTrigger TargetType="Grid" Binding="{Binding IsMe}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource AccentSubtle}" />
                                    </DataTrigger>
                                </Grid.Triggers>
                            </Grid>

                            <BoxView Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Divider}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </ScrollView>

    
        <ActivityIndicator Style="{StaticResource PageLoading}"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}" />

</Grid>

</SpinePage>
