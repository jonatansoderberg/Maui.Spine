<?xml version="1.0" encoding="utf-8"?>
<!--
    Android draws the small icon as a silhouette, so it has to be a flat white shape — the app
    icon would render as a blob. This is the start triangle from the map symbol set.

    The name is Spine's: the package looks for a drawable called spine_push_icon and falls back to
    the launcher icon when there is none. Both halves — pushed and locally scheduled — draw with it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,3 L21.5,19.5 L2.5,19.5 Z" />
</vector>
