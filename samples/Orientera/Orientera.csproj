<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>$(SpineMauiTargetFrameworks)</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>Orientera</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>

		<!-- XAML Source Generator -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Opt in to Material3 on Android -->
		<UseMaterial3>true</UseMaterial3>

		<!-- Display name -->
		<ApplicationTitle>Orientera</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>se.cosmomedia.orientera</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<WindowsPackageType>None</WindowsPackageType>

		<!-- The widget extension's bundle id becomes $(ApplicationId).$(SpineWidgetsExtensionName), and an
		     App ID cannot be renamed once registered — so it says widgets rather than leaking the
		     framework's name into se.cosmomedia.orientera.SpineWidgets. -->
		<SpineWidgetsExtensionName>widgets</SpineWidgetsExtensionName>

	</PropertyGroup>

	<ItemGroup>
		<!-- Ikon och splash bakas vid build och kan inte läsa en ResourceDictionary. #2E8B57 är
		     BrandTint ur Resources\Styles\LightTheme.xaml; ändras den där ändras den här. -->

		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#2E8B57" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#2E8B57" BaseSize="128,128" />

		<!-- Images. Terrängbilderna ligger i en egen katalog men plattas ut av MAUI; de bär
		     sitt terrain_-prefix i filnamnet. Globben tar bara .jpg så README och licensfilen
		     inte skickas genom bildpipelinen. -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Include="Resources\Images\terrain\*.jpg" />
		<MauiImage Include="Resources\Images\hero\*.jpg" />
		<MauiImage Include="Resources\Images\surfaces\*.jpg" />

		<!-- Embedded SVGs (tab icons, resolved via the SvgIcon pipeline) -->
		<EmbeddedResource Include="Resources\Svg\*.svg" />

		<!-- Which data source the app runs against; read in MauiProgram -->
		<EmbeddedResource Include="appsettings.json" />

		<!-- Custom Fonts (Inter, SIL OFL 1.1 — see Resources\Fonts\Inter-OFL.txt) -->
		<MauiFont Include="Resources\Fonts\*.ttf" />

		<!--
			Brandon Grotesque is licensed from HVD Fonts, not OFL like Inter, and it is here for
			one thing: the header title, the same face Spine's own sample uses.
			Listed by extension rather than as "Fonts\*" so the licence text beside the files is
			not handed to the font packer as a font.
		-->
		<MauiFont Include="Resources\Fonts\*.otf" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" />
		<PackageReference Include="Microsoft.Maui.Controls" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" />
		<!-- Kartmotor: se issue #49. SkiaSharp-versionen är densamma som Spine-pluginsen redan drar in. -->
		<PackageReference Include="Mapsui.Maui" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Orientera.Domain\Orientera.Domain.csproj" />
		<ProjectReference Include="..\..\src\Plugin.Maui.Spine\Plugin.Maui.Spine.csproj" />
		<ProjectReference Include="..\..\src\Plugin.Maui.Spine.Widgets\Plugin.Maui.Spine.Widgets.csproj" />
		<ProjectReference Include="..\..\src\Plugin.Maui.Spine.Push\Plugin.Maui.Spine.Push.csproj" />
		<ProjectReference Include="..\..\src\Plugin.Maui.Spine.Controls.HeroCollectionView\Plugin.Maui.Spine.Controls.HeroCollectionView.csproj" />
		<ProjectReference Include="..\..\src\Plugin.Maui.Spine.Svg\Plugin.Maui.Spine.Svg.csproj" />
	</ItemGroup>

	<!-- Widgets: kinden nedan blir en WidgetKit-extension på iOS; providern är [Widget("next-start")] i Widgets\. -->
	<ItemGroup>
		<SpineWidget Include="next-start" DisplayName="Nästa start" Description="Nedräkningen till din nästa start, från tävlingen du är anmäld till." Families="Small,Medium" />
	</ItemGroup>

	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<!-- App Group-behörigheten appen och widgetextensionet delar container genom. -->
		<CodesignEntitlements>Platforms\iOS\Entitlements.plist</CodesignEntitlements>
	</PropertyGroup>

	<!-- Importeras explicit: Orientera använder ProjectReference, inte NuGet-paketet. -->
	<Import Project="..\..\src\Plugin.Maui.Spine\build\Plugin.Maui.Spine.Entitlements.targets" />
	<Import Project="..\..\src\Plugin.Maui.Spine.Widgets\build\Plugin.Maui.Spine.Widgets.targets" />
	<Import Project="..\..\src\Plugin.Maui.Spine.Push\build\Plugin.Maui.Spine.Push.targets" />

</Project>
