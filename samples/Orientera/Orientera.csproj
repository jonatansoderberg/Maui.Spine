<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>Orientera</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>preview</LangVersion>

		<!-- XAML Source Generator -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Opt in to Material3 on Android -->
		<UseMaterial3>true</UseMaterial3>

		<!-- Display name -->
		<ApplicationTitle>Orientera</ApplicationTitle>

		<!-- App Identifier (placeholder until SP-13 name clearance) -->
		<ApplicationId>com.companyname.orientera</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- Ikon och splash bakas vid build och kan inte läsa en ResourceDictionary. #2E8B57 är
		     BrandTint ur Resources\Styles\LightTheme.xaml; ändras den där ändras den här. -->

		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#2E8B57" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#2E8B57" BaseSize="128,128" />

		<!-- Images. Terrängbilderna ligger i en egen katalog men plattas ut av MAUI; de bär
		     sitt terrain_-prefix i filnamnet. Globben tar bara .jpg så README och licensfilen
		     inte skickas genom bildpipelinen. -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Include="Resources\Images\terrain\*.jpg" />
		<MauiImage Include="Resources\Images\hero\*.jpg" />

		<!-- Embedded SVGs (tab icons, resolved via the SvgIcon pipeline) -->
		<EmbeddedResource Include="Resources\Svg\*.svg" />

		<!-- Which data source the app runs against; read in MauiProgram -->
		<EmbeddedResource Include="appsettings.json" />

		<!-- Custom Fonts (Inter, SIL OFL 1.1 — see Resources\Fonts\Inter-OFL.txt) -->
		<MauiFont Include="Resources\Fonts\*.ttf" />

		<!--
			Brandon Grotesque is licensed from HVD Fonts, not OFL like Inter, and it is here for
			one thing: the header title, the same face Spine's own sample uses.
			Listed by extension rather than as "Fonts\*" so the licence text beside the files is
			not handed to the font packer as a font.
		-->
		<MauiFont Include="Resources\Fonts\*.otf" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.50" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.5" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.10" />
		<!-- Kartmotor: se issue #49. SkiaSharp-versionen är densamma som Spine-pluginsen redan drar in. -->
		<PackageReference Include="Mapsui.Maui" Version="5.1.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Orientera.Domain\Orientera.Domain.csproj" />
		<ProjectReference Include="..\..\src\Plugin.Maui.Spine\Plugin.Maui.Spine.csproj" />
		<ProjectReference Include="..\..\src\Plugin.Maui.SpineControls\Plugin.Maui.SpineControls.csproj" />
		<ProjectReference Include="..\..\src\Plugin.Maui.SvgImage\Plugin.Maui.SvgImage.csproj" />
	</ItemGroup>

</Project>
