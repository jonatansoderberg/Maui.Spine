<SpinePage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiSpinePushSampleApp.Pages.LiveActivityPage"
    x:TypeArguments="LiveActivityPageViewModel"
    x:DataType="LiveActivityPageViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">

            <Label Text="Starta en aktivitet lokalt, och låt sedan servern uppdatera den. Push-token är det som gör det möjligt medan appen är stängd."
                   FontSize="12" TextColor="Gray" />

            <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto" RowSpacing="4">
                <Label Grid.Row="0" Grid.Column="0" Text="Tillstånd" />
                <Label Grid.Row="0" Grid.Column="1" Text="{Binding State}" />

                <Label Grid.Row="1" Grid.Column="0" Text="Adress" />
                <Label Grid.Row="1" Grid.Column="1" Text="{Binding PushToken}" LineBreakMode="MiddleTruncation" />
            </Grid>

            <Button Text="Starta" Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}" />
            <Button Text="Uppdatera lokalt" Command="{Binding UpdateLocallyCommand}" />
            <Button Text="Uppdatera från servern" Command="{Binding UpdateFromServerCommand}" />
            <Button Text="Avsluta" Command="{Binding EndCommand}" />

            <Label Text="Eller på serverns broadcast-kanal: en push till kanalen når alla aktiviteter som följer den, utan token per enhet. iOS 18 följer APNs-kanalen, Android kanalens FCM-topic."
                   FontSize="12" TextColor="Gray" Margin="0,12,0,0" />

            <Button Text="Starta på kanal" Command="{Binding StartOnChannelCommand}" IsEnabled="{Binding CanStart}" />
            <Button Text="Broadcast från servern" Command="{Binding BroadcastFromServerCommand}" />

        </VerticalStackLayout>
    </ScrollView>

</SpinePage>
