<SpinePage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiSpinePushSampleApp.Pages.SendPage"
    x:TypeArguments="SendPageViewModel"
    x:DataType="SendPageViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">

            <Label Text="Ber sample-servern skicka. Kör den med dotnet run i MauiSpinePushSampleApp.Server."
                   FontSize="12" TextColor="Gray" />

            <Label Text="En push som kommer fram medan appen är i förgrunden visas inte — den här samplens handler svarar None och skriver bara en rad i Logg. Slå på fördröjningen nedan och lägg appen i bakgrunden om du vill se en riktig notis."
                   FontSize="12" TextColor="Gray" />

            <Label Text="Sort" />
            <Picker ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" />
            <Label Text="{Binding Explanation}" FontSize="12" TextColor="Gray" />

            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Bara till den här enheten" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding ToMe}" />
            </Grid>

            <Label Text="Tagguttryck" />
            <Entry Text="{Binding TagExpression}" IsEnabled="{Binding ToTags}" />

            <Label Text="Titel" IsVisible="{Binding ShowText}" />
            <Entry Text="{Binding NotificationTitle}" IsVisible="{Binding ShowText}" />

            <Label Text="Text" IsVisible="{Binding ShowText}" />
            <Entry Text="{Binding Body}" IsVisible="{Binding ShowText}" />

            <Label Text="Route" IsVisible="{Binding ShowRoute}" />
            <Entry Text="{Binding Route}" IsVisible="{Binding ShowRoute}" />

            <Label Text="Kanal" IsVisible="{Binding ShowChannel}" />
            <Entry Text="{Binding Channel}" IsVisible="{Binding ShowChannel}" />

            <Label Text="Knappar (kategori)" IsVisible="{Binding ShowChannel}" />
            <Entry Text="{Binding Category}" Placeholder="sample" IsVisible="{Binding ShowChannel}" />

            <Label Text="Bild" IsVisible="{Binding ShowChannel}" />
            <Entry Text="{Binding Image}" Placeholder="https://…" Keyboard="Url" IsVisible="{Binding ShowChannel}" />

            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowPriority}">
                <Label Text="Hög prioritet" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding HighPriority}" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Vänta 5 sekunder med att skicka" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding Delay}" />
            </Grid>

            <Button Text="Skicka" Command="{Binding SendCommand}" Margin="0,8,0,0" />
            <Label Text="{Binding Result}" FontSize="12" />

        </VerticalStackLayout>
    </ScrollView>

</SpinePage>
