	<!-- Mac Catalyst widgets: macOS blocks a group.* App Group without a provisioning profile, so the Mac
	     build uses the Team ID form, the same as Platforms/MacCatalyst/Entitlements.plist. The build must be
	     signed with that team's certificate: set CodesignKey, e.g. in MauiSpineSampleApp.csproj.user. -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
		<SpineWidgetsAppGroup>7F2CQZ9T84.se.cosmomedia.spineshowcase</SpineWidgetsAppGroup>
	</PropertyGroup>

	<!-- Widgets: the kinds below become a WidgetKit extension on iOS and Mac Catalyst; the providers are the [Widget] classes in Widgets\. -->
	<ItemGroup>
		<SpineWidget Include="sample" DisplayName="Spine sample" Description="A data-driven widget rendered from a tree the app builds." Families="Small,Medium" />
		<SpineWidget Include="score" DisplayName="Live score" Description="The game while it is on, then the next game and the latest results." Families="Small,Medium,AccessoryCircular,AccessoryRectangular,AccessoryInline" />
	</ItemGroup>
	<!-- Controls: Control Center on iOS 18, Quick Settings tiles on Android; the providers are the [Control] classes in Widgets\Hockey\. -->
	<ItemGroup>
		<SpineControl Include="goal-alerts" Type="Toggle" DisplayName="Goal alerts" Description="Hear about every goal in the live score, or not." Icon="bell" />
		<SpineControl Include="goal" Type="Button" DisplayName="Score a goal" Description="A goal for the Owls in the running game, without opening the app." Icon="hockey.puck" />
	</ItemGroup>
	<!-- The AI client page's on-device model: Apple Intelligence, from the .NET 10 preview of Essentials.AI (Q24). -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
		<PackageReference Include="Microsoft.Maui.Essentials.AI" />
	</ItemGroup>
	<PropertyGroup>
		<!-- Essentials.AI marks its types as an evaluation preview. -->
		<NoWarn>$(NoWarn);MAUIAI0001</NoWarn>
	</PropertyGroup>
