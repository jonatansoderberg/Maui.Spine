<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>$(SpineMauiTargetFrameworks)</TargetFrameworks>


		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>MauiBottomSheetPoc</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>

    <!--XAML Source Generator-->
    <MauiXamlInflator>SourceGen</MauiXamlInflator>
    
    <!-- Opt in to Material3 on Android	-->
    <UseMaterial3>true</UseMaterial3>
    
		<!-- Display name -->
		<ApplicationTitle>Spine Showcase</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>se.cosmomedia.spineshowcase</ApplicationId>
		<!-- Plugin.Maui.Spine.Scanner uses CameraX, which needs Android 6.0. -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\spinelogo.png" ForegroundScale="0.8" Color="#FFFFFF" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splashlogo.png" Color="#FFFFFF" BaseSize="160,160" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		<!-- The lightbox photos are shown at their own size; scaling them up for each density would only make them larger. -->
		<MauiImage Update="Resources\Images\lightbox_*.jpg" Resize="False" />

		<!-- Shortcut icons: the home screen draws them, so the build renders these SVGs into the app. -->
		<SpineShortcutIcon Include="timer" />
		<SpineShortcutIcon Include="stack" />
		<SpineShortcutIcon Include="qrcode" />
		<SpineShortcutIcon Include="theme" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AsyncAwaitBestPractices" />
		<PackageReference Include="CommunityToolkit.Mvvm" />
		<PackageReference Include="Microsoft.Maui.Controls" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" />
	</ItemGroup>

  
  
