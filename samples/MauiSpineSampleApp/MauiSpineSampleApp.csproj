	<!-- Sign in with Apple needs the capability in the App ID; build with -p:SpineSignInWithApple=true when it has it. -->
	<PropertyGroup Condition="'$(SpineSignInWithApple)' == 'true'">
		<DefineConstants>$(DefineConstants);SPINE_SIGN_IN_WITH_APPLE</DefineConstants>
	</PropertyGroup>
	<!-- The push sample server the Showcase signs in to and calls: this computer's by default, or the one in Azure for a
	     phone, -p:SpineSampleServer=https://… (samples/MauiSpinePushNotificationsSampleApp.Server/README.md). -->
	<PropertyGroup>
		<SpineSampleServer Condition="'$(SpineSampleServer)' == ''">http://localhost:5100/</SpineSampleServer>
	</PropertyGroup>
	<ItemGroup>
		<AssemblyMetadata Include="SpineSampleServer" Value="$(SpineSampleServer)" />
	</ItemGroup>

	<!-- A browser sign-in (Google through the server's broker off Android, Apple on Android and Windows) returns to the
	     app's scheme; the Android callback activity's intent filter comes from this. Google needs a Google Cloud project,
	     so it is on only in a build with -p:SpineGoogleServerClientId=<the Web client's id>, the id the push sample
	     server has as Auth:Google:WebClientId. -->
	<PropertyGroup>
		<SpineAuthenticationCallbackScheme>se.cosmomedia.spineshowcase</SpineAuthenticationCallbackScheme>
	</PropertyGroup>
	<PropertyGroup Condition="'$(SpineGoogleServerClientId)' != ''">
		<DefineConstants>$(DefineConstants);SPINE_SIGN_IN_WITH_GOOGLE</DefineConstants>
	</PropertyGroup>
	<ItemGroup Condition="'$(SpineGoogleServerClientId)' != ''">
		<AssemblyMetadata Include="SpineGoogleServerClientId" Value="$(SpineGoogleServerClientId)" />
	</ItemGroup>
	<!-- Passkeys belong to the server's domain, and the App ID needs Associated Domains, so they are on only in a build
	     with -p:SpinePasskeyDomain=<the server's host>, the Auth:Passkeys:RelyingPartyId of the push sample server
	     (spine-showcase-e41ddd.azurewebsites.net in Azure). -->
	<PropertyGroup Condition="'$(SpinePasskeyDomain)' != ''">
		<DefineConstants>$(DefineConstants);SPINE_PASSKEYS</DefineConstants>
	</PropertyGroup>
	<!-- Sign in with Microsoft needs an Entra app registration, so it is on only in a build with
	     -p:SpineMicrosoftClientId=<its Application (client) id>, the id the push sample server has as Auth:Microsoft:ClientId. -->
	<PropertyGroup Condition="'$(SpineMicrosoftClientId)' != ''">
		<DefineConstants>$(DefineConstants);SPINE_SIGN_IN_WITH_MICROSOFT</DefineConstants>
	</PropertyGroup>
	<ItemGroup Condition="'$(SpineMicrosoftClientId)' != ''">
		<AssemblyMetadata Include="SpineMicrosoftClientId" Value="$(SpineMicrosoftClientId)" />
	</ItemGroup>
