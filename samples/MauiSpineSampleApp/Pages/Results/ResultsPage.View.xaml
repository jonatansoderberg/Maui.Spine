<SpinePage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiSpineSampleApp.Pages.Results.ResultsPage"
    x:TypeArguments="ResultsPageViewModel"
    x:DataType="ResultsPageViewModel">

    <VerticalStackLayout Padding="20,16" Spacing="10">
            <PackageChips Packages="Plugin.Maui.Spine" />
        <Label Text="Navigation is typed: a page declares the parameter it takes and the result it returns, and the caller awaits NavigateToWithResultAsync."
               FontSize="14" />

        <Label Text="Result" FontAttributes="Bold" Margin="0,8,0,0" />
        <Button Text="Open a sheet that returns a result" Command="{Binding ShowFullscreenSheetWithResultCommand}" />
        <Label Text="{Binding SheetResult}" FontSize="14" HorizontalTextAlignment="Center" />

        <Label Text="Parameter" FontAttributes="Bold" Margin="0,8,0,0" />
        <Button Text="Open a page with a PersonData parameter" Command="{Binding ShowPersonDetailCommand}" />
    </VerticalStackLayout>

</SpinePage>
