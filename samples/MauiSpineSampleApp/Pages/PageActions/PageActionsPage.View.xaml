<SpinePage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiSpineSampleApp.Pages.PageActions.PageActionsPage"
    x:TypeArguments="PageActionsPageViewModel"
    x:DataType="PageActionsPageViewModel">

    <SampleLayout Packages="Plugin.Maui.Spine, Plugin.Maui.Spine.Svg.Icons">

        <Example Title="A header button from a command"
                 Summary="Put [PageAction] on a command and it becomes a button in the header bar: text or an icon, with nothing to wire up in the page.">
            <Label Text="{Binding Log}" FontSize="15" />
            <Example.Code>
                [PageAction("Filter")]
                [RelayCommand]
                private void Filter() { … }

                // An icon instead of text
                [PageAction(Svg = "bell.svg")]
                [RelayCommand]
                private void Bell() { … }
            </Example.Code>
        </Example>

        <Example Title="Change it while it shows"
                 Summary="A count on the button, a badge, greyed out or hidden: set the action's properties and the header follows at once. A hidden action gives its place to the next one."
                 OptionsCommand="{Binding ShowFilterOptionsCommand}">
            <VerticalStackLayout Spacing="10">
                <Button Text="Count up" Command="{Binding CountUpCommand}" />
                <Button Text="Clear count" Command="{Binding ClearCountCommand}" />
            </VerticalStackLayout>
            <Example.Code>
                var filter = PageActions.First(
                    a =&gt; a.Command == FilterCommand);

                filter.Text = $"Filter ({count})";
                filter.Badge = count.ToString();
                filter.IsEnabled = false;
                filter.IsVisible = false;
            </Example.Code>
        </Example>

        <Example Title="Show that it is working"
                 Summary="IsBusy dims the button and takes no taps until the work is done. SpinsWhenBusy turns its icon as well, finishing the turn it is on. ShowsBusy sets IsBusy for as long as an async command runs.">
            <Button Text="Ring the bell" Command="{Binding RingCommand}" />
            <Example.Code>
                [PageAction(Svg = "bell.svg", ShowsBusy = true, SpinsWhenBusy = true)]
                [RelayCommand]
                private Task Bell() => RingAsync();

                // Or by hand
                bell.IsBusy = true;
                try { await RingAsync(); }
                finally { bell.IsBusy = false; }
            </Example.Code>
        </Example>

        <Example Title="Replace the back button"
                 Summary="A Primary action takes the leading slot in place of Back: a Cancel on a page that edits something. Add it and remove it while the page shows.">
            <Button Text="{Binding CancelLabel}" Command="{Binding ToggleCancelCommand}" />
            <Example.Code>
                _cancel = new PageAction("Cancel", CancelCommand)
                {
                    Placement = PageActionPlacement.Primary,
                };
                PageActions.Add(_cancel);

                // Back returns
                PageActions.Remove(_cancel);
            </Example.Code>
        </Example>

    </SampleLayout>

</SpinePage>
