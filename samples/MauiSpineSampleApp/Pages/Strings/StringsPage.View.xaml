<SpinePage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiSpineSampleApp.Pages.Strings.StringsPage"
    x:TypeArguments="StringsPageViewModel"
    x:DataType="StringsPageViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="20,16" Spacing="10">
            <PackageChips Packages="Plugin.Maui.Spine, Plugin.Maui.Spine.Common" />

            <Label Text="{String Strings.Intro}" FontSize="14" />

            <Label Text="{String Strings.Language}" FontAttributes="Bold" Margin="0,8,0,0" />
            <HorizontalStackLayout Spacing="8"
                                   RadioButtonGroup.GroupName="Language"
                                   RadioButtonGroup.SelectedValue="{Binding SelectedLanguage}">
                <RadioButton Content="English" Value="en" />
                <RadioButton Content="Svenska" Value="sv" />
            </HorizontalStackLayout>

            <Label Text="Format arguments" FontAttributes="Bold" Margin="0,8,0,0" />
            <Label Text="{String Strings.Greeting, Args={Binding UserName}, Arg1={Binding Now}}" FontSize="16" />

            <Label Text="Plural: key.one, key.zero, key.other" FontAttributes="Bold" Margin="0,8,0,0" />
            <Label Text="{String Strings.Apples, Count={Binding Apples}}" FontSize="16" />
            <HorizontalStackLayout Spacing="8">
                <Button Text="{String Strings.More}" Command="{Binding MoreCommand}" />
                <Button Text="{String Strings.Fewer}" Command="{Binding FewerCommand}" />
            </HorizontalStackLayout>

            <Label Text="From C# through ISpineStrings" FontAttributes="Bold" Margin="0,8,0,0" />
            <Label Text="{Binding FromCode}" FontSize="16" />

            <Label Text="Overriding a package key" FontAttributes="Bold" Margin="0,8,0,0" />
            <Label Text="{String Strings.OverrideNote}" FontSize="14" />
            <Label Text="{String Header.Back}" FontSize="16" />

            <Label Text="A missing key shows as the key" FontAttributes="Bold" Margin="0,8,0,0" />
            <Label Text="{Binding Missing}" FontSize="16" />

            <Border StrokeThickness="0" BackgroundColor="#22808080" Padding="10,8" StrokeShape="RoundRectangle 8" Margin="0,8,0,0">
                <Label FontSize="11" FontFamily="{OnPlatform iOS=Menlo, MacCatalyst=Menlo, Android=monospace, WinUI=Consolas}"
                       Text="&lt;!-- Resources/Strings/strings.sv.xml, embedded --&gt;&#10;&lt;strings culture=&quot;sv&quot;&gt;&#10;  &lt;s key=&quot;Strings.Greeting&quot;&gt;Hej {0}, klockan är {1:HH:mm}.&lt;/s&gt;&#10;  &lt;s key=&quot;Strings.Apples.one&quot;&gt;{0} äpple i korgen&lt;/s&gt;&#10;  &lt;s key=&quot;Strings.Apples.other&quot;&gt;{0} äpplen i korgen&lt;/s&gt;&#10;  &lt;s key=&quot;Header.Back&quot;&gt;Hem&lt;/s&gt;   &lt;!-- overrides Spine --&gt;&#10;&lt;/strings&gt;&#10;&#10;&lt;Label Text=&quot;{String Strings.Greeting, Args={Binding UserName}}&quot; /&gt;&#10;&lt;Label Text=&quot;{String Strings.Apples, Count={Binding Apples}}&quot; /&gt;&#10;&#10;_strings.Get(&quot;Strings.Apples&quot;, count);&#10;_strings.Culture = CultureInfo.GetCultureInfo(&quot;sv&quot;);   // stored" />
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</SpinePage>
