<SpinePage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiSpineSampleApp.Pages.DataGrid.DataGridPage"
    x:TypeArguments="DataGridPageViewModel"
    x:DataType="DataGridPageViewModel">

    <SpinePage.Resources>
        <x:String x:Key="GridTitle">One grid, any width</x:String>
        <x:String x:Key="GridSummary">Columns say what the data is, layouts say where it goes: a table when the window is wide, two-line rows on a phone. Rotate to switch.</x:String>
    </SpinePage.Resources>

    <!-- The grid is the demo and fills the page, so it cannot sit in SampleLayout's scroll view:
         the example sits above it, and Code swaps both for a SampleLayout with the code. -->
    <Grid>
        <Grid RowDefinitions="Auto,*" RowSpacing="8" IsVisible="{Binding ShowGrid}">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup Name="Width">
                    <VisualState Name="Narrow">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter TargetName="Products" Property="DataGrid.LayoutMode" Value="Narrow" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState Name="Wide">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="640" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter TargetName="Products" Property="DataGrid.LayoutMode" Value="Wide" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <VerticalStackLayout Margin="{x:Static HeaderBarConstants.PagePadding}" Padding="0,8,0,0" Spacing="12">
                <ExampleCodeSwitch />
                <PackageChips Packages="Plugin.Maui.Spine.Controls.DataGrid" />
                <Example Title="{StaticResource GridTitle}"
                         Summary="{StaticResource GridSummary}"
                         OptionsCommand="{Binding ShowGridOptionsCommand}"
                         Margin="0,12,0,0">
                    <Label Text="{Binding LastAction}" FontSize="14" MaxLines="2" LineBreakMode="TailTruncation" />
                </Example>
            </VerticalStackLayout>

            <DataGrid x:Name="Products" Grid.Row="1"
                      ItemsSource="{Binding Products}"
                      GroupByPath="{Binding GroupByPath}"
                      RowTappedCommand="{Binding RowTappedCommand}"
                      RefreshCommand="{Binding RefreshCommand}"
                      IsRefreshing="{Binding IsRefreshing}"
                      IsRefreshEnabled="{Binding IsRefreshEnabled}"
                      IsCellCopyEnabled="{Binding IsCellCopyEnabled}"
                      RowContextMenu="{Binding RowMenu}"
                      LoadMoreCommand="{Binding LoadMoreCommand}"
                      HasMoreItems="{Binding HasMoreItems}"
                      IsLoadingMore="{Binding IsLoadingMore}"
                      ShowLoadedStatus="True">
                <DataGrid.Columns>
                    <DataGridColumn Key="Sku" Header="SKU" BindingPath="Sku" IsSortable="True"
                                    CellCommand="{Binding OpenSkuCommand}" />
                    <DataGridColumn Key="Name" Header="Product name" BindingPath="Name" IsSortable="True" />
                    <DataGridColumn Key="Category" Header="Category" BindingPath="Category" IsSortable="True" />
                    <DataGridColumn Key="Price" Header="Price" BindingPath="Price" Type="Price" IsSortable="True"
                                    HorizontalTextAlignment="End" />
                    <DataGridColumn Key="Stock" Header="In stock" BindingPath="Stock" IsSortable="True"
                                    HorizontalTextAlignment="End" />
                    <DataGridColumn Key="Updated" Header="Updated" BindingPath="Updated" Type="Date" IsSortable="True" />
                    <DataGridColumn Key="Favourite" Header="Starred" BindingPath="IsFavourite" Type="Checkbox"
                                    CellCommand="{Binding ToggleFavouriteCommand}" />
                </DataGrid.Columns>

                <DataGrid.Layouts>
                    <DataGridLayout Name="Wide" HeaderMode="TopHeaderRow"
                                    ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto">
                        <DataGridCellPlacement ColumnKey="Sku" Column="0" />
                        <DataGridCellPlacement ColumnKey="Name" Column="1" />
                        <DataGridCellPlacement ColumnKey="Category" Column="2" />
                        <DataGridCellPlacement ColumnKey="Price" Column="3" />
                        <DataGridCellPlacement ColumnKey="Stock" Column="4" />
                        <DataGridCellPlacement ColumnKey="Updated" Column="5" />
                        <DataGridCellPlacement ColumnKey="Favourite" Column="6" HorizontalTextAlignment="Center" />
                    </DataGridLayout>

                    <DataGridLayout Name="Narrow" HeaderMode="StaticLayoutHeader"
                                    ColumnDefinitions="*,Auto,Auto" RowDefinitions="*,*">
                        <DataGridCellPlacement ColumnKey="Name" Column="0" Row="0" VerticalTextAlignment="End" />
                        <DataGridCellPlacement ColumnKey="Sku" Column="0" Row="1" VerticalTextAlignment="Start" />
                        <DataGridCellPlacement ColumnKey="Price" Column="1" Row="0" VerticalTextAlignment="End" />
                        <DataGridCellPlacement ColumnKey="Stock" Column="1" Row="1" VerticalTextAlignment="Start" />
                        <DataGridCellPlacement ColumnKey="Favourite" Column="2" Row="0" RowSpan="2" />
                    </DataGridLayout>
                </DataGrid.Layouts>

                <DataGrid.LeftSwipeActions>
                    <DataGridSwipeAction Text="Star" IconSvg="Pin.svg" Command="{Binding ToggleFavouriteCommand}" />
                </DataGrid.LeftSwipeActions>
                <DataGrid.RightSwipeActions>
                    <DataGridSwipeAction Text="Delete" IconSvg="Trashcan.svg" BackgroundColor="#E5484D"
                                         Command="{Binding DeleteCommand}" />
                </DataGrid.RightSwipeActions>
            </DataGrid>
        </Grid>

        <SampleLayout Packages="Plugin.Maui.Spine.Controls.DataGrid" IsVisible="{Binding ShowCode}" SafeArea.ScrollInset="Bottom">
            <Example Title="{StaticResource GridTitle}" Summary="{StaticResource GridSummary}">
                <Example.Code>
                    &lt;DataGrid x:Name="Products"
                              ItemsSource="{Binding Products}"
                              RowTappedCommand="{Binding OpenCommand}"
                              RowContextMenu="{Binding RowMenu}"
                              GroupByPath="Category"&gt;
                      &lt;DataGrid.Columns&gt;
                        &lt;DataGridColumn Key="Name" BindingPath="Name"
                                        Header="Product" IsSortable="True" /&gt;
                        &lt;DataGridColumn Key="Price" BindingPath="Price"
                                        Header="Price" Type="Price" /&gt;
                        &lt;DataGridColumn Key="Stock" BindingPath="Stock"
                                        Header="In stock" /&gt;
                      &lt;/DataGrid.Columns&gt;

                      &lt;DataGrid.Layouts&gt;
                        &lt;DataGridLayout Name="Wide" HeaderMode="TopHeaderRow"
                                        ColumnDefinitions="*,Auto,Auto"&gt;
                          &lt;DataGridCellPlacement ColumnKey="Name" /&gt;
                          &lt;DataGridCellPlacement ColumnKey="Price" Column="1" /&gt;
                          &lt;DataGridCellPlacement ColumnKey="Stock" Column="2" /&gt;
                        &lt;/DataGridLayout&gt;
                        &lt;DataGridLayout Name="Narrow" RowDefinitions="*,*"
                                        ColumnDefinitions="*,Auto"&gt;
                          &lt;DataGridCellPlacement ColumnKey="Name" /&gt;
                          &lt;DataGridCellPlacement ColumnKey="Price" Column="1" /&gt;
                          &lt;DataGridCellPlacement ColumnKey="Stock" Row="1"
                                                 Column="1" /&gt;
                        &lt;/DataGridLayout&gt;
                      &lt;/DataGrid.Layouts&gt;

                      &lt;DataGrid.RightSwipeActions&gt;
                        &lt;DataGridSwipeAction Text="Delete"
                                             Command="{Binding DeleteCommand}" /&gt;
                      &lt;/DataGrid.RightSwipeActions&gt;
                    &lt;/DataGrid&gt;

                    &lt;!-- The page picks the layout by width --&gt;
                    &lt;AdaptiveTrigger MinWindowWidth="640" /&gt;
                    &lt;Setter TargetName="Products"
                            Property="DataGrid.LayoutMode" Value="Wide" /&gt;

                    // One menu for every row; a long press or a right click
                    // opens it, with "Copy &lt;column&gt;" on top.
                    RowMenu =
                    [
                        new MenuSection
                        {
                            new MenuAction("Details", "info.svg", OpenCommand),
                            new MenuAction("Star", "star.svg", StarCommand),
                        },
                        new MenuAction("Delete", "trashcan.svg", DeleteCommand)
                            { IsDestructive = true },
                    ];

                    // Also: RefreshCommand for pull to refresh,
                    // LoadMoreCommand and HasMoreItems for paging.
                    // No registration: the grid's texts load on first use.
                </Example.Code>
            </Example>
        </SampleLayout>
    </Grid>

</SpinePage>
