<SpinePage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiSpineSampleApp.Pages.Avatars.AvatarDetailPage"
    x:TypeArguments="AvatarDetailPageViewModel"
    x:DataType="AvatarDetailPageViewModel">

    <SampleLayout Packages="Plugin.Maui.Spine.Controls.Avatar, Plugin.Maui.Spine.Speech, Plugin.Maui.Spine.Voice">

        <Example Title="{Binding Entry.Title}"
                 Summary="{Binding Entry.Summary}">
            <VerticalStackLayout Spacing="12">
                <AvatarView x:Name="Avatar"
                            Source="{Binding Entry.Source}"
                            Driver="{Binding Driver}"
                            State="{Binding State, Mode=TwoWay}"
                            IsMuted="{Binding IsMuted}"
                            Expression="{Binding Expression}"
                            MotionMode="{Binding MotionMode}"
                            MaxFramesPerSecond="{Binding FrameRate}"
                            Preset="{Binding Preset}"
                            BodyColor="{Binding BodyColor}"
                            HeightRequest="{Binding Size}"
                            WidthRequest="{Binding Size}"
                            HorizontalOptions="Center" />
                <Label FontSize="13" Opacity="0.7" HorizontalTextAlignment="Center">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding Source={x:Reference Avatar}, Path=RendererName, x:DataType=AvatarView}" />
                            <Span Text=" · lip sync " />
                            <Span Text="{Binding Source={x:Reference Avatar}, Path=LipSyncQuality, x:DataType=AvatarView}" />
                            <Span Text=" · " />
                            <Span Text="{Binding Source={x:Reference Avatar}, Path=LoadState, x:DataType=AvatarView}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <!-- A package with figures (format 1.1): one package, many figures, chosen without loading again. -->
                <VerticalStackLayout Spacing="10" IsVisible="{Binding HasChoices}">
                    <Label Text="{Binding FigureName}" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                    <FlexLayout Wrap="Wrap" JustifyContent="Center" BindableLayout.ItemsSource="{Binding Figures}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="FigureChoice">
                                <VerticalStackLayout Margin="4,0,4,8" WidthRequest="64" Spacing="2"
                                                     Tap.Command="{PageCommand ChooseFigure}" Tap.CommandParameter="{Binding .}"
                                                     SemanticProperties.Description="{Binding Name}">
                                    <AvatarView Source="{Binding Source}" Preset="{Binding Preset}" HeightRequest="56" WidthRequest="56"
                                                MaxFramesPerSecond="15" InputTransparent="True" HorizontalOptions="Center" />
                                    <Label Text="{Binding Name}" FontSize="11" Opacity="0.75" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                    <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Options}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="OptionChoice">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Title}" VerticalOptions="Center" />
                                    <Picker Grid.Column="1" ItemsSource="{Binding Values}" SelectedItem="{Binding Selected}" MinimumWidthRequest="140" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Swatches}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="SwatchChoice">
                                    <Border WidthRequest="30" HeightRequest="30" Margin="0,0,8,8" StrokeThickness="0" BackgroundColor="{Binding Color}"
                                            Tap.Command="{PageCommand ChooseSwatch}" Tap.CommandParameter="{Binding .}"
                                            SemanticProperties.Description="{Binding Name}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="15" />
                                        </Border.StrokeShape>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                        <Button Grid.Column="1" Text="Own colour" Command="{Binding ChooseSwatchCommand}" VerticalOptions="Start" />
                    </Grid>
                    <Label Text="One package of 33 KB holds these figures: a figure picks a shape, eyes and colour; Shape and Eyes change one choice over it, and a colour replaces the figure's own. Nothing loads again." FontSize="13" Opacity="0.7" />
                </VerticalStackLayout>

                <SegmentedControl SelectedIndex="{Binding DriverIndex}">
                    <Segment Title="Manual" />
                    <Segment Title="Text" />
                    <Segment Title="Speak" />
                    <Segment Title="Listen" />
                </SegmentedControl>

                <VerticalStackLayout Spacing="10" IsVisible="{Binding IsManual}">
                    <Label Text="Your app drives the avatar itself: it sets the state, the expression and the badge as its conversation goes. Try each part, or set them below." FontSize="13" Opacity="0.7" />
                    <FlexLayout Wrap="Wrap">
                        <Button Text="Try the states" Command="{Binding TryStatesCommand}" Margin="0,0,8,8" />
                        <Button Text="Try the expressions" Command="{Binding TryExpressionsCommand}" Margin="0,0,8,8" />
                        <Button Text="Try the microphone badge" Command="{Binding TryMuteCommand}" Margin="0,0,8,8" />
                    </FlexLayout>
                    <Label Text="{Binding TryStatus}" FontSize="14" />
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                        <Label Text="State" VerticalOptions="Center" />
                        <Picker Grid.Column="1" ItemsSource="{Binding States}" SelectedItem="{Binding State}" MinimumWidthRequest="140" />
                        <Label Grid.Row="1" Text="Expression" VerticalOptions="Center" />
                        <Picker Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Expressions}" SelectedItem="{Binding Expression}" MinimumWidthRequest="140" />
                        <Label Grid.Row="2" Text="Microphone-off badge" VerticalOptions="Center" />
                        <Switch Grid.Row="2" Grid.Column="1" IsToggled="{Binding IsMuted}" />
                    </Grid>
                    <Label Text="The badge tells the user their microphone is muted; it opens or mutes nothing itself. Avatars without a badge show nothing for it." FontSize="13" Opacity="0.7" />
                    <Label Text="A timed expression" FontAttributes="Bold" />
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                        <Picker ItemsSource="{Binding Expressions}" SelectedItem="{Binding TimedExpression}" />
                        <Button Grid.Column="1" Text="Show" Command="{Binding ShowExpressionCommand}" />
                        <Slider Grid.Row="1" Minimum="0" Maximum="1" Value="{Binding Intensity}" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding Intensity, StringFormat='intensity {0:0.00}'}" VerticalOptions="Center" />
                        <Slider Grid.Row="2" Minimum="0.5" Maximum="8" Value="{Binding DurationSeconds}" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding DurationSeconds, StringFormat='{0:0.0} s'}" VerticalOptions="Center" />
                    </Grid>
                    <Label Text="Gestures" FontAttributes="Bold" />
                    <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Source={x:Reference Avatar}, Path=Gestures, x:DataType=AvatarView}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Button Text="{Binding .}" Command="{PageCommand Gesture}" CommandParameter="{Binding .}" Margin="0,0,8,8" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                    <Button Text="Interrupt" Command="{Binding InterruptCommand}" HorizontalOptions="Start" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10" IsVisible="{Binding IsText}">
                    <Editor Text="{Binding Text}" AutoSize="TextChanges" />
                    <HorizontalStackLayout Spacing="10">
                        <Button Text="Mouth it" Command="{Binding MouthCommand}" />
                        <Button Text="Stream it" Command="{Binding StreamCommand}" />
                        <Button Text="Stop" Command="{Binding StopCommand}" />
                    </HorizontalStackLayout>
                    <Label Text="No sound here: the mouth follows the text alone, as when a chat answer is shown on screen. Mouth it takes the whole text at once. Stream it acts out an answer arriving piece by piece: Thinking first, then the mouth moves word by word as the words come in." FontSize="13" Opacity="0.7" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10" IsVisible="{Binding IsSpeak}">
                    <Picker Title="Voice" ItemsSource="{Binding Voices}" SelectedItem="{Binding Voice}" />
                    <Editor Text="{Binding Text}" AutoSize="TextChanges" />
                    <HorizontalStackLayout Spacing="10">
                        <Button Text="Speak" Command="{Binding SpeakCommand}" />
                        <Button Text="Stop" Command="{Binding StopSpeakingCommand}" />
                    </HorizontalStackLayout>
                    <Label Text="{Binding SpeechStatus}" FontSize="13" Opacity="0.8" />
                    <Label Text="A voice reads the text aloud and the mouth follows each word as it is spoken. The device's voices come first (better ones download in Settings, Accessibility, Spoken Content); the server's voices at the end send their own mouth shapes with the audio." FontSize="13" Opacity="0.7" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10" IsVisible="{Binding IsListen}">
                    <HorizontalStackLayout Spacing="10">
                        <Button Text="Listen" Command="{Binding StartEngineCommand}" />
                        <Button Text="Play an answer" Command="{Binding PlayReferenceCommand}" />
                        <Button Text="Stop" Command="{Binding StopEngineCommand}" />
                    </HorizontalStackLayout>
                    <Label Text="{Binding ListenStatus}" FontSize="14" />
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="6" IsVisible="{Binding IsEngineRunning}">
                        <Label Text="You" VerticalOptions="Center" />
                        <ProgressBar Grid.Column="1" Progress="{Binding InputLevel}" VerticalOptions="Center" />
                        <Label Grid.Row="1" Text="Answer" VerticalOptions="Center" />
                        <ProgressBar Grid.Row="1" Grid.Column="1" Progress="{Binding OutputLevel}" VerticalOptions="Center" />
                    </Grid>
                    <Label Text="A voice conversation's sound drives the avatar: Listen opens the microphone and the avatar listens as you talk; Play an answer plays a recorded reply and the mouth follows it, as when an assistant answers. Nothing is sent anywhere." FontSize="13" Opacity="0.7" />
                </VerticalStackLayout>
            </VerticalStackLayout>
            <Example.Code>
                &lt;AvatarView Source="{Binding Avatar}" Driver="{Binding Driver}" State="{Binding State}" /&gt;

                // A package with figures (format 1.1), such as Mini:
                &lt;AvatarView Source="mini.spineavatar" Preset="blue" BodyColor="{StaticResource Brand}" /&gt;
                avatar.SetOption("shape", "drop");          // over the figure; null gives it back

                avatar.SetExpression(new(AvatarExpression.Happy, 0.9f, TimeSpan.FromSeconds(3)));
                await avatar.PlayGestureAsync("nod");

                var speech = new SpeechAvatarDriver(spineSpeech);   // Plugin.Maui.Spine.Speech
                Driver = speech;
                await speech.SpeakAsync("Welcome back", new SpeakOptions { Language = "en-GB" });

                var server = services.GetRequiredService&lt;ServerSpeech&gt;();   // Plugin.Maui.Spine.Voice
                server.Feature = "Read";                    // a Kind: Speech feature on the app's server
                Driver = new SpeechAvatarDriver(server);    // TimedVisemes when the server sends them

                var text = new TextAvatarDriver();
                Driver = text;
                text.Mouth("Hello!");                       // or, as an answer streams in:
                text.Begin(); text.Append(delta); text.Complete();
            </Example.Code>
        </Example>

        <Example Title="Size, motion and frame rate"
                 Summary="The same avatar at 64, 128 and 320 points. Reduced holds a still pose and draws four times a second; System follows the platform's Reduce Motion. The theme menu in the header bar shows the light and dark colours.">
            <VerticalStackLayout Spacing="10">
                <SegmentedControl SelectedIndex="{Binding SizeIndex}">
                    <Segment Title="64" />
                    <Segment Title="128" />
                    <Segment Title="320" />
                </SegmentedControl>
                <SegmentedControl SelectedIndex="{Binding MotionIndex}">
                    <Segment Title="System" />
                    <Segment Title="Reduced" />
                    <Segment Title="Full" />
                </SegmentedControl>
                <SegmentedControl SelectedIndex="{Binding FrameRateIndex}">
                    <Segment Title="15 fps" />
                    <Segment Title="30 fps" />
                    <Segment Title="60 fps" />
                </SegmentedControl>
            </VerticalStackLayout>
            <Example.Code>
                &lt;AvatarView MotionMode="System" MaxFramesPerSecond="30" AccentColor="{StaticResource Primary}" /&gt;
            </Example.Code>
        </Example>

    </SampleLayout>
</SpinePage>
