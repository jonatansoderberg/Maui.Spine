<SpinePage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiSpineSampleApp.Pages.Avatars.AvatarsPage"
    x:TypeArguments="AvatarsPageViewModel"
    x:DataType="AvatarsPageViewModel">

    <SampleLayout Packages="Plugin.Maui.Spine.Controls.Avatar">

        <Example Title="Bundled, built in and hosted"
                 Summary="Bars and Ring are built into Spine (Source=&quot;bars&quot;) and show a voice's sound in and out; five more ship as MauiAssets, Mini with nine figures in one package; the rest are hosted by the sample server. A hosted avatar shows the server's poster, version and size until it is downloaded; then the app keeps it in its data folder, opens it from there, and offers an update when the server lists a later version (each download checked against the server's SHA-256). Every card shows its package's own poster, light or dark with the theme, so the list draws nothing per frame; the avatar comes alive on its page. Tap one to drive it.">
            <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Items}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="AvatarItem">
                        <Border Padding="12" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#F2F3F5, Dark=#1C1D21}"
                                Tap.Command="{PageCommand Open}" Tap.CommandParameter="{Binding .}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="96,*" ColumnSpacing="12" Semantic.Merge="True">
                                    <!-- One image per theme: an AppThemeBinding of two Bindings left Source unset. -->
                                    <Image Source="{Binding Entry.Poster.Light}" IsVisible="{AppThemeBinding Light=True, Dark=False}" HeightRequest="96" WidthRequest="96" Aspect="AspectFit" />
                                    <Image Source="{Binding Entry.Poster.Dark}" IsVisible="{AppThemeBinding Light=False, Dark=True}" HeightRequest="96" WidthRequest="96" Aspect="AspectFit" />
                                    <AvatarView Source="{Binding Entry.LiveSource}" IsVisible="{Binding Entry.Live}" HeightRequest="96" WidthRequest="96" MaxFramesPerSecond="15" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                        <Label Text="{Binding Entry.Title}" FontSize="17" FontAttributes="Bold" />
                                        <Label Text="{Binding Entry.Summary}" FontSize="14" Opacity="0.75" />
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="{Binding Entry.Profile}" FontSize="12" Padding="8,2" BackgroundColor="{AppThemeBinding Light=#E3E5EA, Dark=#2C2E34}" />
                                            <Label Text="{Binding Entry.Renderer}" FontSize="12" Padding="8,2" BackgroundColor="{AppThemeBinding Light=#E3E5EA, Dark=#2C2E34}" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Grid>
                                <!-- A hosted avatar: where it stands, and what can be done. -->
                                <VerticalStackLayout Spacing="8" IsVisible="{Binding IsHosted}">
                                    <ProgressBar Progress="{Binding Progress}" IsVisible="{Binding IsDownloading}" />
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                        <Label Text="{Binding Status}" FontSize="13" Opacity="0.75" VerticalOptions="Center" />
                                        <Button Grid.Column="1" Text="{Binding GetText}" IsVisible="{Binding CanGet}"
                                                Command="{PageCommand Get}" CommandParameter="{Binding .}"
                                                FontSize="14" Padding="12,4" HeightRequest="32" MinimumHeightRequest="32" CornerRadius="16" />
                                        <Button Grid.Column="2" Text="Cancel" IsVisible="{Binding IsDownloading}"
                                                Command="{PageCommand Cancel}" CommandParameter="{Binding .}"
                                                FontSize="14" Padding="12,4" HeightRequest="32" MinimumHeightRequest="32" CornerRadius="16"
                                                BackgroundColor="#22808080" TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                                        <Button Grid.Column="3" Text="Remove" IsVisible="{Binding Kept}"
                                                Command="{PageCommand Forget}" CommandParameter="{Binding .}"
                                                FontSize="14" Padding="12,4" HeightRequest="32" MinimumHeightRequest="32" CornerRadius="16"
                                                BackgroundColor="#22808080" TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <Example.Code>
                &lt;Image Source="{Binding PosterLight}" IsVisible="{AppThemeBinding Light=True, Dark=False}" /&gt;
                &lt;AvatarView Source="{Binding Avatar}" MaxFramesPerSecond="15" /&gt;   &lt;!-- on the avatar's own page --&gt;

                // Bundled and built in:
                Avatar = AvatarSource.FromMauiAsset("Avatars/nova.spineavatar");
                Avatar = AvatarSource.BuiltIn("bars");

                // Hosted: listed by the server, downloaded when asked, updated when the server has a later version.
                var path = Path.Combine(FileSystem.AppDataDirectory, "avatars", offered.File);
                if (offered.IsNewerThan(AvatarDownloads.VersionOf(path)))
                    await AvatarDownloads.DownloadAsync(http, offered, path, progress, cancellationToken);
                Avatar = AvatarSource.FromFile(path);
            </Example.Code>
        </Example>

    </SampleLayout>
</SpinePage>
