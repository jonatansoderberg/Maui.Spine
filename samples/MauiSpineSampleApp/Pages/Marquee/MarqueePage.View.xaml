<SpinePage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiSpineSampleApp.Pages.Marquee.MarqueePage"
    x:TypeArguments="MarqueePageViewModel"
    x:DataType="MarqueePageViewModel">

    <SampleLayout Packages="Plugin.Maui.Spine.Controls.AnimatedLabel">

        <Example Title="Long text scrolls, short text stays"
                 Summary="One line for a title that may not fit, like a song or an address. Text that fits stays still; text that is too wide glides side to side, with soft edges."
                 OptionsCommand="{Binding ShowScrollOptionsCommand}">
            <VerticalStackLayout Spacing="10">
                <Border Padding="10,6" BackgroundColor="#1DB954" StrokeShape="RoundRectangle 8">
                    <AnimatedLabel Text="Now Playing" FontSize="15" FontAttributes="Bold" TextColor="White" />
                </Border>
                <Border Padding="10,6" BackgroundColor="#282828" StrokeShape="RoundRectangle 8">
                    <AnimatedLabel Text="The Weeknd — Blinding Lights (Extended Radio Mix) · After Hours · Republic Records"
                                   FontSize="14" TextColor="White"
                                   ScrollSpeedDpPerSecond="{Binding ScrollSpeed}"
                                   PauseAtEndsMs="{Binding PauseAtEnds}"
                                   FadeEdgeWidthDp="{Binding FadeEdgeWidth}" />
                </Border>
            </VerticalStackLayout>
            <Example.Code>
                &lt;AnimatedLabel Text="{Binding Title}"
                               FontSize="14"
                               TextColor="White" /&gt;

                // Optional, shown with their defaults
                ScrollSpeedDpPerSecond="38"
                PauseAtEndsMs="2000"
                FadeEdgeWidthDp="8"
            </Example.Code>
        </Example>

        <Example Title="New text without a jump"
                 Summary="When the text changes, the label fades to the new line, and it can keep scrolling from where it was instead of starting over."
                 OptionsCommand="{Binding ShowChangeOptionsCommand}">
            <VerticalStackLayout Spacing="10">
                <Border Padding="10,6" BackgroundColor="#282828" StrokeShape="RoundRectangle 8">
                    <AnimatedLabel Text="{Binding DynamicText}" FontSize="14" TextColor="White"
                                   EnableFadeOnTextChange="{Binding FadeOnChange}"
                                   ResetOnTextUpdate="{Binding RestartOnChange}" />
                </Border>
                <Button Text="Change the text" Command="{Binding ChangeDynamicTextCommand}" />
            </VerticalStackLayout>
            <Example.Code>
                &lt;AnimatedLabel Text="{Binding NowPlaying}"
                               EnableFadeOnTextChange="True"
                               ResetOnTextUpdate="False" /&gt;
            </Example.Code>
        </Example>

        <Example Title="Numbers that roll"
                 Summary="For a score, a count or a countdown. Only the digits that change roll, upwards when the number grows and downwards when it shrinks. With Reduce Motion on, the number fades instead."
                 OptionsCommand="{Binding ShowRollOptionsCommand}">
            <VerticalStackLayout Spacing="10">
                <Border Padding="10,6" BackgroundColor="#282828" StrokeShape="RoundRectangle 8">
                    <AnimatedLabel Text="{Binding Score}" Mode="RollingNumber"
                                   FontSize="28" FontAttributes="Bold" TextColor="White"
                                   HorizontalTextAlignment="{Binding RollAlignment}"
                                   RollDurationMs="{Binding RollDuration}" />
                </Border>
                <Border Padding="10,6" BackgroundColor="#282828" StrokeShape="RoundRectangle 8">
                    <AnimatedLabel Text="{Binding Countdown}" Mode="RollingNumber"
                                   FontSize="20" TextColor="White"
                                   HorizontalTextAlignment="{Binding RollAlignment}"
                                   RollDurationMs="{Binding RollDuration}" />
                </Border>
                <HorizontalStackLayout Spacing="8">
                    <Button Text="−1" Command="{Binding AddCommand}" CommandParameter="-1" />
                    <Button Text="+1" Command="{Binding AddCommand}" CommandParameter="1" />
                    <Button Text="+95" Command="{Binding AddCommand}" CommandParameter="95" />
                    <Button Text="Count down" Command="{Binding CountDownCommand}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
            <Example.Code>
                &lt;AnimatedLabel Text="{Binding Score}"
                               Mode="RollingNumber" /&gt;

                // Optional, shown with their defaults
                HorizontalTextAlignment="Start"
                RollDurationMs="350"
            </Example.Code>
        </Example>

        <Example Title="Metal that catches the light"
                 Summary="Text and an icon as polished metal in their colour, with a glint that sweeps over them now and then, for a badge or a tier someone earned. Nothing runs between sweeps, and Reduce Motion keeps the metal still."
                 OptionsCommand="{Binding ShowSheenOptionsCommand}">
            <VerticalStackLayout Spacing="10">
                <Border Padding="14,12" BackgroundColor="#0B0E12" StrokeShape="RoundRectangle 12" StrokeThickness="0">
                    <VerticalStackLayout Spacing="10">
                        <AnimatedLabel x:Name="Gold" Text="GULD · APPSUPPORTER" TextColor="#D9B662" FontSize="13" FontAttributes="Bold"
                                       CharacterSpacing="{Binding SheenSpacing}" Icon="{Binding SheenIcon}" IconLineWidthScale="1.6"
                                       Sheen="{Binding Sheen}" SheenIntervalMs="{Binding SheenInterval}" SheenDurationMs="{Binding SheenDuration}" />
                        <AnimatedLabel x:Name="Silver" Text="SILVER · APPSUPPORTER" TextColor="#C3CAD2" FontSize="13" FontAttributes="Bold"
                                       CharacterSpacing="{Binding SheenSpacing}" Icon="{Binding SheenIcon}" IconLineWidthScale="1.6"
                                       Sheen="{Binding Sheen}" SheenIntervalMs="{Binding SheenInterval}" SheenDurationMs="{Binding SheenDuration}" />
                        <AnimatedLabel x:Name="Bronze" Text="BRONS · APPSUPPORTER" TextColor="#B88965" FontSize="13" FontAttributes="Bold"
                                       CharacterSpacing="{Binding SheenSpacing}" Icon="{Binding SheenIcon}" IconLineWidthScale="1.6"
                                       Sheen="{Binding Sheen}" SheenIntervalMs="{Binding SheenInterval}" SheenDurationMs="{Binding SheenDuration}" />
                        <AnimatedLabel x:Name="Big" Text="Guldmedalj" TextColor="#D9B662" FontSize="30" FontAttributes="Bold"
                                       Icon="{Binding SheenIcon}" IconLineWidthScale="1.2"
                                       Sheen="{Binding Sheen}" SheenIntervalMs="{Binding SheenInterval}" SheenDurationMs="{Binding SheenDuration}" />
                    </VerticalStackLayout>
                </Border>
                <Border Padding="14,12" BackgroundColor="#F4F1EA" StrokeShape="RoundRectangle 12" StrokeThickness="0">
                    <AnimatedLabel x:Name="Light" Text="GULD · APPSUPPORTER" TextColor="#A8822E" FontSize="13" FontAttributes="Bold"
                                   CharacterSpacing="{Binding SheenSpacing}" Icon="{Binding SheenIcon}" IconLineWidthScale="1.6"
                                   Sheen="{Binding Sheen}" SheenIntervalMs="{Binding SheenInterval}" SheenDurationMs="{Binding SheenDuration}" />
                </Border>
                <Button Text="Glint now" Clicked="OnGlintNow" />
            </VerticalStackLayout>
            <Example.Code>
                &lt;AnimatedLabel Text="GULD · APPSUPPORTER"
                               TextColor="#D9B662"
                               Icon="Crown.svg"
                               CharacterSpacing="1"
                               Sheen="Metal" /&gt;

                // Optional, shown with their defaults
                SheenIntervalMs="8000"
                SheenDurationMs="900"
                IconSize="0"          // 1.2 × FontSize
                IconSpacing="6"
                IconLineWidthScale="1"

                // A sweep now, as when a purchase goes through
                label.Glint();
            </Example.Code>
        </Example>

    </SampleLayout>

</SpinePage>
