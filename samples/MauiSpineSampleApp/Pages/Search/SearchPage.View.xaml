<SpinePage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiSpineSampleApp.Pages.Search.SearchPage"
    x:TypeArguments="SearchPageViewModel"
    x:DataType="SearchPageViewModel" BackgroundColor="{AppThemeBinding Light={x:Static SpineSection.PageBackgroundLight}, Dark={x:Static SpineSection.PageBackgroundDark}}">

    <CollectionView ItemsSource="{Binding Towns}">
        <CollectionView.Header>
            <VerticalStackLayout Padding="{x:Static HeaderBarConstants.PagePadding}" Spacing="12">
                <SpineSection Footer="[PageSearch] on a string property puts a search field with the header bar; the property follows the field both ways, and the page filters its own list in OnQueryChanged. Automatic is a row below the bar, and the trailing end of the bar on iPad and Mac. While a search goes on in the row, the header bar gives way to the field until the X (back on Android) ends it. With the field hidden, starting a search from code shows it until the search ends, as behind a search button.">
                    <SpineRow Title="Show the search field">
                        <SpineRow.Accessory>
                            <Switch IsToggled="{Binding ShowsSearch}" />
                        </SpineRow.Accessory>
                    </SpineRow>
                    <SpineRow Title="Always in a row (Top)" Detail="iPad, Mac: a row instead of the header bar">
                        <SpineRow.Accessory>
                            <Switch IsToggled="{Binding AlwaysInRow}" />
                        </SpineRow.Accessory>
                    </SpineRow>
                    <SpineRow Title="Start a search" Detail="Search.IsActive = true; shows a hidden field until it ends" Command="{Binding StartSearchCommand}" />
                    <SpineRow Title="End the search" Detail="Search.IsActive = false" Command="{Binding EndSearchCommand}" />
                    <SpineRow Title="Clear from code" Detail="Query = &quot;&quot;" Command="{Binding ClearCommand}" />
                    <SpineRow Title="Submitted" Value="{Binding Submitted}" />
                    <SpineRow Title="Open as a sheet" Command="{Binding OpenSheetCommand}" />
                </SpineSection>
                <Label Text="{Binding CountText}" FontSize="13" Opacity="0.6" Margin="0,4,0,0" />
            </VerticalStackLayout>
        </CollectionView.Header>
        <CollectionView.EmptyView>
            <Label Text="No town matches." FontSize="15" Opacity="0.6" HorizontalTextAlignment="Center" Margin="0,24" />
        </CollectionView.EmptyView>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="Town">
                <VerticalStackLayout Padding="{x:Static HeaderBarConstants.PagePadding}" Margin="0,8" Spacing="2">
                    <Label Text="{Binding Name}" FontSize="17" />
                    <Label Text="{Binding County}" FontSize="13" Opacity="0.6" />
                </VerticalStackLayout>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</SpinePage>
