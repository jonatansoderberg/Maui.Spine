<SpinePage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MauiBottomSheetPoc"
    x:Class="MauiSpineSampleApp.Pages.MainPage"
    x:TypeArguments="MainPageViewModel"
    x:DataType="MainPageViewModel"
    x:Name="Page">
 
    <Grid>

        <HeroCollectionView
            EnableAdaptiveOverlay="True"
            AdaptiveCaptionButtons="True"
            EnableHeaderAsDragRegionOnWindows="True"
            CanReorderItems="True"
            ItemsSource="{Binding Items}"
            HeaderImageSource="spine_hero2.png"
            HeaderTitle="SPINE SHOWCASE"
            HeaderTitleFontFamily="BrandonGrotesqueBlack"
            HeaderTitleFontSize="25"
            HeaderMaxHeight="{Binding HeaderMaxHeight}"
            HeaderMinHeight="{Binding HeaderMinHeight}">

            <HeroCollectionView.HeaderOverlayContent>
                <!-- Fades in as the hero collapses: a blur of the photo behind the compact header. -->
                <Border Material.Kind="Blur" StrokeThickness="0" Opacity="0" />
            </HeroCollectionView.HeaderOverlayContent>

            <HeroCollectionView.HeaderTopContent>
                <AbsoluteLayout InputTransparent="True" CascadeInputTransparent="False">

                    <ImageButton
                        Padding="2"
                        CornerRadius="0"
                        Margin="{Binding GearMargin}"
                        WidthRequest="{OnPlatform Default=44, WinUI=48}"
                        HeightRequest="{OnPlatform Default=44, WinUI=32}"
                        Style="{StaticResource SvgImageButtonStyle}"
                        SvgImageSource.Svg="Settings.svg"
                        SvgImageSource.Padding="{OnPlatform Default=10, WinUI=5}"
                        Glass.Style="Transient"
                        Command="{Binding OpenSettingsCommand}"
                        AbsoluteLayout.LayoutBounds="1, 0, AutoSize, AutoSize"
                        AbsoluteLayout.LayoutFlags="PositionProportional" />

                </AbsoluteLayout>
            </HeroCollectionView.HeaderTopContent>

            <HeroCollectionView.HeaderBottomContent>
                <AbsoluteLayout InputTransparent="True" CascadeInputTransparent="False">

                    <!-- Lifted so its capitals centre on the gear's line once the header has collapsed. -->
                    <Label
                        InputTransparent="True"
                        Text="SPINE SHOWCASE"
                        FontFamily="BrandonGrotesqueBlack"
                        FontSize="25"
                        TextTransform="Uppercase"
                        TextColor="White"
                        Margin="10,-4"
                        TranslationY="-3.5"
                        AbsoluteLayout.LayoutBounds="0, 1, AutoSize, AutoSize"
                        AbsoluteLayout.LayoutFlags="PositionProportional">
                        <Label.Shadow>
                            <Shadow Offset="0,0" Radius="2" Opacity="0.8">
                                <Shadow.Brush>
                                    <SolidColorBrush Color="Black" />
                                </Shadow.Brush>
                            </Shadow>
                        </Label.Shadow>
                    </Label>

                </AbsoluteLayout>
            </HeroCollectionView.HeaderBottomContent>
            
            <HeroCollectionView.ItemTemplate>
                <DataTemplate x:DataType="Item">
                    <local:ContextItem
                        Icon="{Binding Icon}"
                        Title="{Binding Title}"
                        Description="{Binding Description}"
                        Packages="{Binding Packages}"
                        Tap.Command="{PageCommand ItemTapped}"
                        Tap.CommandParameter="{Binding .}" />
                </DataTemplate>
            </HeroCollectionView.ItemTemplate>

        </HeroCollectionView>

    </Grid>
    
</SpinePage>