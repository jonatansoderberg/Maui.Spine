<SpinePage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiSpineSampleApp.Pages.Rows.RowsPage"
    x:TypeArguments="RowsPageViewModel"
    x:DataType="RowsPageViewModel"
    BackgroundColor="{AppThemeBinding Light={x:Static SpineSection.PageBackgroundLight}, Dark={x:Static SpineSection.PageBackgroundDark}}">

    <SampleLayout Packages="Plugin.Maui.Spine.Controls.Rows, Plugin.Maui.Spine">

        <Example Title="A settings screen, row by row"
                 Summary="Rows in a SpineSection look like the platform's own settings: an inset group with hairline separators on iOS, plain rows under a coloured header on Android. Each row has an icon, title, detail, value or switch, and the platform's press feedback."
                 OptionsCommand="{Binding ShowRowOptionsCommand}">
            <VerticalStackLayout Spacing="10">
                <SpineSection Header="Connections" Footer="Tap a row or its switch. A screen reader reads each row as one element.">
                    <SpineRow Icon="wireless.svg" IconBackground="{Binding BlueBadge}" Title="Wi-Fi"
                              Value="{Binding WiFiState}" ValuePlacement="{Binding Placement}">
                        <SpineRow.Accessory>
                            <Switch IsToggled="{Binding WiFi}" />
                        </SpineRow.Accessory>
                    </SpineRow>
                    <SpineRow Icon="bell.svg" IconBackground="{Binding RedBadge}" Title="Notifications">
                        <SpineRow.Accessory>
                            <Switch IsToggled="{Binding Notifications}" />
                        </SpineRow.Accessory>
                    </SpineRow>
                    <SpineRow Icon="lamp.svg" IconBackground="{Binding IndigoBadge}" Title="Appearance"
                              Value="{Binding Theme}" ValuePlacement="{Binding Placement}"
                              Command="{Binding CycleThemeCommand}" />
                </SpineSection>
                <SpineSection Header="Account">
                    <SpineRow Icon="user.svg" IconBackground="{Binding GrayBadge}" Title="Account" Detail="Signed in"
                              Command="{Binding OpenCommand}" CommandParameter="Account" />
                    <SpineRow Icon="lock.svg" IconBackground="{Binding BlueBadge}" Title="Privacy" DetailMarquee="True"
                              Detail="Location, camera, microphone, contacts, photos and every other permission the app asked for"
                              Command="{Binding OpenCommand}" CommandParameter="Privacy" />
                    <SpineRow Icon="printer.svg" IconBackground="{Binding GrayBadge}" Title="Printer" Detail="Disabled: no press, no command" IsEnabled="False"
                              Command="{Binding OpenCommand}" CommandParameter="Printer" />
                </SpineSection>
                <Label Text="{Binding LastTap}" FontSize="15" Margin="16,0" />
            </VerticalStackLayout>
            <Example.Code>
                &lt;SpineSection Header="Connections"
                              Footer="Wi-Fi turns on again tomorrow."&gt;
                    &lt;SpineRow Icon="wireless.svg" IconBackground="#007AFF"
                              Title="Wi-Fi" Value="{Binding Network}"&gt;
                        &lt;SpineRow.Accessory&gt;
                            &lt;Switch IsToggled="{Binding WiFi}" /&gt;
                        &lt;/SpineRow.Accessory&gt;
                    &lt;/SpineRow&gt;
                    &lt;SpineRow Icon="lamp.svg" IconBackground="#5856D6"
                              Title="Appearance" Value="{Binding Theme}"
                              Command="{Binding PickThemeCommand}" /&gt;
                &lt;/SpineSection&gt;

                &lt;!-- iOS: the groups sit on the grouped background --&gt;
                &lt;SpinePage BackgroundColor="{AppThemeBinding
                    Light={x:Static SpineSection.PageBackgroundLight},
                    Dark={x:Static SpineSection.PageBackgroundDark}}"&gt;
            </Example.Code>
        </Example>

        <Example Title="Pick one"
                 Summary="A list of choices: the selected row shows a check mark, a tap moves it. For a sort order, a language, a quality setting.">
            <SpineSection Header="Sort by">
                <SpineRow Title="Name" IsSelected="{Binding SortByName}" Command="{Binding SortCommand}" CommandParameter="Name" />
                <SpineRow Title="Date" IsSelected="{Binding SortByDate}" Command="{Binding SortCommand}" CommandParameter="Date" />
                <SpineRow Title="Size" IsSelected="{Binding SortBySize}" Command="{Binding SortCommand}" CommandParameter="Size" />
            </SpineSection>
            <Example.Code>
                &lt;SpineSection Header="Sort by"&gt;
                    &lt;SpineRow Title="Name" IsSelected="{Binding ByName}"
                              Command="{Binding SortCommand}"
                              CommandParameter="Name" /&gt;
                    &lt;SpineRow Title="Date" IsSelected="{Binding ByDate}"
                              Command="{Binding SortCommand}"
                              CommandParameter="Date" /&gt;
                &lt;/SpineSection&gt;
            </Example.Code>
        </Example>

        <Example Title="Key and value"
                 Summary="A title and a value with nothing to tap: an About screen, order details, a device's status.">
            <SpineSection>
                <SpineRow Title="Version" Value="1.0 (1)" ValuePlacement="Trailing" />
                <SpineRow Title="Platform" Value="{OnPlatform iOS=iOS, Android=Android, MacCatalyst=Mac Catalyst, WinUI=Windows}" ValuePlacement="Trailing" />
                <SpineRow Title="Wi-Fi" Value="{Binding WiFiState}" ValuePlacement="Trailing" />
            </SpineSection>
            <Example.Code>
                &lt;SpineSection&gt;
                    &lt;SpineRow Title="Version" Value="1.0 (1)"
                              ValuePlacement="Trailing" /&gt;
                    &lt;SpineRow Title="Wi-Fi" Value="{Binding WiFiState}"
                              ValuePlacement="Trailing" /&gt;
                &lt;/SpineSection&gt;
            </Example.Code>
        </Example>

        <Example Title="Text fields"
                 Summary="SpineEntryRow is a text field as a row: no frame of its own, the rows' insets, height and separators. IsPassword hides what is typed and adds an eye button that shows it.">
            <VerticalStackLayout Spacing="10">
                <SpineSection Header="Account" Footer="Return on the email moves to the password; return on the password signs in.">
                    <SpineEntryRow Text="{Binding Email}" Placeholder="Email" Keyboard="Email"
                                   IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                                   ReturnType="Next" Completed="OnEmailCompleted" />
                    <SpineEntryRow x:Name="PasswordRow" Text="{Binding Password}" Placeholder="Password" IsPassword="True"
                                   ReturnType="Go" ReturnCommand="{Binding SignInCommand}" />
                </SpineSection>
                <Label Text="{Binding SignInState}" FontSize="15" Margin="16,0" />
            </VerticalStackLayout>
            <Example.Code>
                &lt;SpineSection Header="Account"&gt;
                    &lt;SpineEntryRow Text="{Binding Email}" Placeholder="Email"
                                   Keyboard="Email" ReturnType="Next"
                                   IsSpellCheckEnabled="False"
                                   IsTextPredictionEnabled="False" /&gt;
                    &lt;SpineEntryRow Text="{Binding Password}" Placeholder="Password"
                                   IsPassword="True" ReturnType="Go"
                                   ReturnCommand="{Binding SignInCommand}" /&gt;
                &lt;/SpineSection&gt;

                // Return on one field moves to the next
                passwordRow.FocusField();
            </Example.Code>
        </Example>

        <Example Title="Make any view a button"
                 Summary="A whole card as the tap target, with the same press feedback as a row. Semantic.Merge makes it one element to a screen reader.">
            <SpineSection>
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" Padding="16,14"
                      Tap.Command="{Binding TapCardCommand}" Semantic.Merge="True">
                    <Label Text="A card is a button too" FontSize="17" FontAttributes="Bold" />
                    <Label Grid.Row="1" Text="Tap anywhere on the card."
                           FontSize="13" TextColor="Gray" />
                    <Label Grid.Column="1" Grid.RowSpan="2" Text="{Binding CardTaps}" FontSize="28"
                           VerticalOptions="Center" />
                </Grid>
            </SpineSection>
            <Example.Code>
                &lt;Border Tap.Command="{Binding OpenCommand}"
                        Tap.CommandParameter="{Binding .}"
                        Semantic.Merge="True"&gt;
                    …
                &lt;/Border&gt;
            </Example.Code>
        </Example>

        <Example Title="Read a layout as one element"
                 Summary="A screen reader stops on every label in a row of your own. Semantic.Merge reads the layout as one element: “Battery, 82 %”.">
            <SpineSection>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="16,12" Semantic.Merge="True">
                    <Image SvgImageSource.Svg="energy.svg" WidthRequest="24" HeightRequest="24" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="Battery" VerticalOptions="Center" />
                    <Label Grid.Column="2" Text="82 %" VerticalOptions="Center" TextColor="Gray" />
                </Grid>
            </SpineSection>
            <Example.Code>
                &lt;Grid ColumnDefinitions="*,Auto"
                      Semantic.Merge="True"&gt;
                    &lt;Label Text="Battery" /&gt;
                    &lt;Label Grid.Column="1" Text="82 %" /&gt;
                &lt;/Grid&gt;
            </Example.Code>
        </Example>

    </SampleLayout>

</SpinePage>
