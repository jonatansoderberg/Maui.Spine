<SpinePage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiSpineSampleApp.Pages.Chat.ChatPage"
    x:TypeArguments="ChatPageViewModel"
    x:DataType="ChatPageViewModel">

    <Grid RowDefinitions="Auto,*">
        <Label Text="{Binding Using}" FontSize="13" Opacity="0.7" Margin="{x:Static HeaderBarConstants.PagePadding}" Padding="0,8" />

        <ChatView x:Name="chat" Grid.Row="1" Client="{Binding Client}" Messages="{Binding Messages}"
                  ChatOptions="{Binding Options}" ShowToolCalls="{Binding ShowToolCalls}" />
    </Grid>

    <SpinePage.Footer>
        <ChatComposer Chat="{x:Reference chat}" Suggestions="{Binding Suggestions}" Placeholder="Ask about the race" />
    </SpinePage.Footer>

</SpinePage>
