<SpinePage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiSpineSampleApp.Pages.PageBinding.PageBindingPage"
    x:TypeArguments="PageBindingPageViewModel"
    x:DataType="PageBindingPageViewModel">

    <Grid RowDefinitions="Auto,*">

        <VerticalStackLayout Padding="16,8" Spacing="6">
            <Label Text="Inside an item template the BindingContext is the row, so {Binding PickCommand} would look on the Fruit and find nothing. {PageCommand Pick} and {PageBinding Currency} reach the page's view model instead, without a RelativeSource AncestorType binding."
                   FontSize="14" />

            <HorizontalStackLayout Spacing="10">
                <Label Text="Show prices in EUR (page state, shown in every row)" VerticalOptions="Center" FontSize="14" />
                <Switch IsToggled="{Binding UseEuro}" />
            </HorizontalStackLayout>

            <Label Text="{Binding Picked}" FontAttributes="Bold" />

            <Border StrokeThickness="0" BackgroundColor="#22808080" Padding="10,8" StrokeShape="RoundRectangle 8">
                <Label FontSize="11" FontFamily="{OnPlatform iOS=Menlo, MacCatalyst=Menlo, Android=monospace, WinUI=Consolas}"
                       Text="&lt;DataTemplate x:DataType=&quot;Fruit&quot;&gt;&#10;  &lt;Label Text=&quot;{Binding Name}&quot; /&gt;              row&#10;  &lt;Label Text=&quot;{Binding PricePerKg}&quot; /&gt;        row&#10;  &lt;Label Text=&quot;{PageBinding Currency}&quot; /&gt;     page&#10;  &lt;Button Command=&quot;{PageCommand Pick}&quot;          page&#10;          CommandParameter=&quot;{Binding .}&quot; /&gt;  row&#10;&lt;/DataTemplate&gt;" />
            </Border>
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Fruits}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="Fruit">
                    <Border StrokeThickness="0" Margin="16,6" Padding="12" BackgroundColor="#22808080" StrokeShape="RoundRectangle 10">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout>
                                <Label Text="{Binding Name}" FontAttributes="Bold" />
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="{Binding PricePerKg, StringFormat='{0:0}'}" FontSize="13" TextColor="Gray" />
                                    <Label Text="{PageBinding Currency}" FontSize="13" TextColor="Gray" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Pick" Command="{PageCommand Pick}" CommandParameter="{Binding .}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</SpinePage>
