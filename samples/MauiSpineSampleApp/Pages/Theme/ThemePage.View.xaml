<SpinePage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiSpineSampleApp.Pages.Theme.ThemePage"
    x:TypeArguments="ThemePageViewModel"
    x:DataType="ThemePageViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="20,16" Spacing="10">
            <PackageChips Packages="Plugin.Maui.Spine" />

            <Label Text="IThemeService.Current is the user's choice. Spine stores it and applies it at the next launch before the first page; the Android window background follows too."
                   FontSize="14" />

            <HorizontalStackLayout Spacing="8"
                                   RadioButtonGroup.GroupName="ThemeChoice"
                                   RadioButtonGroup.SelectedValue="{Binding SelectedThemeName}">
                <RadioButton Content="System" Value="System" />
                <RadioButton Content="Light" Value="Light" />
                <RadioButton Content="Dark" Value="Dark" />
            </HorizontalStackLayout>

            <Label Text="{Binding Effective}" FontSize="14" />

            <Label Text="Token dictionaries" FontAttributes="Bold" Margin="0,12,0,0" />
            <Label Text="options.Theme.UseTokens&lt;LightTokens, DarkTokens&gt;() merges one dictionary and copies the right set into it on every change. {DynamicResource} re-resolves; {StaticResource} would not."
                   FontSize="14" />
            <Border StrokeThickness="1" Stroke="{DynamicResource CardOutline}" BackgroundColor="{DynamicResource CardBackground}"
                    Padding="14,12" StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="4">
                    <Label Text="A card on CardBackground" TextColor="{DynamicResource CardText}" FontAttributes="Bold" />
                    <Label Text="Text on CardText, outline on CardOutline, accent below on CardAccent." TextColor="{DynamicResource CardText}" FontSize="13" />
                    <BoxView Color="{DynamicResource CardAccent}" HeightRequest="6" CornerRadius="3" Margin="0,6,0,0" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Repaint hook" FontAttributes="Bold" Margin="0,12,0,0" />
            <Label Text="A control that colours itself in code calls SpineTheme.Track(this, Paint). It repaints on every change while attached, and once on re-attach if it missed one."
                   FontSize="14" />
            <TokenSwatch />

            <Border StrokeThickness="0" BackgroundColor="#22808080" Padding="10,8" StrokeShape="RoundRectangle 8" Margin="0,8,0,0">
                <Label FontSize="11" FontFamily="{OnPlatform iOS=Menlo, MacCatalyst=Menlo, Android=monospace, WinUI=Consolas}"
                       Text=".UseSpine(options =&gt;&#10;    options.Theme.UseTokens&lt;LightTokens, DarkTokens&gt;())&#10;&#10;_theme.Current = AppTheme.Dark;          // stored, applied at once&#10;&#10;public MySkiaControl()&#10;{&#10;    SpineTheme.Track(this, InvalidateSurface);&#10;}&#10;&#10;options.Tabs.Style = new SpineTabBarStyle&#10;{&#10;    SelectedColorKey = &quot;CardAccent&quot;,     // re-read on every change&#10;};" />
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</SpinePage>
