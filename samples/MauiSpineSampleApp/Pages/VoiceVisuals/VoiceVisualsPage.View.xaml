<SpinePage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiSpineSampleApp.Pages.VoiceVisuals.VoiceVisualsPage"
    x:TypeArguments="VoiceVisualsPageViewModel"
    x:DataType="VoiceVisualsPageViewModel">

    <SampleLayout Packages="Plugin.Maui.Spine.Controls.Voice">

        <Example Title="The built-in visuals"
                 Summary="One engine plays 14 seconds of Swedish speech over and over, and four views draw its frame: the answer warm, the microphone in the app's accent. Talk over it to see both at once. With Reduce Motion on they draw four times a second and show the state and a slow level instead of the spectrum.">
            <VerticalStackLayout Spacing="12">
                <Grid ColumnDefinitions="*,*" RowDefinitions="170,Auto,170,Auto" ColumnSpacing="12" RowSpacing="4">
                    <VoiceView Audio="{Binding Audio}" Kind="orb" />
                    <Label Grid.Row="1" Text="orb" HorizontalOptions="Center" Opacity="0.7" />
                    <VoiceView Grid.Column="1" Audio="{Binding Audio}" Kind="bars" />
                    <Label Grid.Row="1" Grid.Column="1" Text="bars" HorizontalOptions="Center" Opacity="0.7" />
                    <VoiceView Grid.Row="2" Audio="{Binding Audio}" Kind="ring" />
                    <Label Grid.Row="3" Text="ring" HorizontalOptions="Center" Opacity="0.7" />
                    <VoiceView Grid.Row="2" Grid.Column="1" Audio="{Binding Audio}" Kind="avatar" />
                    <Label Grid.Row="3" Grid.Column="1" Text="avatar" HorizontalOptions="Center" Opacity="0.7" />
                </Grid>
                <Label Text="{Binding Status}" FontSize="15" Opacity="0.8" />
                <HorizontalStackLayout Spacing="10">
                    <Button Text="Start" Command="{Binding StartCommand}" />
                    <Button Text="Stop" Command="{Binding StopCommand}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
            <Example.Code>
                &lt;VoiceView Session="{Binding Voice}" Kind="orb" HeightRequest="240" /&gt;
                &lt;VoiceView Session="{Binding Voice}" Kind="bars"
                           InputColor="SteelBlue" OutputColor="Coral" /&gt;

                // A visual of your own, drawn with SkiaSharp:
                builder.UseSpineVoiceView(o =&gt; o.AddVisual&lt;PulseVisual&gt;("pulse"));

                public sealed class PulseVisual : VoiceVisual
                {
                    public override void Draw(SKCanvas canvas, SKRect bounds,
                        VoiceFrame frame, VoiceVisualContext context) { … }
                }

                // A mouth that follows the words:
                builder.UseSpineVoice(o =&gt; o.VisemeSource = new MyVisemes());
            </Example.Code>
        </Example>

    </SampleLayout>
</SpinePage>
