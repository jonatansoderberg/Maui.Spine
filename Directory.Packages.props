<Project>

	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
		<!-- WinUIEx and Microsoft.WindowsAppSDK float on purpose; keep them floating (NU1011). -->
		<CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
		<!--
			The Azure Functions SDK generates obj/**/WorkerExtensions/WorkerExtensions.csproj with
			versions written into its PackageReference items. That is NU1008 under central package
			management, and the file is regenerated on every build, so central management is off
			for that one project.
		-->
		<ManagePackageVersionsCentrally Condition="'$(MSBuildProjectName)' == 'WorkerExtensions'">false</ManagePackageVersionsCentrally>
	</PropertyGroup>

	<ItemGroup>
		<PackageVersion Include="AsyncAwaitBestPractices" Version="10.0.0" />
		<PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageVersion Include="Microsoft.Maui.Controls" Version="10.0.50" />
		<PackageVersion Include="SkiaSharp" Version="3.119.2" />
		<PackageVersion Include="SkiaSharp.Views.Maui.Controls" Version="3.119.2" />
		<PackageVersion Include="Svg.Skia" Version="3.6.0" />
	</ItemGroup>

	<!-- Plugin.Maui.Spine.Server -->
	<ItemGroup>
		<PackageVersion Include="Azure.Data.Tables" Version="12.12.0" />
		<PackageVersion Include="FirebaseAdmin" Version="3.6.0" />
	</ItemGroup>

	<!-- Plugin.Maui.Spine.Push, Android only -->
	<ItemGroup>
		<PackageVersion Include="Xamarin.Firebase.Messaging" Version="125.1.1.1" />
		<!--
			Firebase Messaging pulls AndroidX.Fragment 1.9.0, which needs LiveData.Core 2.11.0.1, while
			MAUI 10.0.50 pins it below 2.9.3. Referencing the newer one directly is what NuGet asks for;
			it leaves NU1608 warnings about the violated upper bound, which is the normal state of a MAUI
			app with Firebase in it.
		-->
		<PackageVersion Include="Xamarin.AndroidX.Lifecycle.LiveData.Core" Version="2.11.0.1" />
		<!--
			Fragment.Ktx 1.8.x and Fragment 1.9.0 both carry androidx.fragment.app.FragmentKt, and D8 stops
			on the duplicate. Pinning the Ktx facade to 1.9.0 too lines them up.
		-->
		<PackageVersion Include="Xamarin.AndroidX.Fragment" Version="1.9.0" />
		<PackageVersion Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />
	</ItemGroup>

	<!-- Windows only; referenced under a condition in Plugin.Maui.Spine. -->
	<ItemGroup>
		<PackageVersion Include="Microsoft.WindowsAppSDK" Version="1.8.*" />
		<PackageVersion Include="WinUIEx" Version="2.9.*" />
	</ItemGroup>

	<!-- Sample apps -->
	<ItemGroup>
		<PackageVersion Include="Mapsui.Maui" Version="5.1.0" />
		<PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.10" />
		<PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.5" />
		<PackageVersion Include="Sharpnado.MaterialFrame.Maui" Version="3.0.2" />
	</ItemGroup>

	<!-- Orientera.Backend -->
	<ItemGroup>
		<PackageVersion Include="Anthropic" Version="12.40.0" />
		<PackageVersion Include="Azure.Storage.Blobs" Version="12.29.1" />
		<PackageVersion Include="Azure.Storage.Queues" Version="12.27.1" />
		<PackageVersion Include="BitMiracle.LibTiff.NET" Version="2.4.660" />
		<PackageVersion Include="Microsoft.Azure.Functions.Worker" Version="2.52.0" />
		<PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" Version="2.1.1" />
		<PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.Storage.Queues" Version="5.5.0" />
		<PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.Timer" Version="4.3.1" />
		<PackageVersion Include="Microsoft.Azure.Functions.Worker.Sdk" Version="2.1.0" />
		<PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.10" />
		<PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.10" />
		<PackageVersion Include="OpenAI" Version="2.13.0" />
		<PackageVersion Include="ProjNET" Version="2.1.0" />
		<PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.151.1" />
	</ItemGroup>

	<!-- Orientera.AppHost — the Aspire orchestration for local development -->
	<ItemGroup>
		<PackageVersion Include="Aspire.Hosting.Azure.Storage" Version="13.4.6" />
		<PackageVersion Include="Aspire.Hosting.Azure.Functions" Version="13.4.6" />
	</ItemGroup>

	<!-- Orientera.Tests -->
	<ItemGroup>
		<PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.10.0" />
		<PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
		<PackageVersion Include="xunit" Version="2.9.3" />
		<PackageVersion Include="xunit.runner.visualstudio" Version="3.1.1" />
	</ItemGroup>

</Project>
