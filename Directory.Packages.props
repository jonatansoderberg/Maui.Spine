<Project>

	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>

	<ItemGroup>
		<PackageVersion Include="AsyncAwaitBestPractices" Version="10.0.0" />
		<PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageVersion Include="Microsoft.Maui.Controls" Version="10.0.50" />
		<PackageVersion Include="SkiaSharp" Version="3.119.2" />
		<PackageVersion Include="SkiaSharp.Views.Maui.Controls" Version="3.119.2" />
		<PackageVersion Include="Svg.Skia" Version="3.6.0" />
	</ItemGroup>

	<!-- Plugin.Maui.Spine.Images: its net10.0 core logs without MAUI, which brings the same version on the MAUI TFMs. -->
	<ItemGroup>
		<PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
	</ItemGroup>

	<!-- Plugin.Maui.Spine.Barcodes -->
	<ItemGroup>
		<PackageVersion Include="ZXing.Net" Version="0.16.11" />
	</ItemGroup>

	<!-- Plugin.Maui.Spine.Scanner, Android only -->
	<ItemGroup>
		<PackageVersion Include="Xamarin.AndroidX.Camera.Camera2" Version="1.6.2" />
		<PackageVersion Include="Xamarin.AndroidX.Camera.Lifecycle" Version="1.6.2" />
		<PackageVersion Include="Xamarin.AndroidX.Camera.View" Version="1.6.2" />
		<PackageVersion Include="Xamarin.Google.MLKit.BarcodeScanning" Version="117.3.0.9" />
		<PackageVersion Include="Xamarin.AndroidX.Collection.Ktx" Version="1.6.0.1" />
	</ItemGroup>

	<!-- Plugin.Maui.Spine.Server -->
	<ItemGroup>
		<PackageVersion Include="Azure.Data.Tables" Version="12.12.0" />
		<PackageVersion Include="FirebaseAdmin" Version="3.6.0" />
	</ItemGroup>

	<!-- Plugin.Maui.Spine.Server.AI. IImageGenerator is experimental (MEAI001), suppressed inside the package. -->
	<ItemGroup>
		<PackageVersion Include="Microsoft.Extensions.AI" Version="10.10.0" />
	</ItemGroup>

	<!-- Plugin.Maui.Spine.Push, Android only -->
	<ItemGroup>
		<PackageVersion Include="Xamarin.Firebase.Messaging" Version="125.1.1.1" />
		<!--
			Firebase Messaging pulls AndroidX.Fragment 1.9.0, which needs LiveData.Core and Runtime
			2.11.0.1, while MAUI 10.0.50 brings LiveData and Process 2.9.2.1, which pin both below 2.9.3
			(NU1608). Lifting all four to the same release lines them up again.
		-->
		<PackageVersion Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.11.0.1" />
		<PackageVersion Include="Xamarin.AndroidX.Lifecycle.LiveData.Core" Version="2.11.0.1" />
		<PackageVersion Include="Xamarin.AndroidX.Lifecycle.Process" Version="2.11.0.1" />
		<!--
			Fragment.Ktx 1.8.x and Fragment 1.9.0 both carry androidx.fragment.app.FragmentKt, and D8 stops
			on the duplicate. Pinning the Ktx facade to 1.9.0 too lines them up.
		-->
		<PackageVersion Include="Xamarin.AndroidX.Fragment" Version="1.9.0" />
		<PackageVersion Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />
	</ItemGroup>

	<!--
		Plugin.Maui.Spine.Biometrics, Android only. 1.1.0.30 is the last build on the AndroidX releases MAUI
		10.0.50 ships (Activity 1.10.1, Fragment 1.8.8, Lifecycle 2.9.2); later builds lift them and the Ktx
		facades MAUI pins fall out of range (NU1608).
	-->
	<ItemGroup>
		<PackageVersion Include="Xamarin.AndroidX.Biometric" Version="1.1.0.30" />
	</ItemGroup>

	<!-- Windows only; referenced under a condition in Plugin.Maui.Spine. -->
	<ItemGroup>
		<PackageVersion Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" />
		<PackageVersion Include="WinUIEx" Version="2.9.3" />
	</ItemGroup>

	<!-- Sample apps -->
	<ItemGroup>
		<PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.10" />
		<PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.5" />
		<!-- The push sample server's AI providers: one line each in Program.cs. -->
		<PackageVersion Include="Anthropic" Version="12.55.0" />
		<PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.1" />
	</ItemGroup>

	<!-- Tests -->
	<ItemGroup>
		<PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.8" />
		<PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.10.0" />
		<PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
		<PackageVersion Include="xunit" Version="2.9.3" />
		<PackageVersion Include="xunit.runner.visualstudio" Version="3.1.1" />
	</ItemGroup>

</Project>
